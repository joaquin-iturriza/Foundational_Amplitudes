\@writefile{toc}{\contentsline {paragraph}{Separating the soft and collinear axes.}{30}{section*.19}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces \textbf  {Pure collinear ramp, $e^+e^-\to u\bar  u g$.} $\log |\mathcal  {M}|^2$ vs the $\bar  q g$ collinear invariant $1-x_q=(p_{\bar  q}+p_g)^2/s$, in three bands of fixed hard gluon energy $x_g$ (soft pole switched off). Left: truth (faint bands) and model (dashed$+$markers) fall on the analytic slope $-\ln 10$ (green) and stay parallel across $x_g$ --- collinear factorization. Right: the model error into the collinear limit, small and $x_g$-independent. Complements the soft ($x_g$) ramp, which isolates the other axis.}}{31}{figure.14}\protected@file@percent }
\newlabel{fig:div_uug_coll}{{14}{31}{\textbf {Pure collinear ramp, $e^+e^-\to u\bar u g$.} $\log |\mathcal {M}|^2$ vs the $\bar q g$ collinear invariant $1-x_q=(p_{\bar q}+p_g)^2/s$, in three bands of fixed hard gluon energy $x_g$ (soft pole switched off). Left: truth (faint bands) and model (dashed$+$markers) fall on the analytic slope $-\ln 10$ (green) and stay parallel across $x_g$ --- collinear factorization. Right: the model error into the collinear limit, small and $x_g$-independent. Complements the soft ($x_g$) ramp, which isolates the other axis}{figure.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces \textbf  {$e^+e^-\to u\bar  u gg$, the hardest process.} $\log |\mathcal  {M}|^2$ vs the IR resolution variables of Eq.~\eqref  {eq:ir}. The mean ramps (bottom, with the analytic leading-power slopes $1/y_{\min }$ and $1/x_g^2$ overlaid) are tracked into the deep IR, but the model error (blue, and the error map top-right) grows toward small $y_{\min }$ --- the sole case of degradation \emph  {into} a singularity.}}{32}{figure.15}\protected@file@percent }
\newlabel{fig:div_uugg}{{15}{32}{\textbf {$e^+e^-\to u\bar u gg$, the hardest process.} $\log |\mathcal {M}|^2$ vs the IR resolution variables of Eq.~\eqref {eq:ir}. The mean ramps (bottom, with the analytic leading-power slopes $1/y_{\min }$ and $1/x_g^2$ overlaid) are tracked into the deep IR, but the model error (blue, and the error map top-right) grows toward small $y_{\min }$ --- the sole case of degradation \emph {into} a singularity}{figure.15}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {11.3}Extrapolation into a held-out divergence: a hold-out / add-back study on $e^+e^-\to u\bar  u g$}{33}{subsection.11.3}\protected@file@percent }
\newlabel{sec:divergences-holdout}{{11.3}{33}{Extrapolation into a held-out divergence: a hold-out / add-back study on $e^+e^-\to u\bar u g$}{subsection.11.3}{}}
\@writefile{toc}{\contentsline {paragraph}{Setup.}{33}{section*.20}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Result --- a small in-region data density recovers most of the divergence.}{33}{section*.21}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Held-out divergence-region ($y_{\min }<c$) error vs add-back fraction $f$, for $e^+e^-\to u\bar  u g$ ($N=75$k held-out events).}}{33}{table.10}\protected@file@percent }
\newlabel{tab:div_addback}{{10}{33}{Held-out divergence-region ($y_{\min }<c$) error vs add-back fraction $f$, for $e^+e^-\to u\bar u g$ ($N=75$k held-out events)}{table.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces \textbf  {Add-back curve, $e^+e^-\to u\bar  u g$.} Held-out divergence-region ($y_{\min }<c$) error vs the add-back fraction $f$ (leftmost tick $f\!=\!0$ is pure extrapolation). Left: MSE and MAE $\Delta \log |\mathcal  {M}|^2$ over the whole held-out region; right: MSE split by $y_{\min }$ sub-bin (deeper IR toward the top). The steep drop already by $f\!=\!0.05$ and the subsequent flattening show a small in-region data density recovers most of the divergence.}}{34}{figure.16}\protected@file@percent }
\newlabel{fig:div_addback}{{16}{34}{\textbf {Add-back curve, $e^+e^-\to u\bar u g$.} Held-out divergence-region ($y_{\min }<c$) error vs the add-back fraction $f$ (leftmost tick $f\!=\!0$ is pure extrapolation). Left: MSE and MAE $\Delta \log |\mathcal {M}|^2$ over the whole held-out region; right: MSE split by $y_{\min }$ sub-bin (deeper IR toward the top). The steep drop already by $f\!=\!0.05$ and the subsequent flattening show a small in-region data density recovers most of the divergence}{figure.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces \textbf  {Pure extrapolation ($f\!=\!0$), held-out region}, in the IR plane of Eq.~\eqref  {eq:ir}. The model mean (red) plateaus \emph  {off} the IR ramp (bottom-left), while truth (black) lies on the analytic $1/y_{\min }$ slope (green); predictions saturate against a ceiling (predicted-vs-true, bottom-right), and the error concentrates in the soft/collinear corner (top-right) --- the model, never having seen the region, cannot reproduce the divergence's growth.}}{35}{figure.17}\protected@file@percent }
\newlabel{fig:div_holdout_f0}{{17}{35}{\textbf {Pure extrapolation ($f\!=\!0$), held-out region}, in the IR plane of Eq.~\eqref {eq:ir}. The model mean (red) plateaus \emph {off} the IR ramp (bottom-left), while truth (black) lies on the analytic $1/y_{\min }$ slope (green); predictions saturate against a ceiling (predicted-vs-true, bottom-right), and the error concentrates in the soft/collinear corner (top-right) --- the model, never having seen the region, cannot reproduce the divergence's growth}{figure.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces \textbf  {In-support baseline ($f\!=\!1$), same held-out region.} With the divergent region back in the training support the IR ramp (analytic $1/y_{\min }$ slope, green) is tracked into the deep IR by both truth and model, the predicted-vs-true ceiling is gone, and the error is flat and small across the plane (note the $\sim \!25\times $ smaller error axis) --- contrast Fig.~\ref {fig:div_holdout_f0}.}}{36}{figure.18}\protected@file@percent }
\newlabel{fig:div_holdout_f1}{{18}{36}{\textbf {In-support baseline ($f\!=\!1$), same held-out region.} With the divergent region back in the training support the IR ramp (analytic $1/y_{\min }$ slope, green) is tracked into the deep IR by both truth and model, the predicted-vs-true ceiling is gone, and the error is flat and small across the plane (note the $\sim \!25\times $ smaller error axis) --- contrast Fig.~\ref {fig:div_holdout_f0}}{figure.18}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {11.4}Two extensions: the hardest process, and separating the two limits}{37}{subsection.11.4}\protected@file@percent }
\newlabel{sec:div-extensions}{{11.4}{37}{Two extensions: the hardest process, and separating the two limits}{subsection.11.4}{}}
\@writefile{toc}{\contentsline {paragraph}{The hardest process ($u\bar  u gg$) is also data-recoverable.}{37}{section*.22}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces \textbf  {$e^+e^-\to u\bar  u gg$ add-back curve} (hardest process, same base22). Left: held-out deep-IR ($y_{\min }<c$) MSE/MAE vs add-back fraction $f$; right: MSE split by $y_{\min }$ sub-bin. The divergence is data-recoverable ($0.22\to 0.024$) but recovery is more gradual and the floor $\sim \!10\times $ higher than $u\bar  u g$ --- the harder process needs more in-region data.}}{38}{figure.19}\protected@file@percent }
\newlabel{fig:div_addback_uugg}{{19}{38}{\textbf {$e^+e^-\to u\bar u gg$ add-back curve} (hardest process, same base22). Left: held-out deep-IR ($y_{\min }<c$) MSE/MAE vs add-back fraction $f$; right: MSE split by $y_{\min }$ sub-bin. The divergence is data-recoverable ($0.22\to 0.024$) but recovery is more gradual and the floor $\sim \!10\times $ higher than $u\bar u g$ --- the harder process needs more in-region data}{figure.19}{}}
\@writefile{toc}{\contentsline {paragraph}{Which limit is harder to extrapolate into: soft vs collinear.}{38}{section*.23}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces \textbf  {Soft vs collinear extrapolation, $e^+e^-\to u\bar  u g$.} Held-out-region MSE vs add-back fraction for the pure-soft ($x_g<c$) and pure-collinear ($y_{\min }<c$ at hard $x_g$) cuts. Collinear is easier to extrapolate into ($f{=}0$), but soft recovers faster and crosses below it once any in-region data is added back.}}{39}{figure.20}\protected@file@percent }
\newlabel{fig:div_soft_coll}{{20}{39}{\textbf {Soft vs collinear extrapolation, $e^+e^-\to u\bar u g$.} Held-out-region MSE vs add-back fraction for the pure-soft ($x_g<c$) and pure-collinear ($y_{\min }<c$ at hard $x_g$) cuts. Collinear is easier to extrapolate into ($f{=}0$), but soft recovers faster and crosses below it once any in-region data is added back}{figure.20}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {11.5}Deeper/cleverer sampling, optimal allocation, and heteroscedastic uncertainty}{39}{subsection.11.5}\protected@file@percent }
\newlabel{sec:div-sampling}{{11.5}{39}{Deeper/cleverer sampling, optimal allocation, and heteroscedastic uncertainty}{subsection.11.5}{}}
\@writefile{toc}{\contentsline {paragraph}{Thread A --- deeper + antenna phase-space sampling (done).}{40}{section*.24}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces \textbf  {Thread A: antenna sampling crushes the pole ($e^+e^-\to u\bar  u g$).} Deep-IR error for the production flat-\textsc  {rambo} set vs the antenna sampler, same base22 / $400$k events / $4000$ steps. Flat \textsc  {rambo} starves the deep IR by construction (median $y_{\min }\!\approx \!0.15$); the antenna proposal, which is flat per decade in the gluon invariants, takes the median relative error in $y_{\min }\!\in \![10^{-6},10^{-5})$ from $47.9\%$ to $1.4\%$ and the overall MSE from $0.108$ to $0.0017$ ($\sim \!62\times $). Because we fit $\ln |\mathcal  M|^2$ pointwise, this needs \emph  {no} importance reweighting --- only where the training points sit changes.}}{41}{figure.21}\protected@file@percent }
\newlabel{fig:deep_sampling_antenna}{{21}{41}{\textbf {Thread A: antenna sampling crushes the pole ($e^+e^-\to u\bar u g$).} Deep-IR error for the production flat-\textsc {rambo} set vs the antenna sampler, same base22 / $400$k events / $4000$ steps. Flat \textsc {rambo} starves the deep IR by construction (median $y_{\min }\!\approx \!0.15$); the antenna proposal, which is flat per decade in the gluon invariants, takes the median relative error in $y_{\min }\!\in \![10^{-6},10^{-5})$ from $47.9\%$ to $1.4\%$ and the overall MSE from $0.108$ to $0.0017$ ($\sim \!62\times $). Because we fit $\ln |\mathcal M|^2$ pointwise, this needs \emph {no} importance reweighting --- only where the training points sit changes}{figure.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces \textbf  {Thread A: the antenna/uniform mixture has a broad interior optimum.} Deep-IR error vs the antenna fraction $f$. Both endpoints are bad --- $f{=}0$ (pure \textsc  {rambo}) is catastrophic ($\sim \!200\times $) and $f{=}1$ (pure antenna) is $\sim \!2\times $ worse than the basin, because it starves the $O(1)$ bulk --- while any $f\in [0.25,0.75]$ sits in a flat basin. The fine location inside the basin is single-seed noise. This ``mix the coverage criterion in at a modest fraction, do not adopt it as the base'' shape recurs for the $Z$ resonance (Fig.~\ref {fig:eeuu_genmix_fraction_sweep}).}}{42}{figure.22}\protected@file@percent }
\newlabel{fig:deep_sampling_fraction_sweep}{{22}{42}{\textbf {Thread A: the antenna/uniform mixture has a broad interior optimum.} Deep-IR error vs the antenna fraction $f$. Both endpoints are bad --- $f{=}0$ (pure \textsc {rambo}) is catastrophic ($\sim \!200\times $) and $f{=}1$ (pure antenna) is $\sim \!2\times $ worse than the basin, because it starves the $O(1)$ bulk --- while any $f\in [0.25,0.75]$ sits in a flat basin. The fine location inside the basin is single-seed noise. This ``mix the coverage criterion in at a modest fraction, do not adopt it as the base'' shape recurs for the $Z$ resonance (Fig.~\ref {fig:eeuu_genmix_fraction_sweep})}{figure.22}{}}
\@writefile{toc}{\contentsline {paragraph}{Float32 label floor.}{42}{section*.25}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Thread B --- optimal allocation (analysis + un-integrated tool).}{43}{section*.26}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Thread C --- heteroscedastic $(\mu ,\sigma )$ head (in progress; main open item).}{43}{section*.27}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Resolved --- the coupled fit fails for a structural reason; two-stage $\sigma $ works.}{43}{section*.28}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Q1 --- the $\sigma $ step costs $\sim $1 min, not the recipe's 600 iters.}{44}{section*.29}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Q2 --- imperfect $\sigma $ is tolerable, but the metric must be equal-footing.}{44}{section*.30}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces \textbf  {Q2: the metric must weight each $y_{\min }$ decade equally.} $\sigma $-reweighting gain under the log-flat-per-decade metric. The antenna test set is $\sim \!50\%$ below $y_{\min }\!=\!10^{-3}$, so a plain event-weighted \texttt  {mean}$(d^2)$ is deep-IR-dominated and flatters any deep-IR-following heuristic. Under equal footing the real $\sigma $ head captures $\sim \!80\%$ of the perfect-oracle reweighting gain ($87\%$ event-weighted) and improves \emph  {every} decade, bulk included.}}{45}{figure.23}\protected@file@percent }
\newlabel{fig:q2_logflat}{{23}{45}{\textbf {Q2: the metric must weight each $y_{\min }$ decade equally.} $\sigma $-reweighting gain under the log-flat-per-decade metric. The antenna test set is $\sim \!50\%$ below $y_{\min }\!=\!10^{-3}$, so a plain event-weighted \code {mean}$(d^2)$ is deep-IR-dominated and flatters any deep-IR-following heuristic. Under equal footing the real $\sigma $ head captures $\sim \!80\%$ of the perfect-oracle reweighting gain ($87\%$ event-weighted) and improves \emph {every} decade, bulk included}{figure.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces \textbf  {Q2: magnitude dominates ranking (a controlled rank-vs-magnitude split).} The same weight multiset $\Phi =\mathrm  {sort}|r|$ reassigned by different orderings, so ordering and magnitude are varied independently. Ordering \emph  {alone} recovers only $11\%$ of the oracle gain: after antenna training the worst-fit decade is the \emph  {bulk} ($\mathrm  {MSE}\sim 10^{-2}$, vs deep-IR $8\times 10^{-4}$), and only $\sigma $'s calibrated \emph  {magnitude} points there. Deep-IR-following heuristics starve the bulk and can net-hurt --- a $\rho {=}0.29$ synthetic $\sigma $ scores $-9\%$. This is why a pure-rank framing of $\sigma $ quality is misleading.}}{46}{figure.24}\protected@file@percent }
\newlabel{fig:q2_rankmag}{{24}{46}{\textbf {Q2: magnitude dominates ranking (a controlled rank-vs-magnitude split).} The same weight multiset $\Phi =\mathrm {sort}|r|$ reassigned by different orderings, so ordering and magnitude are varied independently. Ordering \emph {alone} recovers only $11\%$ of the oracle gain: after antenna training the worst-fit decade is the \emph {bulk} ($\mathrm {MSE}\sim 10^{-2}$, vs deep-IR $8\times 10^{-4}$), and only $\sigma $'s calibrated \emph {magnitude} points there. Deep-IR-following heuristics starve the bulk and can net-hurt --- a $\rho {=}0.29$ synthetic $\sigma $ scores $-9\%$. This is why a pure-rank framing of $\sigma $ quality is misleading}{figure.24}{}}
\@writefile{toc}{\contentsline {paragraph}{Thread D --- coverage vs.\ emphasis, and the general default sampling.}{46}{section*.31}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{L0 validated on the $ee\to u\bar  u$ $Z$ resonance --- by GENERATION, not resampling.}{47}{section*.32}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {25}{\ignorespaces \textbf  {L0 on the $ee\to u\bar  u$ $Z$ resonance: generation, not resampling.} Held-out MSE binned in $\sqrt  s$ for three training densities scored on the same test set: raw \textsc  {rambo}, a flat-$\log |\mathcal  M|^2$ set obtained by \emph  {resampling} the fixed $10^6$ \textsc  {rambo} pool, and one obtained by \emph  {generating} fresh events. Raw \textsc  {rambo} is the best arm in the bulk and the worst at the pole --- it puts only $0.4\%$ of events in $\sqrt  s\!\in \![88,95]$, and the foundation fits the peak $\sim \!400\times $ worse than the bulk --- so both flat arms trade bulk accuracy for pole accuracy. Resampling cannot go far: the pool holds only $\sim \!3300$ genuine pole events, so flat resampling merely duplicates them ($155$k unique of $400$k). Generating lifts pole coverage $0.4\%\!\to \!32\%$ with genuinely new events, and is $2.6\times $ better than resampling on the log-flat metric; against raw it is $9.4\times $ better log-flat and $2.1\times $ at the $Z$ peak. This is the coverage ceiling of Thread~D made concrete: you cannot resample past what the pool contains. \emph  {(Rebuilt from the corrected re-eval \texttt  {eeuu\_reson\_clean\_summary.json}; the earlier version of this figure was drawn from the pre-fix evaluation, whose cross-tag state leak corrupted every tag after the first and gave $5.8\times /1.5\times $ here.)}}}{48}{figure.25}\protected@file@percent }
\newlabel{fig:eeuu_flatlogm_resonance}{{25}{48}{\textbf {L0 on the $ee\to u\bar u$ $Z$ resonance: generation, not resampling.} Held-out MSE binned in $\sqrt s$ for three training densities scored on the same test set: raw \textsc {rambo}, a flat-$\log |\mathcal M|^2$ set obtained by \emph {resampling} the fixed $10^6$ \textsc {rambo} pool, and one obtained by \emph {generating} fresh events. Raw \textsc {rambo} is the best arm in the bulk and the worst at the pole --- it puts only $0.4\%$ of events in $\sqrt s\!\in \![88,95]$, and the foundation fits the peak $\sim \!400\times $ worse than the bulk --- so both flat arms trade bulk accuracy for pole accuracy. Resampling cannot go far: the pool holds only $\sim \!3300$ genuine pole events, so flat resampling merely duplicates them ($155$k unique of $400$k). Generating lifts pole coverage $0.4\%\!\to \!32\%$ with genuinely new events, and is $2.6\times $ better than resampling on the log-flat metric; against raw it is $9.4\times $ better log-flat and $2.1\times $ at the $Z$ peak. This is the coverage ceiling of Thread~D made concrete: you cannot resample past what the pool contains. \emph {(Rebuilt from the corrected re-eval \code {eeuu\_reson\_clean\_summary.json}; the earlier version of this figure was drawn from the pre-fix evaluation, whose cross-tag state leak corrupted every tag after the first and gave $5.8\times /1.5\times $ here.)}}{figure.25}{}}
\@writefile{toc}{\contentsline {paragraph}{The generated fraction sweep --- a clean interior optimum; pure flat over-corrects.}{49}{section*.33}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {26}{\ignorespaces \textbf  {The generated fraction sweep on the $Z$ resonance --- a clean interior optimum.} $f$ is the fraction of freshly \emph  {generated} flat-$\log |\mathcal  M|^2$ events (rest uniform-$\sqrt  s$); same base8/HPs/$N{=}400$k throughout. \emph  {Left --- the interior optimum.} Three metrics vs $f$. The objective is the \emph  {log-flat} one, defined under the panel: the mean of the per-$\sqrt  s$-bin MSE, so every bin counts once however many events it holds; the plain event mean instead follows the bulk, which holds almost all the events, and so barely sees the pole. Log-flat gives $1.0\mathrm  {e}{-}3$, $3.5\mathrm  {e}{-}5$, $\mathbf  {1.5\mathrm  {e}{-}5}$, $7.9\mathrm  {e}{-}5$, $1.1\mathrm  {e}{-}4$ at $f=0,0.25,0.5,0.75,1$ --- a minimum at $f{=}0.5$, beating raw \textsc  {rambo} $\sim \!30$--$70\times $ and \emph  {pure} flat $\sim \!4$--$7\times $. The resonance-region curve ($\sqrt  s<100$) tracks it; the event-weighted ``overall'' curve, being bulk-heavy, bottoms earlier at $f{=}0.25$ --- which is exactly why the objective has to be the equal-per-bin one. \emph  {Right --- the mechanism, the bulk$\leftrightarrow $pole trade-off.} The same runs resolved per $\sqrt  s$ bin: $f{=}0$ is far the best in the bulk and far the worst at the pole, $f{=}1$ is the mirror image, and the interior mixtures are the flattest across both. So flat-$\log |\mathcal  M|^2$ is a criterion to \emph  {mix in}, not a good base --- pure flat starves the bulk exactly as \textsc  {rambo} starves the pole. Same shape as the $u\bar  u g$ antenna sweep (Fig.~\ref {fig:deep_sampling_fraction_sweep}).}}{50}{figure.26}\protected@file@percent }
\newlabel{fig:eeuu_genmix_fraction_sweep}{{26}{50}{\textbf {The generated fraction sweep on the $Z$ resonance --- a clean interior optimum.} $f$ is the fraction of freshly \emph {generated} flat-$\log |\mathcal M|^2$ events (rest uniform-$\sqrt s$); same base8/HPs/$N{=}400$k throughout. \emph {Left --- the interior optimum.} Three metrics vs $f$. The objective is the \emph {log-flat} one, defined under the panel: the mean of the per-$\sqrt s$-bin MSE, so every bin counts once however many events it holds; the plain event mean instead follows the bulk, which holds almost all the events, and so barely sees the pole. Log-flat gives $1.0\mathrm {e}{-}3$, $3.5\mathrm {e}{-}5$, $\mathbf {1.5\mathrm {e}{-}5}$, $7.9\mathrm {e}{-}5$, $1.1\mathrm {e}{-}4$ at $f=0,0.25,0.5,0.75,1$ --- a minimum at $f{=}0.5$, beating raw \textsc {rambo} $\sim \!30$--$70\times $ and \emph {pure} flat $\sim \!4$--$7\times $. The resonance-region curve ($\sqrt s<100$) tracks it; the event-weighted ``overall'' curve, being bulk-heavy, bottoms earlier at $f{=}0.25$ --- which is exactly why the objective has to be the equal-per-bin one. \emph {Right --- the mechanism, the bulk$\leftrightarrow $pole trade-off.} The same runs resolved per $\sqrt s$ bin: $f{=}0$ is far the best in the bulk and far the worst at the pole, $f{=}1$ is the mirror image, and the interior mixtures are the flattest across both. So flat-$\log |\mathcal M|^2$ is a criterion to \emph {mix in}, not a good base --- pure flat starves the bulk exactly as \textsc {rambo} starves the pole. Same shape as the $u\bar u g$ antenna sweep (Fig.~\ref {fig:deep_sampling_fraction_sweep})}{figure.26}{}}
\@writefile{toc}{\contentsline {paragraph}{Eval bug (invalidated an earlier read): in-process state leak across tags.}{51}{section*.34}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{L1 --- $\sigma $-reweighting the coverage base does NOT robustly help (3-seed).}{51}{section*.35}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{L1 CONFIRMED where coverage is capped: $\sigma \!\approx \!$oracle on a starved base (3-seed).}{51}{section*.36}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Takeaway.}{51}{section*.37}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{L2 validated on $ee\to u\bar  u gg$ --- $\sigma $-informed on-the-fly GENERATION beats uniform generation, coordinate-free.}{51}{section*.38}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The process-agnostic base generator: ``democratic'' phase space.}{52}{section*.39}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {27}{\ignorespaces \textbf  {L2 on $e^+e^-\to u\bar  u gg$: $\sigma $-driven generation vs uniform ($\gamma {=}1$, $3$ seeds).} Held-out deep-IR MSE per $y_{\min }$ decade. Both arms train the \emph  {identical} HETEROSC net with a detached $\sigma $ backbone at $\beta {=}1$ (so $\mu $ trains exactly as MSE in both) on matched totals with fresh data every round --- the \emph  {only} difference is the keep rule, uniform vs $\propto \sigma ^\gamma $. The $\sigma $ arm wins, and the gain is concentrated at small $y_{\min }$: the model's own uncertainty, with no physics coordinate and no reference density, builds a better training set than the best hand-coded sampler.}}{54}{figure.27}\protected@file@percent }
\newlabel{fig:l2_uugg_perdecade}{{27}{54}{\textbf {L2 on $e^+e^-\to u\bar u gg$: $\sigma $-driven generation vs uniform ($\gamma {=}1$, $3$ seeds).} Held-out deep-IR MSE per $y_{\min }$ decade. Both arms train the \emph {identical} HETEROSC net with a detached $\sigma $ backbone at $\beta {=}1$ (so $\mu $ trains exactly as MSE in both) on matched totals with fresh data every round --- the \emph {only} difference is the keep rule, uniform vs $\propto \sigma ^\gamma $. The $\sigma $ arm wins, and the gain is concentrated at small $y_{\min }$: the model's own uncertainty, with no physics coordinate and no reference density, builds a better training set than the best hand-coded sampler}{figure.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {28}{\ignorespaces \textbf  {The concentration exponent $\gamma $ traverses a water-filling trade-off.} Per-decade $\sigma $/base ratio and the deep-vs-bulk split against $\gamma \in \{1,2,3,5,10\}$. The deepest decade ($y_{\min }\!<\!10^{-6}$) falls to $\sim \!\mathbf  {55}\%$ of base ($90,70,66,62,55\%$) while the shallowest bulk decade \emph  {rises} $107\!\to \!128\%$. So the log-flat average is best around $\gamma \!\approx \!3$--$5$ and larger $\gamma $ buys deep-IR accuracy by paying in the bulk: one coordinate-free scalar knob sliding along the allocation trade-off of Thread~B. Extending the sweep to $\gamma =20,30$ shows the deep gain \emph  {saturating} rather than continuing (Fig.~\ref {fig:l2_gamma_response_extended}).}}{55}{figure.28}\protected@file@percent }
\newlabel{fig:l2_uugg_gamma}{{28}{55}{\textbf {The concentration exponent $\gamma $ traverses a water-filling trade-off.} Per-decade $\sigma $/base ratio and the deep-vs-bulk split against $\gamma \in \{1,2,3,5,10\}$. The deepest decade ($y_{\min }\!<\!10^{-6}$) falls to $\sim \!\mathbf {55}\%$ of base ($90,70,66,62,55\%$) while the shallowest bulk decade \emph {rises} $107\!\to \!128\%$. So the log-flat average is best around $\gamma \!\approx \!3$--$5$ and larger $\gamma $ buys deep-IR accuracy by paying in the bulk: one coordinate-free scalar knob sliding along the allocation trade-off of Thread~B. Extending the sweep to $\gamma =20,30$ shows the deep gain \emph {saturating} rather than continuing (Fig.~\ref {fig:l2_gamma_response_extended})}{figure.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {29}{\ignorespaces \textbf  {Absolute per-decade MSE for all $\gamma $.} The same runs as Fig.~\ref {fig:l2_uugg_gamma} on an absolute scale rather than as a ratio to base, so the size of each decade's error is visible alongside the relative gain --- the deep decades carry MSE orders of magnitude above the bulk, which is why a log-flat-per-decade metric (Q2, Fig.~\ref {fig:q2_logflat}) is the honest way to score the trade-off.}}{56}{figure.29}\protected@file@percent }
\newlabel{fig:l2_uugg_perdecade_abs}{{29}{56}{\textbf {Absolute per-decade MSE for all $\gamma $.} The same runs as Fig.~\ref {fig:l2_uugg_gamma} on an absolute scale rather than as a ratio to base, so the size of each decade's error is visible alongside the relative gain --- the deep decades carry MSE orders of magnitude above the bulk, which is why a log-flat-per-decade metric (Q2, Fig.~\ref {fig:q2_logflat}) is the honest way to score the trade-off}{figure.29}{}}
\@writefile{toc}{\contentsline {paragraph}{Transfer of the coordinate-free loop to harder divergences ($u\bar  u g$ multi-scale, $u\bar  u ggg$ more legs).}{56}{section*.40}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {30}{\ignorespaces \textbf  {Pushing the concentration exponent: saturation vs reversal.} $\sigma $-arm/base MSE ratio against $\gamma $ (seed 0), by $y_{\min }$ band. \emph  {Left, $u\bar  u gg$ (concentrated):} the deepest decade improves steeply to $\gamma \!\approx \!10$ then \textbf  {saturates} ($0.53\to 0.51$ over $\gamma =10\to 30$) while the bulk penalty keeps growing ($1.30\to 1.63$) --- the water-filling trade-off running out of anything left to buy. \emph  {Right, $u\bar  u ggg$ (diffuse):} the curve is nearly flat and \textbf  {turns over} above $\gamma \!\approx \!3$, crossing the uniform baseline so that harder concentration is actively worse. Concentration of the error, not depth of the divergence, is what decides whether $\sigma $-steering can pay.}}{58}{figure.30}\protected@file@percent }
\newlabel{fig:l2_gamma_response_extended}{{30}{58}{\textbf {Pushing the concentration exponent: saturation vs reversal.} $\sigma $-arm/base MSE ratio against $\gamma $ (seed 0), by $y_{\min }$ band. \emph {Left, $u\bar u gg$ (concentrated):} the deepest decade improves steeply to $\gamma \!\approx \!10$ then \textbf {saturates} ($0.53\to 0.51$ over $\gamma =10\to 30$) while the bulk penalty keeps growing ($1.30\to 1.63$) --- the water-filling trade-off running out of anything left to buy. \emph {Right, $u\bar u ggg$ (diffuse):} the curve is nearly flat and \textbf {turns over} above $\gamma \!\approx \!3$, crossing the uniform baseline so that harder concentration is actively worse. Concentration of the error, not depth of the divergence, is what decides whether $\sigma $-steering can pay}{figure.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {31}{\ignorespaces \textbf  {$e^+e^-\to u\bar  u g$: the multi-scale test (Z-resonance \emph  {and} IR).} Left: held-out MSE per $y_{\min }$ decade for base (uniform) vs $\sigma $-driven generation at $\gamma {=}1,3$. Right: the same error split by $\sqrt  s$ region. The difficulty lives almost entirely in the \emph  {Z-peak}, not the IR continuum (which \texttt  {base22} already fits to $\sim \!9\times 10^{-4}$); one scalar $\sigma ^\gamma $ finds the resonance on its own --- $2.5\times $ at the peak, $4\times $ in the deep-IR$\,\cap \,$peak corner --- while leaving the easy continuum untouched. The steering density need \emph  {not} be multi-modal to serve two competing extremes.}}{59}{figure.31}\protected@file@percent }
\newlabel{fig:l2_uug_multiscale}{{31}{59}{\textbf {$e^+e^-\to u\bar u g$: the multi-scale test (Z-resonance \emph {and} IR).} Left: held-out MSE per $y_{\min }$ decade for base (uniform) vs $\sigma $-driven generation at $\gamma {=}1,3$. Right: the same error split by $\sqrt s$ region. The difficulty lives almost entirely in the \emph {Z-peak}, not the IR continuum (which \code {base22} already fits to $\sim \!9\times 10^{-4}$); one scalar $\sigma ^\gamma $ finds the resonance on its own --- $2.5\times $ at the peak, $4\times $ in the deep-IR$\,\cap \,$peak corner --- while leaving the easy continuum untouched. The steering density need \emph {not} be multi-modal to serve two competing extremes}{figure.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {32}{\ignorespaces \textbf  {$e^+e^-\to u\bar  u ggg$: more legs, a \emph  {diffuse} divergence.} Held-out MSE per $y_{\min }$ decade, base vs $\sigma $-driven at $\gamma {=}1,3$: the three curves lie on top of each other. With three gluons every decade is comparably hard, so there is no thin sparse region for $\sigma $ to reallocate \emph  {into} --- the contrast with Fig.~\ref {fig:l2_uug_multiscale} is the content of the concentration principle below.}}{60}{figure.32}\protected@file@percent }
\newlabel{fig:l2_uuggg_perdecade}{{32}{60}{\textbf {$e^+e^-\to u\bar u ggg$: more legs, a \emph {diffuse} divergence.} Held-out MSE per $y_{\min }$ decade, base vs $\sigma $-driven at $\gamma {=}1,3$: the three curves lie on top of each other. With three gluons every decade is comparably hard, so there is no thin sparse region for $\sigma $ to reallocate \emph {into} --- the contrast with Fig.~\ref {fig:l2_uug_multiscale} is the content of the concentration principle below}{figure.32}{}}
\@writefile{toc}{\contentsline {paragraph}{A MASSIVE final state ($e^+e^-\to b\bar  b g$) --- and a genuine out-of-sample test of the $\sigma $-contrast diagnostic.}{60}{section*.41}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {33}{\ignorespaces \textbf  {$e^+e^-\to b\bar  b g$ (massive): $\sigma $-steering pays where the $\sigma $-contrast predicted.} \emph  {(a)} Held-out MSE per $y_{\min }$ decade (mass-correct $y_{\min }=\min _{ij}2p_i\!\cdot \! p_j/s$), base vs $\sigma $-driven $\gamma {=}3$. \emph  {(b)} The same error by $\sqrt  s$ region, with the \emph  {pre-recorded} predictions (navy) beside the measured ratios (crimson). The gain concentrates at the $Z$-peak ($0.56\times $) and shoulder ($0.50\times $), not the IR continuum ($0.82\times $): the $m_b$ dead cone softens the collinear direction, so --- as the low deep-IR $\sigma $-contrast predicted --- there is less to gain there. The contrast, computed from the base arm with no A/B, called both the size and the location of the effect on a process the diagnostic was never fit on.}}{61}{figure.33}\protected@file@percent }
\newlabel{fig:l2_bbbarg}{{33}{61}{\textbf {$e^+e^-\to b\bar b g$ (massive): $\sigma $-steering pays where the $\sigma $-contrast predicted.} \emph {(a)} Held-out MSE per $y_{\min }$ decade (mass-correct $y_{\min }=\min _{ij}2p_i\!\cdot \! p_j/s$), base vs $\sigma $-driven $\gamma {=}3$. \emph {(b)} The same error by $\sqrt s$ region, with the \emph {pre-recorded} predictions (navy) beside the measured ratios (crimson). The gain concentrates at the $Z$-peak ($0.56\times $) and shoulder ($0.50\times $), not the IR continuum ($0.82\times $): the $m_b$ dead cone softens the collinear direction, so --- as the low deep-IR $\sigma $-contrast predicted --- there is less to gain there. The contrast, computed from the base arm with no A/B, called both the size and the location of the effect on a process the diagnostic was never fit on}{figure.33}{}}
\@writefile{toc}{\contentsline {paragraph}{$\sigma $ resolved against the divergence coordinate --- and a \emph  {pre-flight} test for the concentration principle.}{62}{section*.42}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {34}{\ignorespaces \textbf  {The learned $\sigma $ rises inside the divergence, and how sharply it does so predicts whether $\sigma $-steering pays.} \emph  {(a)--(c)} Mean $\sigma $ and actual RMSE against the coordinate defining each divergence, both in $\log |\mathcal  M|^2$ units (so the vertical gap is the calibration), all on the base/uniform arm. $u\bar  u g$: $\sigma $ climbs $4.5\times $ into the $Z$ pole and plateaus across it, following a $10\times $ rise in the error. $u\bar  u gg$: a $1.8\times $ rise into the deep IR. $u\bar  u ggg$: nearly flat ($1.3\times $) --- there is no thin region for $\sigma $ to point at. \emph  {(d)} The $\sigma $-contrast $\langle \sigma \rangle _{\rm  singular}/\langle \sigma \rangle _{\rm  bulk}$, measured on the base arm alone, against the $\sigma $-arm/base MSE ratio actually measured in that region. The three processes order monotonically, so the contrast is a \emph  {pre-flight} diagnostic for the concentration principle --- one forward pass, no A/B.}}{63}{figure.34}\protected@file@percent }
\newlabel{fig:l2_sigma_vs_divergence}{{34}{63}{\textbf {The learned $\sigma $ rises inside the divergence, and how sharply it does so predicts whether $\sigma $-steering pays.} \emph {(a)--(c)} Mean $\sigma $ and actual RMSE against the coordinate defining each divergence, both in $\log |\mathcal M|^2$ units (so the vertical gap is the calibration), all on the base/uniform arm. $u\bar u g$: $\sigma $ climbs $4.5\times $ into the $Z$ pole and plateaus across it, following a $10\times $ rise in the error. $u\bar u gg$: a $1.8\times $ rise into the deep IR. $u\bar u ggg$: nearly flat ($1.3\times $) --- there is no thin region for $\sigma $ to point at. \emph {(d)} The $\sigma $-contrast $\langle \sigma \rangle _{\rm singular}/\langle \sigma \rangle _{\rm bulk}$, measured on the base arm alone, against the $\sigma $-arm/base MSE ratio actually measured in that region. The three processes order monotonically, so the contrast is a \emph {pre-flight} diagnostic for the concentration principle --- one forward pass, no A/B}{figure.34}{}}
\@writefile{toc}{\contentsline {paragraph}{A genuinely Bayesian $\sigma $ (full-network Bayes-by-backprop) does \emph  {not} pay for itself.}{63}{section*.43}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {35}{\ignorespaces \textbf  {Epistemic (BBB) vs the het-head $\sigma $ on $e^+e^-\to u\bar  u gg$.} Held-out MSE per $y_{\min }$ decade. The full-network Bayes-by-backprop arm sits \emph  {above} both the het-head $\sigma ^\gamma $ and the uniform baseline across essentially every decade: training under sampled weights costs point accuracy, and the epistemic $\sigma $ does not rank the error well enough ($\rho \!\approx \!0.2$ vs $0.15$) to earn it back.}}{65}{figure.35}\protected@file@percent }
\newlabel{fig:l2_uugg_bbb_vs_het}{{35}{65}{\textbf {Epistemic (BBB) vs the het-head $\sigma $ on $e^+e^-\to u\bar u gg$.} Held-out MSE per $y_{\min }$ decade. The full-network Bayes-by-backprop arm sits \emph {above} both the het-head $\sigma ^\gamma $ and the uniform baseline across essentially every decade: training under sampled weights costs point accuracy, and the epistemic $\sigma $ does not rank the error well enough ($\rho \!\approx \!0.2$ vs $0.15$) to earn it back}{figure.35}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {36}{\ignorespaces \textbf  {The fair BBB HP sweep ($12$ single-fidelity DyHPO trials).} Held-out deep-IR MSE vs the initial posterior width $\sigma _{\rm  rel}$ (left) and the ELBO KL weight $\beta _{\rm  KL}$ (right), coloured by the keep exponent $\gamma $; dashed/dotted lines are the het-head and uniform baselines. $\sigma _{\rm  rel}$ alone sets the outcome (Spearman $+0.965$) and its optimum lands \emph  {on the search lower bound} --- the optimiser drives the weight posterior toward the deterministic limit to buy back accuracy --- while $\beta _{\rm  KL}$ ($-0.05$) and $\gamma $ ($-0.07$) are noise. The best tuned BBB (circled) still sits above the het-head line: the accuracy$\leftrightarrow $uncertainty tension is structural, not a tuning artefact.}}{66}{figure.36}\protected@file@percent }
\newlabel{fig:l2_bbb_sweep}{{36}{66}{\textbf {The fair BBB HP sweep ($12$ single-fidelity DyHPO trials).} Held-out deep-IR MSE vs the initial posterior width $\sigma _{\rm rel}$ (left) and the ELBO KL weight $\beta _{\rm KL}$ (right), coloured by the keep exponent $\gamma $; dashed/dotted lines are the het-head and uniform baselines. $\sigma _{\rm rel}$ alone sets the outcome (Spearman $+0.965$) and its optimum lands \emph {on the search lower bound} --- the optimiser drives the weight posterior toward the deterministic limit to buy back accuracy --- while $\beta _{\rm KL}$ ($-0.05$) and $\gamma $ ($-0.07$) are noise. The best tuned BBB (circled) still sits above the het-head line: the accuracy$\leftrightarrow $uncertainty tension is structural, not a tuning artefact}{figure.36}{}}
\@writefile{toc}{\contentsline {paragraph}{Uncapped data: the uncertainty tail saturates, and it does so data-\emph  {independently}.}{67}{section*.44}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {37}{\ignorespaces \textbf  {Saturation: the uncertainty tail converges to a data-independent floor.} \emph  {(a)} $\sigma $-$p99$ over the fresh proposal batch vs pool size, for three data budgets on $u\bar  u gg$. The curves do not collapse on pool (a larger budget takes fewer optimizer steps to reach a given pool, so its live $\sigma $ sits higher there), but all converge to the same ${\approx }0.046$ floor by end of training --- $8\times $ more data does not lower it, so ${\sim }75$k events already saturate the deep region at this model size/horizon. \emph  {(b)} The per-round fractional fall in $p99$; crossing below the $2\%$ tolerance band is the stopping rule the \texttt  {--stop\_on\_saturation} latch uses.}}{67}{figure.37}\protected@file@percent }
\newlabel{fig:l2_saturation}{{37}{67}{\textbf {Saturation: the uncertainty tail converges to a data-independent floor.} \emph {(a)} $\sigma $-$p99$ over the fresh proposal batch vs pool size, for three data budgets on $u\bar u gg$. The curves do not collapse on pool (a larger budget takes fewer optimizer steps to reach a given pool, so its live $\sigma $ sits higher there), but all converge to the same ${\approx }0.046$ floor by end of training --- $8\times $ more data does not lower it, so ${\sim }75$k events already saturate the deep region at this model size/horizon. \emph {(b)} The per-round fractional fall in $p99$; crossing below the $2\%$ tolerance band is the stopping rule the \code {--stop\_on\_saturation} latch uses}{figure.37}{}}
