+#!/usr/bin/env python3
+"""PreToolUse(SendUserFile): a figure or deck reaches the user only in plain names (CLAUDE.md 0e; the user, 2026-10-27:
+"the rules say that your figures should be understandable and self contained ... And no cryptic unexplained names
+too. So it's a general problem").
+
+Every sent .pdf (a figure or a deck) is read with pdftotext; a .png is read through its sibling .pdf (same basename,
+the figure pair rule), and a .png without one is refused, since it cannot be read. Other file types pass. Refused
+(exit 2, each offending string with its page): run ids (FA-<site>-..., trial_NNNN, hex hashes), recipe and arm
+prefixes (tp3_, tp2_, v3_, v4_, pp13_, dc_, zz_), any other token with an underscore (snake_case identifiers), held-out
+axis codes (H1..H9, H2p5, H3p, H7E, H7c, XV3, XV4), decision and event codes (D12, E1519), and a line saying "ratio",
+"gain" or "/" that names no two sides ("over", or a "/" between two named things).
+A term listed in docs/glossary.txt (term<TAB>plain definition, approved by the user) is allowed wherever it appears.
+    python3 .claude/hooks/send_check.py FILE...     # read-only report, exit 2 if anything is found
+Env for tests: SEND_CHECK_GLOSSARY (path of the glossary)."""
+import json, os, re, subprocess, sys
+
+HERE = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+GLOSSARY = os.environ.get("SEND_CHECK_GLOSSARY", os.path.join(HERE, "docs", "glossary.txt"))
+# most specific first: a span reported by one rule is blanked before the next, so a run id is not also "an underscore"
+RULES = [
+    ("run id", re.compile(r"\bFA-[A-Za-z0-9]+-[\w.-]+|\btrial_\d+\b")),
+    ("recipe or arm prefix", re.compile(r"\b(?:tp3|tp2|v3|v4|pp13|dc|zz)_\w*")),
+    ("held-out axis code", re.compile(r"\b(?:H[1-9](?:p5|p|E|c)?|XV[34])\b")),
+    ("decision or event code", re.compile(r"\b[DE]\d+\b")),
+    ("hex hash", re.compile(r"\b(?=[0-9a-f]*[a-f])(?=[0-9a-f]*\d)[0-9a-f]{7,40}\b")),
+    ("identifier with an underscore", re.compile(r"\w*_\w*")),
+]
+RATIO = re.compile(r"\b(?:ratio|gain)s?\b|/", re.I)
+# a side is any mark but a bracket opening or closing on the slash: "(s/s0)" names both, "ratio /" and "(/ x)" do not
+TWO_SIDES = re.compile(r"\bover\b|[^\s/(\[{]\s*/\s*[^\s/)\]}]", re.I)
+
+
+def glossary_terms(path=GLOSSARY):
+    if not os.path.exists(path):
+        return []
+    terms = [l.split("\t", 1)[0].strip() for l in open(path) if l.strip() and not l.startswith("#")]
+    return sorted((t for t in terms if t), key=len, reverse=True)
+
+
+def findings(text, terms):
+    """[(page, kind, string)] for a pdftotext output (pages split by form feeds)"""
+    out = []
+    for page, pt in enumerate(text.split("\f"), 1):
+        for t in terms:
+            pt = re.sub(r"(?<!\w)%s(?!\w)" % re.escape(t), " ", pt, flags=re.I)
+        for kind, rx in RULES:
+            for m in rx.finditer(pt):
+                out.append((page, kind, m.group()))
+            pt = rx.sub(lambda m: " " * len(m.group()), pt)
+        for line in pt.splitlines():
+            if RATIO.search(line) and not TWO_SIDES.search(line):
+                out.append((page, "ratio, gain or / naming no two sides", " ".join(line.split())[:90]))
+    seen = set()
+    return [f for f in out if not (f in seen or seen.add(f))]
+
+
+def check(path, terms):
+    """problems of one sent file, as message lines"""
+    base, ext = os.path.splitext(path)
+    ext = ext.lower()
+    if ext == ".png":
+        pdf = base + ".pdf"
+        if not os.path.exists(pdf):
+            return ["%s: no sibling %s to read its text from (every figure ships as .png and .pdf)" % (path, pdf)]
+    elif ext == ".pdf":
+        pdf = path
+    else:
+        return []
+    r = subprocess.run(["pdftotext", "-enc", "UTF-8", pdf, "-"], capture_output=True, text=True)
+    if r.returncode:
+        return ["%s: pdftotext failed: %s" % (pdf, r.stderr.strip()[:200])]
+    return ['%s, page %d: %s "%s"' % (pdf, p, k, s) for p, k, s in findings(r.stdout, terms)]
+
+
+def report(paths):
+    terms = glossary_terms()
+    probs = [p for f in paths for p in check(f, terms)]
+    if probs:
+        sys.stderr.write("send_check: not sent; these strings are codes or unexplained names (CLAUDE.md 0e). Redraw "
+                         "with plain names, or, if a term is the plain name, have the user approve it into "
+                         "docs/glossary.txt:\n  " + "\n  ".join(probs) + "\n")
+        return 2
+    return 0
+
+
+def main():
+    if len(sys.argv) > 1:
+        return report(sys.argv[1:])
+    inp = json.load(sys.stdin)
+    if inp.get("tool_name") not in (None, "SendUserFile"):
+        return 0
+    files = (inp.get("tool_input") or {}).get("files") or []
+    cwd = inp.get("cwd") or os.getcwd()
+    return report([f if os.path.isabs(f) else os.path.join(cwd, f) for f in files])
+
+
+if __name__ == "__main__":
+    sys.exit(main())
