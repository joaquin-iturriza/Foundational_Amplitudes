+    rc, out = hook(path, {"tool_name": "SendUserFile", "tool_input": {"files": [code + ".pdf"]}, "cwd": d},
+                   env=dict(os.environ, SEND_CHECK_GLOSSARY=os.path.join(d, "none.txt")))
+    scenario("send_check: without the glossary the same codes are refused", rc == 2 and "trial_0042" in out, (rc, out))
+    spec = importlib.util.spec_from_file_location("send_check", path)
