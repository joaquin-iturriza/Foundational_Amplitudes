+             reasons.get("trial_0042") == (1, "run id or hash") and reasons.get("FA-ccin2p3-cb09b906", ())[1:] ==
+             ("run id or hash",) and reasons.get("9f3c2a1b", ())[1:] == ("run id or hash",)
+             and reasons.get("D155") == (1, "decision or event code") and reasons.get("E1519") == (1, "decision or event code")
+             and reasons.get("H7E") == (2, "held-out axis code") and reasons.get("XV3") == (2, "held-out axis code")
