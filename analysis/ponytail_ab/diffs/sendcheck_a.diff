+    ok = fig("clean", ticks=["new combinations", "2 → 4", "one loop"], ylabel="MSE, catalog v4 / catalog v3",
+             legend="catalog v4, seed 42")
+    rc, out = send([ok + ".png", ok + ".pdf"], caption="catalog v4 against catalog v3 on the processes held out in both")
+    scenario("send_check: a clean figure with a plain caption passes", rc == 0, (rc, out))
+    rc, out = send([ok + ".png"], caption="the prep job's failure on FA-ccin2p3-cb09b906")
+    scenario("send_check: a run id in the caption is refused", rc == 2 and "caption: 'FA-ccin2p3-cb09b906'" in out,
+             (rc, out))
+    os.remove(rat + ".pdf")
+    rc, out = send([rat + ".png"])
+    scenario("send_check: a png without its pdf is refused (its text cannot be read)", rc == 2 and "ratio.pdf" in out,
