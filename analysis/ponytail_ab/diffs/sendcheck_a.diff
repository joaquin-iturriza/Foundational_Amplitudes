+
+    send = lambda files, caption="", e=env: hook(SEND, {"tool_name": "SendUserFile", "cwd": d,
+                                                       "tool_input": {"files": files, "caption": caption}}, env=e)
+    axes = fig("axes", ticks=["H1", "H2", "H7c"], ylabel="median MSE")
+    rc, out = send([axes + ".png"])
+    scenario("send_check: a figure with held-out axis codes is refused, each code named with its page (png read "
+             "through its pdf)", rc == 2 and all("'%s' (held-out axis code)" % c in out for c in ("H1", "H2", "H7c"))
+             and "page 1" in out, (rc, out))
+    arm = fig("arm", ylabel="median MSE", legend="tp3_ladder seed 42", pages=2)
+    rc, out = send([arm + ".pdf"])
+    scenario("send_check: an arm prefix in a legend is refused on the page it is on", rc == 2 and
+             "page 2: 'tp3_ladder' (recipe or arm prefix)" in out, (rc, out))
+    rat = fig("ratio", ylabel="density ratio")
+    rc, out = send([rat + ".pdf"])
+    scenario("send_check: an axis 'density ratio' that does not say what over what is refused",
+             rc == 2 and "'density ratio'" in out, (rc, out))
+    gls = fig("gloss", ylabel="MSE, catalog_v3", legend="zero-shot")
+    rc, out = send([gls + ".png"])
