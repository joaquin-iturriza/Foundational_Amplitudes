+             and reasons.get("val_loss_no_reg") == (3, "identifier with an underscore"), found)
+    clean = sc.check_text("2 → 4 processes, 4264 steps, 1.4915 GeV, D = 10^4, log10 |M|^2 / GeV, Higgs H, "
+                          "catalog v3 against catalog v4, new combinations (H1)", [])
+    scenario("send_check: plain text, numbers, units and a code in brackets after its description pass", not clean, clean)
+    rat = sc.check_text("density ratio   catalog v4 / catalog v3   gain of v4 over v3   / GeV", [])
+    scenario("send_check: a ratio or a '/' that names no two sides is refused, one that does passes",
+             [s for _, s, _ in rat] == ["density ratio", "/ GeV"], rat)
+
+    try:
+        import matplotlib
+        matplotlib.use("Agg")
+        import matplotlib.pyplot as plt
+        from matplotlib.backends.backend_pdf import PdfPages
+    except ImportError:
+        scenario("send_check: matplotlib available for the figure scenarios", False, "no matplotlib")
+        return
+    d = tempfile.mkdtemp()
+    gl = os.path.join(d, "glossary.txt")
+    open(gl, "w").write("# test\ncatalog_v3\tthe catalog generated on 2026-10-24\n")
+    env = dict(os.environ, SEND_CHECK_GLOSSARY=gl)
+
