+#!/usr/bin/env python3
+"""PreToolUse(SendUserFile) hook: what the user is sent reads in plain names (CLAUDE.md 0e). 2026-10-27, after the
+user's "the rules say that your figures should be understandable and self contained ... And no cryptic unexplained
+names too. So it's a general problem".
+
+For each sent file, the text the user will read is extracted with pdftotext: a .pdf (figure or deck) itself, a .png
+through its sibling .pdf (every figure ships as both; a .png without one is refused). Other files pass unread. The
+caption is checked too, for the codes (not for the ratio rule, which is about axis and legend labels). Refused (exit
+2, each offending string with its page):
+  - a token with an underscore (snake_case identifiers, paths, config keys);
+  - a run id: FA-<site>-<id>, trial_NNNN, a hex hash (7+ lowercase hex characters with a letter and a digit);
+  - a recipe or arm prefix: tp3_, tp2_, v3_, v4_, pp13_, dc_, zz_ (and bare tp2, tp3, pp13);
+  - a held-out axis code (H1..H9, H2p5, H2.5, H3p, H7E, H7c, XV3, XV4) or a decision or event code (D12, E1519);
+  - a label with "ratio" or "gain", or with a "/", that names no two sides (no "over", no "/" with text on both sides).
+A label is a run of text on one line of `pdftotext -layout`, split at gaps of three spaces or more.
+Allowed: any term of docs/glossary.txt (term<TAB>plain definition), matched whole-word and case-insensitive; and a code
+in brackets right after plain words ("new combinations (H1)", 0e: "An id may follow the description in brackets").
+A failure of the check itself (no pdftotext, an unreadable pdf) lets the send through with a note on stderr.
+
+    python3 .claude/hooks/send_check.py --scan FILE...    # read-only report, exit 1 when anything is found
+"""
+import json, os, re, subprocess, sys
+
+ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+GLOSSARY = os.environ.get("SEND_CHECK_GLOSSARY") or os.path.join(ROOT, "docs", "glossary.txt")
+
+STRIP = "()[]{},;:'\"`.!?"
+PREFIX = re.compile(r"^(tp3|tp2|v3|v4|pp13|dc|zz)_")
+RUN_ID = re.compile(r"^(FA-[A-Za-z0-9]+-[A-Za-z0-9]+|trial_\d+)$")
+HEX = re.compile(r"^[0-9a-f]{7,40}$")
+AXIS = re.compile(r"^(H[1-9](p5|\.5|E|c|p)?|XV[34])$")
+DECISION = re.compile(r"^[DE]\d+$")
+BARE_RECIPE = re.compile(r"^(tp2|tp3|pp13)$")
+RATIO_WORD = re.compile(r"\b(ratios?|gains?)\b", re.I)
+OVER = re.compile(r"\bover\b", re.I)
+SLASH_BOTH = re.compile(r"\S\s*/\s*\S")
+
+
+def glossary_terms(path=None):
+    terms = []
+    try:
+        for line in open(path or GLOSSARY, encoding="utf-8"):
+            if line.strip() and not line.startswith("#") and "\t" in line:
+                terms.append(line.split("\t", 1)[0].strip())
+    except OSError:
+        pass
+    return [t for t in terms if t]
+
+
+def blank_glossary(text, terms):
+    """Replace every glossary term by spaces (same length), so nothing inside it is flagged."""
+    for t in sorted(terms, key=len, reverse=True):
+        text = re.sub(r"(?<![\w-])%s(?![\w-])" % re.escape(t), lambda m: " " * len(m.group(0)), text, flags=re.I)
+    return text
+
+
+def classify(tok):
+    """The reason a token is refused, or None."""
+    if RUN_ID.match(tok) or (HEX.match(tok) and re.search(r"[a-f]", tok) and re.search(r"\d", tok)):
+        return "run id or hash"
+    if PREFIX.match(tok) or BARE_RECIPE.match(tok):
+        return "recipe or arm prefix"
+    if AXIS.match(tok):
+        return "held-out axis code"
+    if DECISION.match(tok):
+        return "decision or event code"
+    if "_" in tok.strip("_"):
+        return "identifier with an underscore"
+    return None
+
+
+def labels(line):
+    return [c.strip() for c in re.split(r"\s{3,}", line) if c.strip()]
+
+
+def check_label(label, ratio_rule=True):
+    """[(string, reason)] for one label."""
+    out = []
+    toks = label.split()
+    for i, raw in enumerate(toks):
+        tok = raw.strip(STRIP)
+        if not tok:
+            continue
+        why = classify(tok)
+        if not why:
+            continue
+        # a code in brackets after plain words is the description's id (0e)
+        bracketed = re.fullmatch(r"[(\[][^\s()\[\]]+[)\]][,;:.]?", raw)
+        before = [t.strip(STRIP) for t in toks[:i]]
+        if bracketed and before and re.fullmatch(r"[A-Za-z][A-Za-z'\-]+", before[-1]) and not classify(before[-1]):
+            continue
+        out.append((tok, why))
+    if ratio_rule:
+        if RATIO_WORD.search(label) and not (OVER.search(label) or SLASH_BOTH.search(label)):
+            out.append((label, "a ratio or gain that does not say what over what"))
+        elif "/" in label and not SLASH_BOTH.search(label):
+            out.append((label, "a '/' without both sides"))
+    return out
+
+
+def check_text(text, terms, ratio_rule=True):
+    """[(page, string, reason)]; pages are separated by form feeds, as pdftotext writes them."""
+    found, seen = [], set()
+    for p, page in enumerate(blank_glossary(text, terms).split("\f"), 1):
+        for line in page.splitlines():
+            for lab in labels(line):
+                for s, why in check_label(lab, ratio_rule):
+                    if (p, s, why) not in seen:
+                        seen.add((p, s, why))
+                        found.append((p, s, why))
+    return found
+
+
+def pdf_text(path):
+    r = subprocess.run(["pdftotext", "-layout", path, "-"], capture_output=True, text=True, timeout=60)
+    if r.returncode != 0:
+        raise RuntimeError(r.stderr.strip() or "pdftotext failed")
+    return r.stdout
+
+
+def check_file(path, terms):
+    """(findings, note): findings as [(page, string, reason)]; note says why a file was not read."""
+    base, ext = os.path.splitext(path)
+    ext = ext.lower()
+    if ext == ".png":
+        pdf = base + ".pdf"
+        if not os.path.exists(pdf):
+            return [(0, os.path.basename(pdf), "no sibling .pdf to read the figure's text from (figures ship as both)")], None
+        path = pdf
+    elif ext != ".pdf":
+        return [], None
+    try:
+        return check_text(pdf_text(path), terms), None
+    except (OSError, RuntimeError, subprocess.TimeoutExpired) as e:
+        return [], "send_check: could not read %s (%s); not checked" % (path, e)
+
+
+def report(path, found):
+    lines = []
+    for p, s, why in found:
+        where = "page %d" % p if p else "file"
+        lines.append("  %s, %s: %r (%s)" % (path, where, s, why))
+    return lines
+
+
+def main_hook():
+    try:
+        inp = json.load(sys.stdin)
+    except ValueError:
+        return 0
+    ti = inp.get("tool_input") or {}
+    cwd = inp.get("cwd") or os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
+    files = ti.get("files") or []
+    files = [files] if isinstance(files, str) else files
+    files = [f.get("path") or f.get("file_path") if isinstance(f, dict) else f for f in files]
+    files += [ti[k] for k in ("file_path", "path") if isinstance(ti.get(k), str)]
+    terms = glossary_terms()
+    bad, notes = [], []
+    for f in files:
+        if not f:
+            continue
+        path = f if os.path.isabs(f) else os.path.join(cwd, f)
+        found, note = check_file(path, terms)
+        bad += report(f, found)
+        if note:
+            notes.append(note)
+    cap = ti.get("caption")
+    if isinstance(cap, str) and cap:
+        bad += report("caption", [(1, s, w) for _, s, w in check_text(cap, terms, ratio_rule=False)])
+        bad = [b.replace("caption, page 1", "caption") for b in bad]
+    for n in notes:
+        sys.stderr.write(n + "\n")
+    if bad:
+        sys.stderr.write(
+            "send_check: what the user reads must use plain names (CLAUDE.md 0e: no internal codes, no snake_case, a "
+            "ratio says what over what). Redraw or recaption, or add a term to docs/glossary.txt with its plain "
+            "definition (the user approves that file):\n" + "\n".join(bad) + "\n")
+        return 2
+    return 0
+
+
+def main_scan(paths):
+    terms, any_found = glossary_terms(), False
+    for f in paths:
+        found, note = check_file(f, terms)
+        if note:
+            print(note)
+        for line in report(f, found):
+            print(line)
+        any_found = any_found or bool(found)
+        if not found and not note:
+            print("  %s: clean" % f)
+    return 1 if any_found else 0
+
+
+if __name__ == "__main__":
+    if len(sys.argv) > 1 and sys.argv[1] == "--scan":
+        sys.exit(main_scan(sys.argv[2:]))
+    sys.exit(main_hook())
