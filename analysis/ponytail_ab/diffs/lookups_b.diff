+    echo "[review-backlog] watermark $(git log -1 --format='%h %cs %s' "$sha"); backlog ${bl% *} lines, ${bl#* } commits"
+    echo "  the backlog:   git diff $sha --$spec"
+    echo "  its commits:   git log --oneline $sha..HEAD --$spec"
+    echo "  new files:     git ls-files --others --exclude-standard --$spec"
     exit 0
     ;;
 
