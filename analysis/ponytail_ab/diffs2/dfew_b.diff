+"""D83 exploration, fifth pass: few-shot calibration of a pretrained model on a new process, in full. k labelled events
+of the process (k = 3, 10, 30, 100) fit a correction of the model's output, scored on the process's other 2000 - k
+events (MSE of log|M|^2 per process; median and 90% over the 43 new and the 96 relabels).
+  models    hp58 (per-process standardization, read with g's statistics on a new process and its twin's on a relabel),
+            A (the per-event factor (s0/s_hat)^(4-N)/C_p and one shared standardization), B (one shared standardization)
+  methods   level        t = q + a
+            affine       t = a + b q
+            level+inv    t = q + a + c L          L = log s_hat (standardized over the process's 2000 events: no labels)
+            affine+inv   t = a + b q + c L
+            *_rN         the same with a ridge prior b = 1, c = 0 worth N events: N [(b-1)^2 var(q) + c^2 var(L)]
+  draws     random (5 seeds; per process the MSE averaged over the draws), first (the first k, the earlier protocol),
+            low/high_shat (the k events with the smallest/largest s_hat), low/high_q (the k with the smallest/largest
+            predicted |M|^2: a label-free corner of phase space, defined for every process)
+L comes from A's saved per-event factor (logF = -[(4-N)(log s_hat - log s0) + log C_p]); all three models scored the
+same 2000 events in the same order, so it applies to all three. It is not recoverable for 2->2 (4-N = 0) and is
+constant for 2->1: those processes have no inv term (it reduces to the method without it) and no s_hat draws; the
+"_L" groups restrict every draw to the processes that have L, so the draws compare on one set. Other per-event
+invariants (pair masses) need the pools on CC and are not used here.
+A is fitted in its own target space (t and q are log(|M|^2 F)); the difference q - t, hence the MSE, is the same.
+Output data/norm_explore5.json.
+    .venv-driver/bin/python analysis/catalog_daniel/norm_explore5.py
+"""
+import json, os, sys
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.dirname(os.path.dirname(HERE)))
+sys.path.insert(0, HERE)
+from heldout_delta import G  # noqa: E402
+
+KS = (3, 10, 30, 100)
+SEEDS = range(5)
+RIDGE = (1, 3, 10)
+
+
+def fit_predict(y, X, Xall, b0, var, lam):
+    """Least squares of y - X b0 on X (columns: [1, q, L] subset), with a ridge pull toward b0 weighted lam * var
+    per column (var 0 for the intercept); returns the prediction on Xall."""
+    r = y - X @ b0
+    if lam:
+        P = np.diag(np.sqrt(lam * var))
+        X, r = np.vstack([X, P]), np.concatenate([r, np.zeros(len(var))])
+    d = np.linalg.lstsq(X, r, rcond=None)[0]
+    return Xall @ (b0 + d)
+
+
+def methods(q, L):
+    """name -> (columns of [1, q, L] used, prior coefficients, which columns the ridge pulls); level forms keep b = 1
+    by moving q into the offset."""
+    one = np.ones_like(q)
+    out = {"level": (np.c_[one], "q"), "affine": (np.c_[one, q], None)}
+    if L is not None:
+        out["level+inv"] = (np.c_[one, L], "q")
+        out["affine+inv"] = (np.c_[one, q, L], None)
+    else:
+        out["level+inv"], out["affine+inv"] = out["level"], out["affine"]
+    return out
+
+
+def score(t, q, L, idx):
+    """MSE on the events not in idx for every method fitted on idx."""
+    rest = np.setdiff1d(np.arange(len(t)), idx)
+    res = {}
+    for name, (X, off) in methods(q, L).items():
+        y = t - q if off else t
+        ncol = X.shape[1]
+        b0 = np.zeros(ncol)
+        var = np.zeros(ncol)
+        if not off:
+            b0[1] = 1.0; var[1] = q.var()
+        if ncol == 3 or (off and ncol == 2):
+            var[-1] = 1.0   # L is standardized
+        for lam in (0,) + RIDGE:
+            if lam and not var.any():
+                continue
+            p = fit_predict(y[idx], X[idx], X, b0, var, lam) + (q if off else 0)
+            res[name + (f"_r{lam}" if lam else "")] = float(np.mean((p[rest] - t[rest]) ** 2))
+    return res
+
+
+def draws(t, q, L, k):
+    n = len(t)
+    out = {f"random{s}": np.random.default_rng(1000 * k + s).choice(n, k, replace=False) for s in SEEDS}
+    out["first"] = np.arange(k)
+    o = np.argsort(q); out["low_q"], out["high_q"] = o[:k], o[-k:]
+    if L is not None:
+        o = np.argsort(L); out["low_shat"], out["high_shat"] = o[:k], o[-k:]
+    return out
+
+
+def main():
+    rel = set(json.load(open(os.path.join(HERE, "heldout_twins.json"))))
+    meta = {"dc_" + p["folder"]: p for p in json.load(open(os.path.join(HERE, "classes_default.json")))["processes"]}
+    H = dict(np.load(os.path.join(HERE, "data", "heldout_preds.npz")))
+    A = dict(np.load(os.path.join(HERE, "data", "catalog_norm_A.npz")))
+    B = dict(np.load(os.path.join(HERE, "data", "catalog_norm_B.npz")))
+    sn = json.load(open(os.path.join(HERE, "data", "stats_net.json")))
+    for nm, (mu, lsd) in zip(sn["heldout_names"], sn["heldout_pred"][G]):
+        if f"{nm}__q" not in H:     # a new process: g's statistics (catalog_norm_heldout.py's "hp58 + g")
+            H[f"{nm}__q"] = mu + np.exp(lsd) * H[f"{nm}__h"].astype(float)
+    probes = sorted({k.split("__")[0] for k in H if k.endswith("__t")})
+    Ls = {}
+    for p in probes:
+        assert np.allclose(A[f"{p}__t"] - A[f"{p}__logF"], H[f"{p}__t"], atol=1e-3), p   # the same events
+        assert np.allclose(B[f"{p}__t"], H[f"{p}__t"]), p
+        lf = A[f"{p}__logF"].astype(float)
+        # log s_hat up to an affine map (the sign and offset do not matter once standardized)
+        Ls[p] = (lf - lf.mean()) / lf.std() if lf.std() > 1e-6 else None
+    models = {"hp58": H, "A": A, "B": B}
+    per = {}   # (model, k, draw, method) -> {probe: mse}; plus the oracle
+    for mn, z in models.items():
+        for p in probes:
+            t, q, L = z[f"{p}__t"].astype(float), z[f"{p}__q"].astype(float), Ls[p]
+            for name, (X, off) in methods(q, L).items():   # oracle: fit and score on all events
+                y = t - q if off else t
+                d = np.linalg.lstsq(X, y, rcond=None)[0]
+                per.setdefault((mn, "all", "oracle", name), {})[p] = float(np.mean((X @ d + (q if off else 0) - t) ** 2))
+            per.setdefault((mn, "all", "oracle", "none"), {})[p] = float(np.mean((q - t) ** 2))
+            for k in KS:
+                for dn, idx in draws(t, q, L, k).items():
+                    for name, v in score(t, q, L, idx).items():
+                        per.setdefault((mn, k, dn, name), {})[p] = v
+    # random: per process the mean over the seeds
+    for key in [k for k in per if k[2] == "random0"]:
+        mn, k, _, name = key
+        per[(mn, k, "random", name)] = {p: float(np.mean([per[(mn, k, f"random{s}", name)][p] for s in SEEDS]))
+                                         for p in per[key]}
+    groups = {"43 new": [p for p in probes if p not in rel], "96 relabels": [p for p in probes if p in rel]}
+    groups.update({g + " with L": [p for p in P if Ls[p] is not None] for g, P in list(groups.items())})
+    res = {}
+    for (mn, k, dn, name), m in per.items():
+        for g, P in groups.items():
+            Q = [m[p] for p in P if p in m]
+            if not Q:
+                continue
+            r = dict(n=len(Q), median=float(np.median(Q)), p90=float(np.quantile(Q, .9)))
+            if dn == "random":   # the draw-to-draw spread of the median
+                med = [np.median([per[(mn, k, f"random{s}", name)][p] for p in P if p in m]) for s in SEEDS]
+                r["median_min"], r["median_max"] = float(min(med)), float(max(med))
+            res[f"{mn}|{k}|{dn}|{name}|{g}"] = r
+    res["_n_with_L"] = {g: len(P) for g, P in groups.items()}
+    res["_n_by_N_without_L"] = {str(n): sum(1 for p in probes if Ls[p] is None and 2 + meta[p]["n_out"] == n)
+                                for n in (3, 4)}
+    json.dump(res, open(os.path.join(HERE, "data", "norm_explore5.json"), "w"), indent=1)
+
+    def row(mn, k, dn, name, g):
+        r = res.get(f"{mn}|{k}|{dn}|{name}|{g}")
+        return f"{r['median']:.3g}/{r['p90']:.3g}" if r else "-"
+    print("groups:", res["_n_with_L"], "without L by N:", res["_n_by_N_without_L"])
+    meths = ["level", "affine", "level+inv", "affine+inv", "affine_r3", "affine+inv_r3", "affine+inv_r10"]
+    for g in ("43 new", "96 relabels"):
+        print(f"\n== {g}: median/90% MSE, random draws (mean of 5)")
+        print("model k   " + "  ".join(f"{m:>15s}" for m in meths))
+        for mn in models:
+            print(f"{mn:5s} oracle " + "  ".join(f"{row(mn, 'all', 'oracle', m, g):>15s}" for m in meths[:4]))
+            for k in KS:
+                print(f"{mn:5s} {k:<6d} " + "  ".join(f"{row(mn, k, 'random', m, g):>15s}" for m in meths))
+    for g in ("43 new with L", "96 relabels with L"):
+        print(f"\n== {g}: by draw, median/90% MSE")
+        dns = ["random", "first", "low_shat", "high_shat", "low_q", "high_q"]
+        for m in ("level", "affine", "affine+inv", "affine+inv_r3"):
+            print(f"-- {m}")
+            for mn in models:
+                for k in (10, 100):
+                    print(f"{mn:5s} {k:<4d} " + "  ".join(f"{dn}={row(mn, k, dn, m, g)}" for dn in dns))
+
+
+if __name__ == "__main__":
+    main()
