+"""D83 exploration, fifth pass: few-shot calibration of a new process from k of its labelled events, in full.
+Models (the same 2000 validation events per held-out process in all three files):
+  hp58  per-process standardization, read with g's statistics (stats_net.py phys_gbr) on the 43 new, its twin's on
+        the 96 relabels (data/heldout_preds.npz, as catalog_norm_heldout.py)
+  A     per-event factor (s0/s_hat)^(4-N)/C_p + one shared standardization, in its own target space (data/catalog_norm_A.npz)
+  B     one shared standardization, best checkpoint before it blew up at step 8734 (data/catalog_norm_B.npz)
+Calibration maps, fitted on k events of the process, scored by MSE(log|M|^2) on its other 2000 - k events:
+  level     t = q + a
+  affine    t = a + b q
+  affine+L  t = a + b q + c L, L = log s_hat of the event. Only log s_hat is recoverable here: A's log F is
+            -(4-N) log s_hat + const, so L is known per event for the 121 2->3 processes (42 of the 43 new, 79 of the
+            96 relabels) and not for the 2->2 ones, which keep the affine map
+  each in two fits: plain least squares ("ols"), and a shrunk fit ("eb") that pulls b and c towards the median of
+  the oracle coefficients of the other held-out processes of the same kind (new or relabel, known in advance), with
+  their spread (1.4826 MAD) as the prior width and
+  the noise variance from the k events' level-only residuals (an empirical Bayes; it borrows the other held-out
+  processes' full data, which a deployment would take from a set of calibration processes instead). The intercept a
+  is never shrunk.
+k = 3, 10, 30, 100; 5 random draws of the k events per process (per-process MSE averaged over draws, then median
+and 90% over processes; the median's spread over the 5 draws is kept too). Sampling sensitivity, on the 2->3
+processes where s_hat is known: the k events with the smallest s_hat, the k with the largest, and the first k
+(the earlier pass), and 5 draws with probability proportional to s_hat^g, g = -2, -1, +1, +2 (a generator that
+samples the same process differently), against random. Reference: the oracle (each map fitted on all 2000 and scored on them).
+Output data/norm_explore5.json and figs/norm_explore5_fewshot.{png,pdf}.
+    .venv-driver/bin/python analysis/catalog_daniel/norm_explore5.py
+"""
+import json, os, sys
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.dirname(os.path.dirname(HERE)))
+import plot_style as ps  # noqa: E402
+
+KS = (3, 10, 30, 100)
+NDRAW = 5
+MAPS = ("level", "affine", "affine+L")
+FITS = ("ols", "eb")
+
+
+def design(q, L, kind):
+    cols = {"level": [], "affine": [q], "affine+L": [q] + ([L] if L is not None else [])}[kind]
+    return np.stack(cols, 1) if cols else np.zeros((len(q), 0))
+
+
+def fit(t, q, L, kind, prior=None):
+    """Coefficients (a, slopes) of t ~ a + X slopes; level fixes the slope on q to 1."""
+    X = design(q, L, kind)
+    y = t - q if kind == "level" else t
+    xm, ym = X.mean(0), y.mean()
+    Xc, yc = X - xm, y - ym
+    if X.shape[1] == 0:
+        return ym, np.zeros(0)
+    A, r = Xc.T @ Xc, Xc.T @ yc
+    if prior is not None:
+        m, tau = prior
+        m, tau = m[:X.shape[1]], tau[:X.shape[1]]
+        s2 = max(float(np.var(t - q, ddof=1)) if len(t) > 1 else 1.0, 1e-6)
+        P = np.diag(s2 / tau ** 2)
+        A, r = A + P, r + P @ m
+    w = np.linalg.lstsq(A, r, rcond=None)[0]
+    return ym - xm @ w, w
+
+
+def apply(a, w, q, L, kind):
+    X = design(q, L, kind)
+    return (q if kind == "level" else 0.0) + a + X @ w
+
+
+def main():
+    D = os.path.join(HERE, "data")
+    twins = set(json.load(open(os.path.join(HERE, "heldout_twins.json"))))
+    mo = json.load(open(os.path.join(D, "norm_moments2.json")))
+    z58 = dict(np.load(os.path.join(D, "heldout_preds.npz")))
+    zA = dict(np.load(os.path.join(D, "catalog_norm_A.npz")))
+    zB = dict(np.load(os.path.join(D, "catalog_norm_B.npz")))
+    sn = json.load(open(os.path.join(D, "stats_net.json")))
+    for n, (mu, lsd) in zip(sn["heldout_names"], sn["heldout_pred"]["phys_gbr"]):
+        if f"{n}__q" not in z58:
+            z58[f"{n}__q"] = mu + np.exp(lsd) * z58[f"{n}__h"].astype(float)
+    probes = sorted({k.split("__")[0] for k in zA if k.endswith("__t")})
+    N = {p: mo["heldout"][p]["N"] for p in probes}
+    # log s_hat up to a per-process constant (absorbed by the intercept): A's log F = (4 - N) log(s0/s_hat) - log C_p
+    Lh = {p: (zA[f"{p}__logF"].astype(float) / (N[p] - 4) if N[p] != 4 else None) for p in probes}
+    models = {m: {p: (z[f"{p}__t"].astype(float), z[f"{p}__q"].astype(float)) for p in probes}
+              for m, z in (("hp58", z58), ("A", zA), ("B", zB))}
+    new = [p for p in probes if p not in twins]
+    rel = [p for p in probes if p in twins]
+    has_L = [p for p in probes if Lh[p] is not None]
+    print(f"{len(probes)} held-out: {len(new)} new, {len(rel)} relabels; s_hat known (2->3) for "
+          f"{sum(p in has_L for p in new)} new, {sum(p in has_L for p in rel)} relabels", flush=True)
+
+    def mse(t, q):
+        return float(np.mean((q - t) ** 2))
+
+    out = {"ks": KS, "ndraw": NDRAW, "oracle": {}, "random": {}, "sampling": {}, "coef": {}}
+    for m, P in models.items():
+        # oracle coefficients and errors (fit and score on all 2000)
+        coef = {kind: {} for kind in MAPS}
+        orc = {kind: {} for kind in MAPS}
+        for p, (t, q) in P.items():
+            for kind in MAPS:
+                a, w = fit(t, q, Lh[p], kind)
+                coef[kind][p] = w
+                orc[kind][p] = mse(t, apply(a, w, q, Lh[p], kind))
+        out["coef"][m] = {
+            f"{kind}|{g}": dict(median=np.median([coef[kind][p] for p in G if p in has_L], 0).tolist(),
+                                q16=np.quantile([coef[kind][p] for p in G if p in has_L], .16, 0).tolist(),
+                                q84=np.quantile([coef[kind][p] for p in G if p in has_L], .84, 0).tolist())
+            for kind in MAPS[1:] for g, G in (("new 2->3", new), ("relabels 2->3", rel))}
+
+        def prior(p, kind):
+            # from the other held-out processes of the same kind (new or relabel: known before any event is seen)
+            same = [o for o in probes if o != p and (o in twins) == (p in twins)]
+            W = np.array([coef["affine+L"][o] for o in same if o in has_L])
+            Wb = np.array([coef["affine"][o][0] for o in same])
+            if kind == "affine":
+                mm, s = np.median(Wb), 1.4826 * np.median(np.abs(Wb - np.median(Wb)))
+                return np.array([mm]), np.array([max(s, 1e-3)])
+            mm = np.median(W, 0)
+            s = 1.4826 * np.median(np.abs(W - mm), 0)
+            return mm, np.maximum(s, 1e-3)
+
+        def score(draws):
+            """draws: p -> list of index arrays; returns {kind|fit: {p: mean MSE on the rest, draw medians}}."""
+            res = {}
+            for kind in MAPS:
+                for f in FITS:
+                    if kind == "level" and f == "eb":
+                        continue
+                    per = {}
+                    for p, idxs in draws.items():
+                        t, q = P[p]
+                        L = Lh[p]
+                        pr = prior(p, kind) if f == "eb" else None
+                        e = []
+                        for idx in idxs:
+                            rest = np.setdiff1d(np.arange(len(t)), idx)
+                            a, w = fit(t[idx], q[idx], None if L is None else L[idx], kind, pr)
+                            e.append(mse(t[rest], apply(a, w, q[rest], None if L is None else L[rest], kind)))
+                        per[p] = e
+                    res[f"{kind}|{f}"] = per
+            return res
+
+        def summ(per, group):
+            v = np.array([np.mean(per[p]) for p in group if p in per])
+            dm = [float(np.median([per[p][d] for p in group if p in per])) for d in range(len(next(iter(per.values()))))]
+            return dict(n=len(v), median=float(np.median(v)), p90=float(np.quantile(v, .9)),
+                        draw_median_min=min(dm), draw_median_max=max(dm))
+
+        out["oracle"][m] = {kind: {g: dict(median=float(np.median([orc[kind][p] for p in G])),
+                                           p90=float(np.quantile([orc[kind][p] for p in G], .9)))
+                                   for g, G in (("43 new", new), ("96 relabels", rel),
+                                                ("new 2->3", [p for p in new if p in has_L]),
+                                                ("relabels 2->3", [p for p in rel if p in has_L]))}
+                            for kind in MAPS}
+        out["random"][m], out["sampling"][m] = {}, {}
+        for k in KS:
+            rng = np.random.default_rng(1000 + k)
+            draws = {p: [rng.choice(len(P[p][0]), k, replace=False) for _ in range(NDRAW)] for p in probes}
+            res = score(draws)
+            out["random"][m][k] = {key: {g: summ(per, G) for g, G in (("43 new", new), ("96 relabels", rel))}
+                                   for key, per in res.items()}
+            for key in res:
+                v = out["random"][m][k][key]
+                print(f"{m:5s} k={k:3d} {key:14s} random: 43 new median {v['43 new']['median']:.3g} "
+                      f"(90% {v['43 new']['p90']:.3g}, draws {v['43 new']['draw_median_min']:.3g} to "
+                      f"{v['43 new']['draw_median_max']:.3g}); 96 relabels {v['96 relabels']['median']:.3g} "
+                      f"(90% {v['96 relabels']['p90']:.3g})", flush=True)
+            # sampling sensitivity on the 2->3 processes (s_hat known)
+            samp = {"random": {p: draws[p] for p in has_L},
+                    "smallest s_hat": {p: [np.argsort(Lh[p])[:k]] for p in has_L},
+                    "largest s_hat": {p: [np.argsort(Lh[p])[-k:]] for p in has_L},
+                    "first k": {p: [np.arange(k)] for p in has_L}}
+            # a generator that samples differently: k events drawn with probability proportional to s_hat^g
+            for g in (-2, -1, 1, 2):
+                samp[f"weight s_hat^{g:+d}"] = {p: [rng.choice(len(Lh[p]), k, replace=False, p=wt / wt.sum())
+                                                   for _ in range(NDRAW)]
+                                               for p in has_L for wt in [np.exp(g * (Lh[p] - Lh[p].max()))]}
+            out["sampling"][m][k] = {}
+            for sname, dr in samp.items():
+                r = score(dr)
+                out["sampling"][m][k][sname] = {
+                    key: {g: summ(per, [p for p in G if p in has_L]) for g, G in (("43 new", new), ("96 relabels", rel))}
+                    for key, per in r.items()}
+            for key in ("level|ols", "affine|ols", "affine|eb", "affine+L|ols", "affine+L|eb"):
+                print(f"      2->3 {key:14s} " + "; ".join(
+                    f"{s}: {out['sampling'][m][k][s][key]['43 new']['median']:.3g}/"
+                    f"{out['sampling'][m][k][s][key]['96 relabels']['median']:.3g}" for s in samp), flush=True)
+        for kind in MAPS:
+            o = out["oracle"][m][kind]
+            print(f"{m:5s} oracle {kind:9s}: 43 new {o['43 new']['median']:.3g} (90% {o['43 new']['p90']:.3g}); "
+                  f"96 relabels {o['96 relabels']['median']:.3g} (90% {o['96 relabels']['p90']:.3g})", flush=True)
+    json.dump(out, open(os.path.join(D, "norm_explore5.json"), "w"), indent=1)
+
+    import matplotlib.pyplot as plt
+    fig, axs = plt.subplots(1, 2, figsize=(7.2, 2.9), sharey=True)
+    col = {"hp58": ps.C.grey, "A": ps.C.vermillion, "B": ps.C.blue}
+    ls = {"level|ols": ":", "affine|eb": "--", "affine+L|eb": "-"}
+    lab = {"level|ols": "level", "affine|eb": "affine", "affine+L|eb": r"affine + $\log\hat s$"}
+    for ax, g in zip(axs, ("43 new", "96 relabels")):
+        for m in models:
+            for key in ls:
+                ax.plot(KS, [out["random"][m][k][key][g]["median"] for k in KS], ls[key], color=col[m], marker="o",
+                        ms=3, label=f"{m}, {lab[key]}")
+            ax.axhline(out["oracle"][m]["affine+L"][g]["median"], color=col[m], lw=0.6, alpha=0.6)
+        ax.set_xscale("log"); ax.set_yscale("log"); ax.set_xlabel("labelled events $k$")
+        ax.text(0.96, 0.5, g, transform=ax.transAxes, fontsize=8, ha="right", va="center")
+    axs[0].set_ylabel(r"median MSE$(\log|\mathcal{M}|^2)$")
+    fig.legend(*axs[0].get_legend_handles_labels(), loc="upper center", ncol=3, fontsize=6.5, frameon=False)
+    fig.subplots_adjust(left=0.1, right=0.99, top=0.78, bottom=0.16, wspace=0.06)
+    os.makedirs(os.path.join(HERE, "figs"), exist_ok=True)
+    ps.save(fig, os.path.join(HERE, "figs", "norm_explore5_fewshot"))
+
+
+if __name__ == "__main__":
+    main()
