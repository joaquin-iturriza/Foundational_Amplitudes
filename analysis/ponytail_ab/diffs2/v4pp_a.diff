--- /dev/null
+++ b/analysis/catalog_v4/pp_trained_compare.py
@@ -0,0 +1,162 @@
+"""catalog_v4 against training on pp, on pp events (catalog_coverage; the user, 2026-10-26: what mattered most was how
+training on catalog_v4 compares to training on pp collisions on the data generated like pp collisions). At no compute,
+from reads that exist:
+  pp-trained       dimensionless_pp (FA-ccin2p3-e786bd74, read completed by 982b5a14): catalog_v3's dimensionless arm
+                   with every hadronic training tree class trained on its 13 TeV pp events, AdamW, one seed
+  window, AdamW    dimensionless: the same arm on catalog_v3's windows, AdamW, one seed (its matched control)
+  catalog_v3 Muon  dimensionless_muon_best, _seed2: the dimensionless arm on catalog_v3's windows, Muon at the search best
+  catalog_v4 Muon  v4_dimensionless_muon, _seed2: the same on catalog_v4
+All six at 4264 steps, read zero-shot (in distribution for the pp-trained arm's training classes) at the best checkpoint
+on the first 2000 validation events of each class's 13 TeV pp pool (recipes/catalog_v3_pp_test.yaml, 1396 classes).
+The AdamW rows are analysis/catalog_v3/data/pp_rows.json (pp_compare.py collect), the Muon reads the .npz of
+analysis/catalog_v3/data/short_reads/<run>/PP with the inside masks of data/compare_v3_site.json (compare_v3.py collect).
+Two checks first, asserted: the reads are the same events (per class the variance of the target of every Muon read
+equals the pp-trained arm's within 1e-3 relative; the pools were not rebuilt in between, tools/width_regen.py touches
+no pp13 pool) and the split into the events inside catalog_v3's window coverage is one definition (both come from
+pp_compare.support_masks; per class the share inside agrees exactly).
+Groups as compare_v3.pp: the class's role in catalog_v3 and catalog_v4 (trained in both, held out in both), b classes
+apart (the pp pools carry catalog_v3's 4.7 GeV b, which the pp-trained arm trained on and catalog_v4 never saw).
+Per group and measure (whole pool, inside, outside), each a median over classes of the per-class ratio:
+  direct     catalog_v4 Muon (geometric mean of its seeds) over pp-trained AdamW; optimizers differ
+  pp gain    pp-trained over window AdamW (one optimizer, one seed each)
+  v4 gain    catalog_v4 over catalog_v3 Muon (one optimizer, two seeds each)
+  recovered  log(v4 gain) / log(pp gain): the share of the pp-training gain, in log, that catalog_v4 gets with Muon
+    python3 analysis/catalog_v4/pp_trained_compare.py   -> data/pp_trained_compare.json, figs/pp_trained_compare.{png,pdf}
+The last line printed is the JSON of the numbers docs/results.tex quotes.
+"""
+import json, os, sys
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(os.path.dirname(HERE))
+sys.path.insert(0, ROOT)
+sys.path.insert(0, HERE)
+import compare_v3 as cv
+
+V3, V4 = cv.RUNS["v3"], cv.RUNS["v4"]
+KEYS = ("mse", "mse_inside", "mse_outside")
+
+
+def rows():
+    """class -> {arm: {measure: mse}} for the two AdamW arms and the four Muon runs, with the two checks"""
+    ad = json.load(open(os.path.join(ROOT, "analysis", "catalog_v3", "data", "pp_rows.json")))
+    site = json.load(open(os.path.join(HERE, "data", "compare_v3_site.json")))["pp"]
+    out, var_dev = {}, 0.0
+    for n, p in ad["dimensionless_pp"]["pp"].items():
+        w = ad["dimensionless"]["pp"][n]
+        ins = np.frombuffer(site[n]["inside"].encode(), dtype=np.uint8) == ord("1")
+        assert ins.mean() == p["frac_inside"] == w["frac_inside"], n          # one split definition
+        out[n] = {"pp": {k: p[k] for k in KEYS}, "win": {k: w[k] for k in KEYS}}
+        for r in V3 + V4:
+            z = np.load(os.path.join(cv.SR, r, "PP", n + ".npz"))
+            t, d = z["t"].astype(float), z["q"].astype(float) - z["t"].astype(float)
+            var_dev = max(var_dev, abs(np.var(t) / p["var_t"] - 1))
+            la = t - z["logF"].astype(float)
+            o = np.argsort(la, kind="stable")                                  # matched to the mask as compare_v3.pp
+            assert np.max(np.abs(la[o][::2000 // cv.CHECK] - np.array(site[n]["check"]))) < 1e-3, (r, n)
+            m = np.empty(len(d), bool)
+            m[o] = ins
+            out[n][r] = {"mse": float(np.mean(d ** 2)),
+                         "mse_inside": float(np.mean(d[m] ** 2)) if m.any() else None,
+                         "mse_outside": float(np.mean(d[~m] ** 2)) if (~m).any() else None}
+    assert var_dev < 1e-3, f"the pp reads are not the same events (variance of the target off by {var_dev})"
+    return out, var_dev
+
+
+def ratio(num, den):
+    num, den = np.array(num), np.array(den)
+    lr = np.log10(num / den)
+    return {"n": len(lr), "ratio": float(10 ** np.median(lr)), "lower_pct": float(100 * np.mean(lr < 0)),
+            "num_med": float(np.median(num)), "den_med": float(np.median(den))}
+
+
+def main():
+    R, var_dev = rows()
+    # the class roles as compare_v3.pp gives them (catalog_v4 roles through merges and splits)
+    R3 = json.load(open(os.path.join(ROOT, "recipes", "catalog_v3_roles.json")))["trees"]
+    R4 = json.load(open(os.path.join(ROOT, "recipes", "catalog_v4_roles.json")))["trees"]
+    cc = json.load(open(os.path.join(HERE, "data", "class_changes.json")))
+    m4 = {k: v["role"] for k, v in R4.items()}
+    for g in cc["merges"]:
+        for x in g["members"]:
+            m4.setdefault(x, g["role"][0])
+    for sp in cc["splits"]:
+        for v in sp["v4_classes"].values():
+            for x in v["members"]:
+                m4.setdefault(x, v["role"][0])
+    role = {n: (R3["v3_" + n[5:]]["role"], m4.get("v4_" + n[5:], "absent")) for n in R}
+    groups = {"train": ("train", "train"), "heldout": ("heldout", "heldout")}
+    out = {"n": len(R), "max_var_t_dev": var_dev}
+    for bk in ("no_b", "b"):
+        for g, want in groups.items():
+            pr = [n for n in R if role[n] == want and cv.has_b(n) == (bk == "b")]
+            e = out.setdefault(bk, {}).setdefault(g, {"n": len(pr)})
+            for k in KEYS:
+                ps_ = [n for n in pr if all(R[n][a][k] is not None for a in ("pp", "win") + V3 + V4)]
+                g4 = [np.sqrt(R[n][V4[0]][k] * R[n][V4[1]][k]) for n in ps_]
+                g3 = [np.sqrt(R[n][V3[0]][k] * R[n][V3[1]][k]) for n in ps_]
+                pp, win = [R[n]["pp"][k] for n in ps_], [R[n]["win"][k] for n in ps_]
+                d = ratio(g4, pp)
+                d["v4_lower_both_pct"] = float(100 * np.mean([R[n][V4[0]][k] < R[n]["pp"][k] and
+                                                              R[n][V4[1]][k] < R[n]["pp"][k] for n in ps_]))
+                d["pp_lower_both_pct"] = float(100 * np.mean([R[n][V4[0]][k] > R[n]["pp"][k] and
+                                                              R[n][V4[1]][k] > R[n]["pp"][k] for n in ps_]))
+                gp, gv = ratio(pp, win), ratio(g4, g3)
+                e[k] = {"direct": d, "pp_gain": gp, "v4_gain": gv,
+                        "recovered": float(np.log(gv["ratio"]) / np.log(gp["ratio"])),
+                        "muon_on_windows": ratio(g3, win)}
+    out["roles"] = {}
+    for n in R:
+        k = "/".join(role[n]) + ("/b" if cv.has_b(n) else "")
+        out["roles"][k] = out["roles"].get(k, 0) + 1
+    json.dump(out, open(os.path.join(HERE, "data", "pp_trained_compare.json"), "w"), indent=1)
+    plot(out)
+    for bk in ("no_b", "b"):
+        for g in groups:
+            for k in KEYS:
+                e = out[bk][g][k]
+                print(f"{bk:4s} {g:7s} {k:11s} n={e['direct']['n']:4d} v4/pp {e['direct']['ratio']:.3g} "
+                      f"(v4 lower both {e['direct']['v4_lower_both_pct']:.0f}%, pp lower both {e['direct']['pp_lower_both_pct']:.0f}%; "
+                      f"medians v4 {e['direct']['num_med']:.3g} pp {e['direct']['den_med']:.3g}) | pp gain {e['pp_gain']['ratio']:.3g} "
+                      f"v4 gain {e['v4_gain']['ratio']:.3g} recovered {e['recovered']:.2f} | Muon/AdamW on windows "
+                      f"{e['muon_on_windows']['ratio']:.3g}")
+    claims = {"n": out["n"], "max_var_t_dev": var_dev}
+    for bk in ("no_b", "b"):
+        for g in groups:
+            c = claims.setdefault(bk, {}).setdefault(g, {"n": out[bk][g]["n"]})
+            for k in KEYS:
+                e = out[bk][g][k]
+                c[k] = {"n": e["direct"]["n"], "v4_over_pp": e["direct"]["ratio"],
+                        "v4_lower_both_pct": e["direct"]["v4_lower_both_pct"],
+                        "pp_lower_both_pct": e["direct"]["pp_lower_both_pct"],
+                        "v4_med": e["direct"]["num_med"], "pp_med": e["direct"]["den_med"],
+                        "pp_gain": e["pp_gain"]["ratio"], "v4_gain": e["v4_gain"]["ratio"], "recovered": e["recovered"],
+                        "muon_on_windows": e["muon_on_windows"]["ratio"]}
+    print(json.dumps(claims))
+
+
+def plot(out):
+    """per group (no b), per measure: the pp-training gain (AdamW), catalog_v4's gain over catalog_v3 (Muon) and
+    catalog_v4 against the pp-trained arm directly, each the median per-class MSE ratio"""
+    import plot_style as ps
+    fig, axs = ps.figure(ncols=2)
+    ser = (("pp_gain", "pp / windows, AdamW", ps.C.green, "o"), ("v4_gain", "v4 / v3, Muon", ps.C.vermillion, "s"),
+           ("direct", "v4 Muon / pp AdamW", ps.C.blue, "D"))
+    for ax, g, lab in zip(axs, ("train", "heldout"), ("trained in both", "held out in both")):
+        x = np.arange(len(KEYS))
+        for j, (key, name, col, mk) in enumerate(ser):
+            ax.plot(x + (j - 1) * 0.15, [out["no_b"][g][k][key]["ratio"] for k in KEYS], mk, color=col, label=name)
+        ax.axhline(1, ls="--", color="k", label="equal")
+        ax.set_xticks(x)
+        ax.set_xticklabels(["whole pool", "inside", "outside"])
+        ax.set_yscale("log")
+        ax.set_ylim(0.05, 20)                            # one range for both panels, room for the legend
+        ax.set_ylabel("median MSE ratio")
+        ax.set_xlabel(f"classes {lab}")
+    ps.legend(axs[0], "upper left")
+    ps.save(fig, os.path.join(HERE, "figs", "pp_trained_compare"))
+
+
+if __name__ == "__main__":
+    main()
