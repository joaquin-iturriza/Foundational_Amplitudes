diff --git a/analysis/catalog_v3/prep_hybrid_level.py b/analysis/catalog_v3/prep_hybrid_level.py
new file mode 100644
index 00000000..36a3ca83
--- /dev/null
+++ b/analysis/catalog_v3/prep_hybrid_level.py
@@ -0,0 +1,97 @@
+"""Where the hybrid's level error comes from (the preprocessing exploration on catalog_v3, v3_prep_explore): on the saved
+zero-shot reads (data/short_reads/<arm>/<axis>/<probe>.npz: t and q in the arm's target space, logF its per-event
+factor), per probe, the signed level b = mean(q - t) of three arms, the hybrid (h), the emission scales (q) and s_hat
+alone (s), and the hybrid's split
+    b_h = (mean q_h - mean t_q) - (c_p handed - c_p of these events)
+the first term the network's error on the class mean it has to predict (the emission-scale target's, which the hybrid
+target shares by construction), the second the constant it was handed: c_p handed = mean(logF_h - logF_s), c_p of
+these events = mean(logF_q - logF_s).
+Two readings of the network's term:
+  pT >= 30   against the shift of the constant with the cut, c_p of the same process at the default cuts (its
+             training classes', data/prep_level.json) minus the probe's: the network recalling the training constant
+  every axis against a composition fit of c_p (ridge on prep_level's particle counts, fitted on the training classes):
+             the network guessing the constant from the particle content
+and, for the blend y_h + lam (D - c_p) (D = Lq - (N - 4) log s_hat per event; class mean kept), the pT >= 30 level
+expected if the recalled part shrinks to (1 - lam) of the shift.
+    python3 analysis/catalog_v3/prep_hybrid_level.py   -> data/prep_hybrid_level.json, one flat JSON line last
+"""
+import glob, json, os
+
+import numpy as np
+import yaml
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(os.path.dirname(HERE))
+RD = os.path.join(HERE, "data", "short_reads")
+AXES = ("H1", "H2", "H2p5", "H3", "H5", "H6", "H7E", "H7c")
+KIND = {21: "g", 22: "a", 23: "Z", 24: "W", 25: "H", 6: "t", 5: "b", 1: "q", 2: "q", 3: "q", 4: "q",
+        11: "l", 13: "l", 15: "l", 12: "v", 14: "v", 16: "v"}
+KINDS = sorted(set(KIND.values())) + ["x"]                # as prep_level.py; x: a BSM particle
+
+
+def load(arm, ax, p):
+    z = np.load(os.path.join(RD, arm, ax, p + ".npz"))
+    return {k: z[k].astype(float) for k in ("t", "q", "logF")}
+
+
+def probes(ax):
+    out = {}
+    for f in sorted(glob.glob(os.path.join(RD, "dimensionless_hybrid", ax, "*.npz"))):
+        p = os.path.basename(f)[:-4]
+        try:
+            h, q, s = (load(a, ax, p) for a in ("dimensionless_hybrid", "dimensionless", "dimensionless_shat"))
+        except FileNotFoundError:
+            continue
+        if min(len(h["q"]), len(q["q"]), len(s["q"]), len(h["logF"])) == 0:
+            continue
+        cp_h, cp = np.mean(h["logF"] - s["logF"]), np.mean(q["logF"] - s["logF"])
+        out[p] = {"bh": np.mean(h["q"] - h["t"]), "bq": np.mean(q["q"] - q["t"]), "bs": np.mean(s["q"] - s["t"]),
+                  "net": np.mean(h["q"]) - np.mean(q["t"]), "dcp": cp_h - cp, "cp": cp,
+                  "cp_sd": float(np.std(h["logF"] - s["logF"]))}
+    return out
+
+
+def feat(c):
+    f = [c["N"]]
+    for side in (c["pdg"][:2], c["pdg"][2:]):
+        n = dict.fromkeys(KINDS, 0)
+        for p in side:
+            n[KIND.get(abs(p), "x")] += 1
+        f += [n[k] for k in KINDS]
+    return f + [1]
+
+
+def main():
+    pl = json.load(open(os.path.join(HERE, "data", "prep_level.json")))["classes"]
+    X = np.array([feat(c) for c in pl["train"].values()], float)
+    w = np.linalg.solve(X.T @ X + 1e-2 * np.eye(X.shape[1]), X.T @ np.array([c["c_p"] for c in pl["train"].values()]))
+    out, flat = {}, {}
+    for ax in AXES:
+        r = probes(ax)
+        a = {k: np.array([v[k] for v in r.values()]) for k in next(iter(r.values()))}
+        comp = np.array([np.array(feat(pl[ax][p])) @ w - r[p]["cp"] if p in pl.get(ax, {}) else np.nan for p in r])
+        o = {"n": len(r), "level_h": np.median(a["bh"] ** 2), "level_q": np.median(a["bq"] ** 2),
+             "level_s": np.median(a["bs"] ** 2), "net_h": np.median(a["net"] ** 2), "const_h": np.median(a["dcp"] ** 2),
+             "max_cp_sd": a["cp_sd"].max(), "ratio_hq": np.median(a["bh"] ** 2 / a["bq"] ** 2),
+             "ratio_net_q": np.median(a["net"] ** 2 / a["bq"] ** 2),
+             "extra_h": np.median((a["bh"] - a["bs"]) ** 2), "extra_q": np.median((a["bq"] - a["bs"]) ** 2)}
+        if ax != "H5":                                    # prep_level reads trees only
+            ok = ~np.isnan(comp)
+            o.update(comp_cp=np.nanmedian(comp ** 2), corr_extra_comp=np.corrcoef((a["bh"] - a["bs"])[ok], comp[ok])[0, 1])
+        if ax == "H7c":
+            base = {e["name"]: e["base"] for e in
+                    yaml.safe_load(open(os.path.join(ROOT, "recipes", "catalog_v3_heldout_H7c.yaml")))["processes"]}
+            sh = np.array([pl["train"][base[p]]["c_p"] - r[p]["cp"] for p in r])
+            o.update(shift=np.median(sh ** 2), abs_shift=np.median(np.abs(sh)), corr_shift=np.corrcoef(sh, a["bh"])[0, 1],
+                     slope_shift=np.polyfit(sh, a["bh"], 1)[0], level_h_minus_shift=np.median((a["bh"] - sh) ** 2))
+            for lam in (0.25, 0.5, 0.75):
+                o[f"blend_{lam}"] = np.median((a["bh"] - lam * sh) ** 2)
+        out[ax] = {k: float(v) for k, v in o.items()}
+        print(ax, json.dumps({k: float(f"{v:.3g}") for k, v in out[ax].items()}))
+        flat.update({f"{ax}_{k}": float(f"{v:.3g}") for k, v in out[ax].items()})
+    json.dump(out, open(os.path.join(HERE, "data", "prep_hybrid_level.json"), "w"), indent=1)
+    print(json.dumps(flat))
+
+
+if __name__ == "__main__":
+    main()
