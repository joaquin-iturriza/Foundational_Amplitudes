+"""D83 exploration, fifth pass: few-shot calibration of a pretrained model on a new process, in full.
+k labelled events of the held-out process (k = 3, 10, 30, 100) fix a correction of the model's prediction q, scored on
+that process's other 2000 - k held-out events, MSE(log|M|^2) per process, median and 90% quantile over the 43 new and
+the 96 relabels, for hp58 (per-process standardization, read with the statistics map g), A (per-event factor + shared
+standardization) and B (one shared standardization).
+
+Corrections, all of the residual y = t - q:
+  level            y = b                              (one number)
+  affine           y = b + (a - 1) q                  (rescale and shift)
+  level + inv      y = b + c l                        (l = log s_hat, the per-event invariant)
+  affine + inv     y = b + (a - 1) q + c l
+each as least squares (lam = 0) and as ridge shrunk towards the level correction: the slopes, on centred features, carry
+the penalty lam * diag(X^T X), so a slope is shrunk by 1 / (1 + lam) (lam = inf is the level correction). lam is
+chosen per process on the OTHER processes of its group (leave one process out: median over them of the mean over
+draws), from LAMS, so no process picks its own.
+The invariant: l = log s_hat, read off A's per-event factor logF = (4 - N) log(s0 / s_hat) - log C_p, affine in
+log s_hat within a process for N >= 5 (the intercept absorbs the rest). For the 16 2->2 processes logF is constant and
+s_hat is not in the local files (it is in the CC pools; not reachable here), so "+ inv" falls back to its correction
+without l there.
+Sampling of the k events: random (5 draws), the first k (as norm_explore4.py), the k with the smallest s_hat, the k
+with the largest, k spread evenly over the s_hat quantiles. The s_hat-ordered ones are read on the processes with
+s_hat (42 new, 81 relabels) against random on the same processes.
+Inputs: data/heldout_preds.npz (hp58), data/catalog_norm_{A,B}.npz, data/stats_net.json (g). Output
+data/norm_explore5.json, figs/norm_explore5_fewshot.
+    .venv-driver/bin/python analysis/catalog_daniel/norm_explore5.py
+"""
+import json, os, sys
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.dirname(os.path.dirname(HERE)))
+sys.path.insert(0, HERE)
+from heldout_delta import G  # noqa: E402
+
+KS = (3, 10, 30, 100)
+NDRAW = 5
+LAMS = (0.0, 0.03, 0.1, 0.3, 1.0, 3.0, 10.0, 30.0, np.inf)
+METHODS = ("level", "affine", "level+inv", "affine+inv")
+SAMPLINGS = ("random", "first", "smallest_s", "largest_s", "spread_s")
+
+
+def load_models():
+    z58 = dict(np.load(os.path.join(HERE, "data", "heldout_preds.npz")))
+    sn = json.load(open(os.path.join(HERE, "data", "stats_net.json")))
+    for n, (mu, lsd) in zip(sn["heldout_names"], sn["heldout_pred"][G]):
+        if f"{n}__h" in z58:
+            z58[f"{n}__q"] = mu + np.exp(lsd) * z58[f"{n}__h"].astype(float)
+    zA = dict(np.load(os.path.join(HERE, "data", "catalog_norm_A.npz")))
+    zB = dict(np.load(os.path.join(HERE, "data", "catalog_norm_B.npz")))
+    return {"hp58": z58, "A": zA, "B": zB}, zA
+
+
+def fit_predict(q, l, y, cal, lam, method):
+    """Correction fitted on the events cal, applied to all; returns the corrected residual prediction."""
+    cols = {"level": [], "affine": [q], "level+inv": [l], "affine+inv": [q, l]}[method]
+    cols = [c for c in cols if c is not None]
+    yc = y[cal]
+    if not cols or lam == np.inf:
+        return np.full_like(y, yc.mean())
+    X = np.stack(cols, 1)
+    xm = X[cal].mean(0)
+    Xc = X[cal] - xm
+    XtX = Xc.T @ Xc
+    A = XtX + lam * np.diag(np.diag(XtX))
+    beta = np.linalg.pinv(A) @ (Xc.T @ (yc - yc.mean()))
+    return yc.mean() + (X - xm) @ beta
+
+
+def choose(order, svals, k, rng, n):
+    if svals == "random":
+        return rng.choice(n, k, replace=False)
+    if svals == "first":
+        return np.arange(k)
+    return {"smallest_s": order[:k], "largest_s": order[-k:],
+            "spread_s": order[np.round(np.linspace(0, n - 1, k)).astype(int)]}[svals]
+
+
+def main():
+    meta = {"dc_" + p["folder"]: p for p in json.load(open(os.path.join(HERE, "classes_default.json")))["processes"]}
+    twins = set(json.load(open(os.path.join(HERE, "heldout_twins.json"))))
+    models, zA = load_models()
+    probes = sorted({k.split("__")[0] for k in zA if k.endswith("__t")})
+    group = {p: ("96 relabels" if p in twins else "43 new") for p in probes}
+    linv = {}
+    for p in probes:
+        N = 2 + meta[p]["n_out"]
+        linv[p] = zA[f"{p}__logF"].astype(float) / (N - 4) if N != 4 else None
+    has_s = {p for p in probes if linv[p] is not None}
+    print(f"{len(probes)} probes, s_hat known for {len(has_s)} "
+          f"({sum(group[p] == '43 new' for p in has_s)} new, {sum(group[p] == '96 relabels' for p in has_s)} relabels)")
+
+    out = {"ks": KS, "lams": [str(x) for x in LAMS], "n_draw": NDRAW, "groups": {}, "oracle": {}, "lam_chosen": {},
+           "sampling": {}, "per_process": {}}
+    # E[model][sampling][method][k] = array (n_probe, n_lam, n_draw) of MSE on the uncalibrated events
+    E = {}
+    for mname, z in models.items():
+        E[mname] = {}
+        for samp in SAMPLINGS:
+            nd = NDRAW if samp == "random" else 1
+            E[mname][samp] = {m: {k: np.full((len(probes), len(LAMS), nd), np.nan) for k in KS} for m in METHODS}
+        E[mname]["none"] = np.full(len(probes), np.nan)
+        out["oracle"][mname] = {}
+        for i, p in enumerate(probes):
+            if f"{p}__q" not in z:
+                continue
+            t, q = z[f"{p}__t"].astype(float), z[f"{p}__q"].astype(float)
+            if not np.all(np.isfinite(q)):
+                continue
+            y, l = t - q, linv[p]
+            E[mname]["none"][i] = np.mean(y ** 2)
+            order = np.argsort(l) if l is not None else None
+            alln = np.arange(len(t))
+            for m in METHODS:   # oracle: fitted on all 2000 events, scored on them
+                r = y - fit_predict(q, l, y, alln, 0.0, m)
+                out["oracle"][mname].setdefault(m, {})[p] = float(np.mean(r ** 2))
+            for samp in SAMPLINGS:
+                if samp.endswith("_s") and l is None:
+                    continue
+                nd = NDRAW if samp == "random" else 1
+                for k in KS:
+                    for d in range(nd):
+                        rng = np.random.default_rng(1000 * k + d)
+                        cal = choose(order, samp, k, rng, len(t))
+                        rest = np.setdiff1d(alln, cal)
+                        for m in METHODS:
+                            for j, lam in enumerate(LAMS):
+                                pred = fit_predict(q, l, y, cal, lam, m)
+                                E[mname][samp][m][k][i, j, d] = np.mean((y[rest] - pred[rest]) ** 2)
+
+    def summ(vals_by_draw):
+        """vals_by_draw: (n_proc, n_draw) -> median and 90% per draw, then mean (and range) over draws."""
+        v = vals_by_draw[np.all(np.isfinite(vals_by_draw), 1)]
+        med, p90 = np.median(v, 0), np.quantile(v, 0.9, 0)
+        return dict(n=int(len(v)), median=float(med.mean()), median_range=[float(med.min()), float(med.max())],
+                    p90=float(p90.mean()), p90_range=[float(p90.min()), float(p90.max())])
+
+    def selected(mname, samp, m, k, idx):
+        """MSE (n_idx, n_draw) with lam chosen leave-one-process-out on the other processes in idx (random draws)."""
+        Er = E[mname]["random"][m][k]     # lam is chosen on random draws whatever the sampling scored
+        Es = E[mname][samp][m][k]
+        res, picks = [], []
+        for i in idx:
+            others = [o for o in idx if o != i and np.all(np.isfinite(Er[o]))]
+            score = np.median(Er[others].mean(2), 0)
+            j = int(np.nanargmin(score))
+            picks.append(LAMS[j]); res.append(Es[i, j])
+        return np.array(res), picks
+
+    for g in ("43 new", "96 relabels"):
+        idx_all = [i for i, p in enumerate(probes) if group[p] == g]
+        idx_s = [i for i in idx_all if probes[i] in has_s]
+        for mname in models:
+            ok = [i for i in idx_all if np.isfinite(E[mname]["none"][i])]
+            ok_s = [i for i in idx_s if i in ok]
+            key = f"{mname}|{g}"
+            o = out["groups"][key] = {"none": summ(E[mname]["none"][ok][:, None])}
+            out["oracle"][key] = {m: float(np.median([out["oracle"][mname][m][probes[i]] for i in ok]))
+                                  for m in METHODS}
+            out["oracle"][key + "|p90"] = {m: float(np.quantile([out["oracle"][mname][m][probes[i]] for i in ok], .9))
+                                           for m in METHODS}
+            for m in METHODS:
+                for k in KS:
+                    Er = E[mname]["random"][m][k]
+                    o[f"{m}|ols|k{k}"] = summ(Er[ok, 0])
+                    sel, picks = selected(mname, "random", m, k, ok)
+                    o[f"{m}|ridge|k{k}"] = summ(sel)
+                    vals, cnt = np.unique([str(x) for x in picks], return_counts=True)
+                    out["lam_chosen"][f"{key}|{m}|k{k}"] = dict(zip(vals.tolist(), cnt.tolist()))
+            s = out["sampling"][key] = {}
+            for samp in SAMPLINGS:
+                idx = ok_s if samp != "first" else ok_s
+                for m in METHODS:
+                    for k in KS:
+                        sel, _ = selected(mname, samp, m, k, idx)
+                        s[f"{samp}|{m}|ridge|k{k}"] = summ(sel)
+                        s[f"{samp}|{m}|ols|k{k}"] = summ(E[mname][samp][m][k][idx, 0])
+    # per process, the ridge few-shot errors at k = 10 (random, mean over draws) for later reading
+    for mname in models:
+        for m in METHODS:
+            Er = E[mname]["random"][m][10]
+            out["per_process"][f"{mname}|{m}|ols|k10"] = {
+                probes[i]: float(Er[i, 0].mean()) for i in range(len(probes)) if np.all(np.isfinite(Er[i, 0]))}
+    json.dump(out, open(os.path.join(HERE, "data", "norm_explore5.json"), "w"), indent=1)
+
+    # printed tables
+    for g in ("43 new", "96 relabels"):
+        print(f"\n== {g}: random k events (5 draws), median (90%) over processes; ridge lam chosen on the other processes")
+        print(f"{'model':5s} {'method':16s} " + " ".join(f"{'k=' + str(k):>15s}" for k in KS) + "   oracle")
+        for mname in models:
+            o = out["groups"][f"{mname}|{g}"]
+            print(f"{mname:5s} {'none':16s} {o['none']['median']:.3g} ({o['none']['p90']:.3g})")
+            for m in METHODS:
+                for fit in ("ols", "ridge"):
+                    row = " ".join(f"{o[f'{m}|{fit}|k{k}']['median']:7.3g} ({o[f'{m}|{fit}|k{k}']['p90']:5.3g})"
+                                   for k in KS)
+                    orc = out["oracle"][f"{mname}|{g}"][m] if fit == "ols" else np.nan
+                    print(f"{mname:5s} {m + ' ' + fit:16s} {row}   {orc:.3g}")
+    for g in ("43 new", "96 relabels"):
+        print(f"\n== {g}, processes with s_hat: sampling of the k events, ridge; median (90%)")
+        for mname in models:
+            s = out["sampling"][f"{mname}|{g}"]
+            for m in ("level", "affine", "affine+inv"):
+                for samp in SAMPLINGS:
+                    row = " ".join(f"{s[f'{samp}|{m}|ridge|k{k}']['median']:7.3g} ({s[f'{samp}|{m}|ridge|k{k}']['p90']:5.3g})"
+                                   for k in KS)
+                    print(f"{mname:5s} {m:11s} {samp:11s} {row}")
+    plot(out, models)
+
+
+def plot(out, models):
+    import plot_style as ps
+    import matplotlib.pyplot as plt  # noqa: F401
+    col = {"hp58": ps.C.grey, "A": ps.C.vermillion, "B": ps.C.blue}
+    ls = {"level": ":", "affine": "-", "affine+inv": "--"}
+    fig, axes = ps.figure(ncols=2, sharey=True)
+    for ax, g in zip(axes, ("43 new", "96 relabels")):
+        for mname in models:
+            o = out["groups"][f"{mname}|{g}"]
+            for m in ("level", "affine", "affine+inv"):
+                ax.plot(KS, [o[f"{m}|ridge|k{k}"]["median"] for k in KS], ls[m], color=col[mname], marker="o", ms=3,
+                        label=f"{mname}, {m}")
+        ax.set_xscale("log"); ax.set_yscale("log"); ax.set_xlabel("labelled events $k$")
+        ps.process_label(ax, g)
+    axes[0].set_ylabel(r"median MSE$(\log|\mathcal{M}|^2)$")
+    ps.shared_legend(fig, axes[0], ncol=3)
+    ps.save(fig, os.path.join(HERE, "figs", "norm_explore5_fewshot"))
+
+
+if __name__ == "__main__":
+    main()
