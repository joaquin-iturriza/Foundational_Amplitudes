+"""Does fine-tuning hurt the pretrained model where it loses to scratch at small D? (plan entry ft_harm; the user,
+2026-10-26: "if the finetuning is actively hurting the pretrained model, this needs to be understood")
+
+Every fine-tune that ends above scratch's best (a losing run), from three sources:
+  grid     the transfer grid's 8k fine-tune cells with a negative gain (data/nogain.json: twelve probes, ten
+           pretrainings, D = 10 to 10^4), each cell's best trial (the trial that sets the cell's value)
+  round1   the small-D first round (par:lowd_ft): default, linear probe then fine-tune, L2-SP, lower half frozen, each
+           at its cell's best grid HPs, 60 cells (rungs 1, 7, 9; five probes; D = 10 to 10^2.5)
+  round2   the small-D DyHPO round (par:lowd_dyhpo): each method's best of its own five-trial search, the same 60 cells
+Per run, all in MSE of log|M|^2 (val_loss_no_reg times prepd_std^2, as cells.py reports a cell):
+  S      scratch's best on the cell (the grid's search, best of eight)
+  F      the run's best validation checkpoint (its reported value)
+  start  the validation loss at step 0: for linear probe then fine-tune the frozen trunk's ridge read-out, the head it
+         starts from (tools/linear_readout.py, readout_val_mse); for the others the pretrained network as is (no head
+         reset in any arm, fine_tune.reset_output_head false), head_raw_val_mse at the cell's own D where the read-out
+         job scored it (rungs 1, 7, 9 at D <= 10^2.5), else the zero-shot MSE of tools/zero_shot_ft.py (zero_shot.json,
+         scored with the probe's D = 10^4 target statistics; the start's scale, not its exact value at small D)
+  R      the frozen read-out where it was fitted (what the start holds, linearly): rungs 1, 7, 9 at D <= 10^2.5 on the
+         five small-D probes, ee->Z gamma at 10^1.5 and 10^2 for every rung, u ubar->Zg for rungs 6, 7
+Classes of a losing run (F > S):
+  (i)   start > S and F < start: a worse start than scratch's best, improved on, never brought to scratch
+  (ii)  start <= S: the start beat scratch's best and the fine-tune ended above it (fine-tuning undid it)
+  (iii) start > S and F >= start: ended at or above its own start
+and the same with the read-out R as the start where R exists (what the pretrained trunk already carries). Within (i),
+where the best checkpoint sits (fraction of the run) and how far the curve climbs after it (last / best).
+The first round's curves are read from data/lowd_ft_curves.json, collected from the copies of its result files
+(runs/zz_lowd_curves/first_round, copied home from CC) by --collect, so they outlive the run directories.
+    python3 analysis/transfer/ft_harm.py --collect   -> data/lowd_ft_curves.json
+    .venv-driver/bin/python analysis/transfer/ft_harm.py   -> data/ft_harm.json, figs/ft_harm.{png,pdf}
+"""
+import glob, json, os, sys
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(os.path.dirname(HERE))
+DATA = os.path.join(HERE, "data")
+FIRST = os.path.join(ROOT, "runs", "zz_lowd_curves", "first_round")
+METHODS = ("default", "lpft", "l2sp", "freeze")
+LABEL = {"default": "default fine-tune", "lpft": "linear probe, then fine-tune", "l2sp": "pulled toward the start",
+         "freeze": "lower blocks frozen"}
+
+
+def collect():
+    runs = {(j["method"], j["probe"], j["rung"], j["k"]): j
+            for j in map(json.loads, open(os.path.join(DATA, "lowd_ft_runs.jsonl")))}
+    out = {}
+    for f in sorted(glob.glob(os.path.join(FIRST, "tp3_lowd_*", "r*_d*_result.json"))):
+        m, p = os.path.basename(os.path.dirname(f))[len("tp3_lowd_"):].split("_", 1)
+        r, k = (int(x[1:]) for x in os.path.basename(f)[:-len("_result.json")].split("_"))
+        d, j = json.load(open(f)), runs[(m, p, r, k)]
+        assert abs(d["val_loss"] - j["val_loss_no_reg"]) <= 1e-9 * max(1.0, j["val_loss_no_reg"]), f
+        out[f"{m}/{p}/r{r}/d{k}"] = {"method": m, "probe": p, "rung": r, "k": k, "steps": j["steps"],
+                                     "prepd_std": j["prepd_std"], "val_loss": d["val_loss"],
+                                     "test_loss": d.get("test_loss"), "best_step": d["best_step"],
+                                     "validate_every": d["validate_every"], "val_curve": d["val_curve"]}
+    assert len(out) == len(runs), (len(out), len(runs))
+    json.dump(out, open(os.path.join(DATA, "lowd_ft_curves.json"), "w"))
+    print(f"{len(out)} first-round curves -> data/lowd_ft_curves.json")
+
+
+def fam(r):
+    return "tp3_uu64fte" if r == 0 else f"tp3_r{r}fte"
+
+
+def starts():
+    """raw[(probe, rung, k)] and readout[(probe, rung, k)] at the cell's own D, zs[(probe, rung)] at D = 10^4."""
+    raw, ro = {}, {}
+    for j in map(json.loads, open(os.path.join(DATA, "lowd_ft_readout.jsonl"))):
+        n = j["sweep"][len("tp3_r"):]
+        r, rest = n.split("fte_", 1)
+        p, k = rest.rsplit("_d", 1)
+        raw[(p, int(r), int(k))] = j["head_raw_val_mse"]
+        ro[(p, int(r), int(k))] = j["readout_val_mse"]
+    za = json.load(open(os.path.join(DATA, "nogain_readout_za.json")))
+    for k, c in za.items():
+        for a, v in c["arms"].items():
+            if a.startswith("r"):
+                ro.setdefault(("ee_Za", int(a[1:-3]), int(k)), v["readout"])
+            elif a == "uufte":
+                ro.setdefault(("ee_Za", 0, int(k)), v["readout"])
+    for k, c in json.load(open(os.path.join(DATA, "nogain_readout.json"))).items():
+        for a in ("r6", "r7"):
+            if a in c:
+                ro.setdefault(("uubar_Zg", int(a[1:]), int(k)), c[a]["readout"])
+    zs = {}
+    for n, v in json.load(open(os.path.join(HERE, "zero_shot.json"))).items():
+        r = 0 if n.startswith("tp3_uu64fte_") else int(n[len("tp3_r"):].split("fte_")[0])
+        p = n.split("fte_", 1)[1].rsplit("_d", 1)[0]
+        zs[(p, r)] = v["mse_logm2"]
+    return raw, ro, zs
+
+
+def run_row(src, m, p, r, k, S, curve, std2, every, T):
+    c = np.asarray(curve, float) * std2
+    i = int(np.argmin(c))
+    return {"src": src, "method": m, "probe": p, "rung": r, "k": k, "S": S, "F": float(c[i]),
+            "first": float(c[0]), "first_step": every, "last": float(c[-1]),
+            "best_frac": (i + 1) * every / T if T else None, "climb": float(c[-1] / c[i])}
+
+
+def gather():
+    raw, ro, zs = starts()
+    rows = []
+    # the grid: every cell with a negative gain, its search's best trial
+    sys.path.insert(0, HERE)
+    from cells import S as SW  # noqa: E402
+    ng = json.load(open(os.path.join(DATA, "nogain.json")))
+    for p, d in ng.items():
+        for k, c in d["cells"].items():
+            for r, g in c["gain"].items():
+                if g is None or g >= 0:
+                    continue
+                name = f"{fam(int(r))}_{p}_d{k}"
+                tr = [t for t in SW.get(name, []) + SW.get(name + "_002", [])
