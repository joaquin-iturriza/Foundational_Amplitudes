+"""Where the hybrid's level error comes from (the preprocessing exploration, D83/D129): per probe, from the saved zero-shot
+reads of the hybrid, the emission scales and s_hat alone (data/short_reads/<arm>/<axis>/<probe>.npz; t, q in the arm's
+target, logF its per-event factor, so t - logF is log|M|^2 and agrees across arms), the mean errors m = mean(q - t) and
+    c_hand  mean(logF_hybrid - logF_shat): the constant c_p the hybrid was handed (its first 10000 train events)
+    c_val   mean(logF_qperp - logF_shat): c_p on the 2000 events predicted
+    net     mean(q_hybrid) - mean(q_qperp): the two networks' class means of the same target
+so that m_hybrid - m_qperp = net + (c_val - c_hand) exactly (asserted). At pT >= 30 GeV also the cut's shift of the
+constant, c_p of the parent at the default cuts (data/prep_level.json, train) minus c_hand, against the hybrid's m.
+    python3 analysis/catalog_v3/prep_hybrid_split.py   -> data/prep_hybrid_split.json
+"""
+import json, os
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+R = os.path.join(HERE, "data", "short_reads")
+ARMS = ("dimensionless_hybrid", "dimensionless", "dimensionless_shat")
+AXES = ("H1", "H2", "H2p5", "H3", "H6", "H7c", "H7E")
+
+
+def main():
+    cls = json.load(open(os.path.join(HERE, "data", "prep_level.json")))["classes"]
+    out = {}
+    for ax in AXES:
+        rows = {}
+        for f in sorted(os.listdir(os.path.join(R, ARMS[0], ax))):
+            z = [np.load(os.path.join(R, a, ax, f)) for a in ARMS]
+            if not all(len(x["q"]) and len(x["logF"]) for x in z):
+                continue
+            mh, mq, _ = (float(np.mean(x["q"] - x["t"])) for x in z)
+            r = {"m_hyb": mh, "m_qperp": mq, "c_hand": float(np.mean(z[0]["logF"] - z[2]["logF"])),
+                 "c_val": float(np.mean(z[1]["logF"] - z[2]["logF"])), "net": float(np.mean(z[0]["q"]) - np.mean(z[1]["q"])),
+                 "N": cls[ax][f[:-4]]["N"], "n_top": sum(abs(c) == 6 for c in cls[ax][f[:-4]]["pdg"])}
+            assert abs(mh - mq - r["net"] - (r["c_val"] - r["c_hand"])) < 1e-3
+            if ax == "H7c":
+                r["cut_shift"] = cls["train"][f[:-4].split("__")[0]]["c_p"] - r["c_hand"]
+            rows[f[:-4]] = r
+        a = {k: np.array([r[k] for r in rows.values()]) for k in ("m_hyb", "m_qperp", "c_hand", "c_val", "net")}
+        dc = a["c_val"] - a["c_hand"]
+        o = {"n": len(rows), "level_ratio": float(np.median(a["m_hyb"] ** 2 / a["m_qperp"] ** 2)),
+             "level_ratio_const_exact": float(np.median((a["m_qperp"] + a["net"]) ** 2 / a["m_qperp"] ** 2)),
+             "level_ratio_net_equal": float(np.median((a["m_qperp"] + dc) ** 2 / a["m_qperp"] ** 2)),
+             "abs_const_mismatch": float(np.median(np.abs(dc))), "abs_net": float(np.median(np.abs(a["net"]))),
+             "mean_err_hyb": float(np.median(a["m_hyb"])), "mean_err_qperp": float(np.median(a["m_qperp"]))}
+        if ax == "H3":
+            nt = np.array([r["n_top"] for r in rows.values()])
+            o["mean_err_hyb_by_tops"] = {int(k): float(np.median(a["m_hyb"][nt == k])) for k in sorted(set(nt))}
+        if ax == "H7c":
+            s = np.array([r["cut_shift"] for r in rows.values()])
+            o.update({"cut_shift": float(np.median(s)), "corr_m_shift": float(np.corrcoef(a["m_hyb"], s)[0, 1]),
+                      "slope_intercept": [float(v) for v in np.polyfit(s, a["m_hyb"], 1)],
+                      "level_default_cut_const": float(np.median((a["m_hyb"] - s) ** 2)),
+                      "level_ratio_default_cut_const": float(np.median((a["m_hyb"] - s) ** 2 / a["m_qperp"] ** 2))})
+        out[ax] = {**o, "probes": rows}
+        print(ax, json.dumps({k: (round(v, 3) if isinstance(v, float) else v) for k, v in o.items()}))
+    json.dump(out, open(os.path.join(HERE, "data", "prep_hybrid_split.json"), "w"), indent=1)
+
+
+if __name__ == "__main__":
+    main()
