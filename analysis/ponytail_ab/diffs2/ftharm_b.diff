@@ -0,0 +1,214 @@
+"""Why fine-tuning loses to scratch at small D (plan entry ft_harm): per fine-tune cell that ends above scratch's best,
+where its validation curve starts, where it reaches its minimum, and against scratch's best. Three sources, every curve
+already home (the first round's run dirs were copied from CC before the model files are deleted):
+  grid     the 8k grid's fine-tunes (each rung's best of five, analysis/transfer/scratch_sweeps.json via cells.py) in
+           the probe, D and rung cells where it loses to scratch (data/nogain.json, gain < 0), D = 10 to 10^4
+  first    the small-D first round (par:lowd_ft): four methods at each cell's grid HPs on 60 cells,
+           runs/zz_lowd_curves/first_round/tp3_lowd_<method>_<probe>/r<rung>_d<k>_result.json
+  dyhpo    the small-D DyHPO round (par:lowd_dyhpo): three methods' best of five, data/lowd_dyhpo_sweeps.json
+The start (step 0) is not validated by the training loop (the first validation is at 1% of the run). It is known from
+the read-out job (runs/zz_lowd_curves/first_round/readout, tools/linear_readout.py) for rungs 1, 7, 9 on the five
+probes of the small-D study, D = 10 to 10^2.5: no head reset in any of these runs (fine_tune.reset_output_head false),
+so a default, L2-SP or frozen-block run starts at the pretrained network as is (head_raw_val_mse) and a linear probe
+then fine-tune run at the ridge read-out (readout_val_mse, asserted equal to its head at step 0). The read-out is also
+what the frozen trunk holds under a refitted linear head. Classes of a losing cell (value v > scratch's best S):
+  (i)   bad start      the start is above S and so is the read-out: nothing in the pretrained start is at S
+  (ii)  start undone   the start is at or below S: the fine-tune moves away from a start better than scratch
+  (iii) other          the start is above S but the read-out is at or below S: the trunk holds it, the run (which keeps
+                       the pretrained head) does not find it
+  unknown              no read-out for the cell (grid cells outside rungs 1, 7, 9 or the five probes, or D > 10^2.5)
+For every losing cell also the curve's shape: where the minimum sits (fraction of the run) and the last validation over
+the minimum (a curve that climbs after its best).
+    python3 analysis/transfer/ft_harm.py   -> data/ft_harm.json, figs/ft_harm.{png,pdf}; the last line the claims object
+"""
+import glob, json, os, sys
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(os.path.dirname(HERE))
+sys.path.insert(0, HERE)
+sys.path.insert(0, ROOT)
+from cells import best  # noqa: E402
+from rung_grid import fam  # noqa: E402
+
+CURVES = os.path.join(ROOT, "runs", "zz_lowd_curves", "first_round")
+CLASSES = ("bad_start", "start_undone", "other", "unknown")
+
+
+def readouts():
+    """(probe, rung, k) -> the read-out job's line (readout_val_mse, head_raw_val_mse, MSE of log|M|^2)."""
+    out = {}
+    for f in glob.glob(os.path.join(CURVES, "readout", "tp3_r*fte_*_d*.json")):
+        r = json.load(open(f))
+        s = r["sweep"][len("tp3_r"):]
+        rung, rest = s.split("fte_", 1)
+        probe, k = rest.rsplit("_d", 1)
+        out[(probe, int(rung), int(k))] = r
+    return out
+
+
+def row(src, method, probe, rung, k, S, curve, std, T, ro):
+    c = np.asarray(curve) * std ** 2
+    i = int(np.argmin(c))
+    start = None
+    if ro:
+        start = ro["readout_val_mse"] if method == "lpft" else ro["head_raw_val_mse"]
+    v = float(c[i])
+    if v <= S:
+        cls = None
+    elif not ro:
+        cls = "unknown"
+    elif start <= S:
+        cls = "start_undone"
+    elif ro["readout_val_mse"] <= S:
+        cls = "other"
+    else:
+        cls = "bad_start"
+    return {"src": src, "method": method, "probe": probe, "rung": rung, "k": k, "scratch": S, "value": v,
+            "first": float(c[0]), "start": start, "readout": ro["readout_val_mse"] if ro else None,
+            "best_frac": (i + 1) / len(c), "climb": float(c[-1] / v), "T": T, "class": cls, "losing": cls is not None}
+
+
+def main():
+    RO = readouts()
+    spec = json.load(open(os.path.join(HERE, "data", "lowd_ft_spec.json")))
+    rows, n_cells = [], {"grid": 0, "first": 0, "dyhpo": 0}
+    # the grid: every rung's best fine-tune in a cell where it loses (nogain.json's gain, the same cells.best value)
+    ng = json.load(open(os.path.join(HERE, "data", "nogain.json")))
+    for p, d in ng.items():
+        for k, cell in d["cells"].items():
+            for r, g in cell["gain"].items():
+                if g is None:
+                    continue
+                n_cells["grid"] += 1
+                v, t = best(f"{fam(int(r))}_{p}_d{k}")
+                x = row("grid", "default", p, int(r), int(k), cell["scratch"], t["val_curve"], t["prepd_std"], t["T"],
+                        RO.get((p, int(r), int(k))))
+                assert abs(x["value"] / v - 1) < 1e-9 and x["losing"] == (g < 0), (p, k, r)
+                rows.append(x)
+    # the first round: each method's run at the cell's grid HPs
+    std = {(j["probe"], j["rung"], j["k"]): j["prepd_std"]
+           for j in map(json.loads, open(os.path.join(HERE, "data", "lowd_ft_runs.jsonl"))) if "prepd_std" in j}
+    for c in spec:
+        key = (c["probe"], c["rung"], c["k"])
+        for m in ("default", "lpft", "l2sp", "freeze"):
+            f = os.path.join(CURVES, f"tp3_lowd_{m}_{c['probe']}", f"r{c['rung']}_d{c['k']}_result.json")
+            res = json.load(open(f))
+            n_cells["first"] += 1
+            x = row("first", m, *key, c["scratch"], res["val_curve"], std[key], c["steps"], RO.get(key))
+            rows.append(x)
+    # the DyHPO round: each method's best of its five trials
+    SW = json.load(open(os.path.join(HERE, "data", "lowd_dyhpo_sweeps.json")))
+    for c in spec:
+        key = (c["probe"], c["rung"], c["k"])
+        for m in ("lpft", "l2sp", "freeze"):
+            tr = [t for t in SW.get(f"tp3_lowd_{m}_r{c['rung']}_{c['probe']}_d{c['k']}", [])
+                  if t.get("val_loss") is not None and t.get("prepd_std") and t.get("val_curve")]
+            if not tr:
+                continue
+            n_cells["dyhpo"] += 1
+            t = min(tr, key=lambda t: t["val_loss"] * t["prepd_std"] ** 2)
+            x = row("dyhpo", m, *key, c["scratch"], t["val_curve"], t["prepd_std"], t["T"], RO.get(key))
+            rows.append(x)
+    allrows, rows = rows, [r for r in rows if r["losing"]]
+
+    summ = {}
+    for src in ("grid", "first", "dyhpo"):
+        rs = [r for r in rows if r["src"] == src]
+        s = {"cells": n_cells[src], "losing": len(rs), **{c: sum(r["class"] == c for r in rs) for c in CLASSES}}
+        kn = [r for r in rs if r["class"] != "unknown"]
+        if kn:
+            # how far the start is from scratch and from the run's own best, in decades
+            s["start_over_scratch"] = float(np.median([np.log10(r["start"] / r["scratch"]) for r in kn]))
+            s["value_over_scratch"] = float(np.median([np.log10(r["value"] / r["scratch"]) for r in kn]))
+        s["value_over_scratch_all"] = float(np.median([np.log10(r["value"] / r["scratch"]) for r in rs]))
+        s["best_frac"] = float(np.median([r["best_frac"] for r in rs]))
+        s["late_best"] = sum(r["best_frac"] >= 0.9 for r in rs)
+        s["climbs2"] = sum(r["climb"] >= 2 for r in rs)
+        summ[src] = s
+    # per method on the small-D rounds: the class counts (lpft is the only method that can start below scratch)
+    by_method = {f"{src}.{m}": {c: sum(r["class"] == c for r in rows if r["src"] == src and r["method"] == m)
+                                for c in CLASSES}
+                 for src in ("first", "dyhpo") for m in ("default", "lpft", "l2sp", "freeze")
+                 if any(r["src"] == src and r["method"] == m for r in rows)}
+    # the start-undone cells: how much of the start is lost by the first validation and at the best
+    und = [r for r in rows if r["class"] == "start_undone"]
+    undone = {"n": len(und),
+              "first_over_start": float(np.median([r["first"] / r["start"] for r in und])) if und else None,
+              "value_over_start": float(np.median([r["value"] / r["start"] for r in und])) if und else None,
+              "cells": sorted({f"{r['probe']}/r{r['rung']}/d{r['k']}" for r in und})}
+    # the trunk holds it (read-out at or below scratch) but no run of the cell gets there
+    held = sorted({f"{r['probe']}/r{r['rung']}/d{r['k']}" for r in rows if r["class"] in ("other", "start_undone")})
+    # every losing run that starts at the pretrained network as is, and every losing linear-probe run: how far above
+    # scratch its start sits, and how far above scratch the frozen trunk's read-out sits (medians, decades)
+    lg = lambda xs: float(np.median(xs)) if xs else None
+    kn = [r for r in rows if r["start"] is not None]
+    starts = {"raw_over_scratch": lg([np.log10(r["start"] / r["scratch"]) for r in kn if r["method"] != "lpft"]),
+              "lpft_over_scratch": lg([np.log10(r["start"] / r["scratch"]) for r in kn if r["method"] == "lpft"]),
+              "readout_over_scratch": lg([np.log10(r["readout"] / r["scratch"]) for r in kn]),
+              "readout_above_scratch": sum(r["readout"] > r["scratch"] for r in kn), "n": len(kn)}
+    # every run of the 60 small-D cells (the grid's rungs 1, 7, 9 there included), losing or not: against what its
+    # frozen trunk gives with a refitted linear head. A fine-tune above its read-out ends worse than the pretrained
+    # model under a head refit: the case where fine-tuning harms what the start holds
+    sm = [r for r in allrows if r["readout"] is not None]
+    against = {}
+    for src in ("grid", "first", "dyhpo"):
+        rs = [r for r in sm if r["src"] == src]
+        against[src] = {"n": len(rs), "above_readout": sum(r["value"] > r["readout"] for r in rs),
+                        "median_over_readout": lg([np.log10(r["value"] / r["readout"]) for r in rs]),
+                        "probes_above": {p: sum(r["value"] > r["readout"] for r in rs if r["probe"] == p)
+                                         for p in sorted({r["probe"] for r in rs})},
+                        # losing exactly where the read-out is above scratch: the 2x2 table of the two signs
+                        "lose_ro_above": sum(r["losing"] and r["readout"] > r["scratch"] for r in rs),
+                        "lose_ro_below": sum(r["losing"] and r["readout"] <= r["scratch"] for r in rs),
+                        "win_ro_above": sum(not r["losing"] and r["readout"] > r["scratch"] for r in rs),
+                        "win_ro_below": sum(not r["losing"] and r["readout"] <= r["scratch"] for r in rs)}
+    out = {"summary": summ, "by_method": by_method, "undone": undone, "held_cells": held, "n_held_cells": len(held),
+           "starts": starts, "against_readout": against, "rows": rows}
+    json.dump(out, open(os.path.join(HERE, "data", "ft_harm.json"), "w"), indent=1)
+    for src, s in summ.items():
+        print(src, json.dumps(s))
+    for k_, v in by_method.items():
+        print(k_, json.dumps(v))
+    print("undone", json.dumps(undone))
+    print("starts", json.dumps(starts))
+    for k_, v in against.items():
+        print("against read-out", k_, json.dumps(v))
+    plot(rows, sm)
+    print(json.dumps({k: v for k, v in out.items() if k != "rows"}))
+
+
+def plot(rows, sm):
+    import plot_style as ps
+    fig, (a, b) = ps.figure(ncols=2)
+    srcl = {"grid": ("8k grid", ps.C.blue, "o"), "first": ("small D, grid HPs", ps.C.orange, "s"),
+            "dyhpo": ("small D, own search", ps.C.purple, "^")}
+    # (a) every run of the 60 small-D cells: the frozen trunk's read-out and the fine-tune, both over scratch's best
+    for src, (l, cc, mk) in srcl.items():
+        rs = [r for r in sm if r["src"] == src]
+        a.scatter([np.log10(r["readout"] / r["scratch"]) for r in rs], [np.log10(r["value"] / r["scratch"]) for r in rs],
+                  color=cc, marker=mk, s=12, label=l)
+    lo, hi = a.get_xlim()
+    a.plot([lo, hi], [lo, hi], ls="--", color=ps.C.grey, label="fine-tune = read-out")
+    a.axhline(0, ls=":", color=ps.C.green, label="fine-tune = scratch")
+    a.set_xlim(lo, hi)
+    a.set_xlabel(r"$\log_{10}(L_{\rm read\text{-}out}/L_{\rm scratch})$")
+    a.set_ylabel(r"$\log_{10}(L_{\rm fine\text{-}tune}/L_{\rm scratch})$")
+    ps.legend(a, "upper left", ncol=2)  # five entries in one column hit make_room's growth cap
+    ps.make_room(a)
+    # (b) where each losing run's minimum sits (any start), and how far its last validation climbs from it
+    srcl = {"grid": ("8k grid", ps.C.blue, "o"), "first": ("small D, grid HPs", ps.C.orange, "s"),
+            "dyhpo": ("small D, own search", ps.C.purple, "^")}
+    for src, (l, cc, mk) in srcl.items():
+        rs = [r for r in rows if r["src"] == src]
+        b.scatter([r["best_frac"] for r in rs], [np.log10(r["climb"]) for r in rs], color=cc, marker=mk, s=12, label=l)
+    b.set_xlabel("best checkpoint / run length")
+    b.set_ylabel(r"$\log_{10}(L_{\rm last}/L_{\rm best})$")
+    b.set_ylim(bottom=-0.05)
+    ps.make_room(b)
+    ps.save(fig, os.path.join(HERE, "figs", "ft_harm"))
+
+
+if __name__ == "__main__":
+    main()
