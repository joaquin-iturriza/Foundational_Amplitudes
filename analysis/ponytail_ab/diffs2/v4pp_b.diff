+++ b/analysis/catalog_v4/compare_pp_trained.py
@@ -0,0 +1,207 @@
+"""catalog_v4 against training on pp, on the 13 TeV pp pools (catalog_coverage; the user, 2026-10-26: what mattered most
+was how training on catalog_v4 compares to training on pp collisions on data generated like pp collisions; D117, D119).
+No new compute: the reads already home.
+  catalog_v4     v4_dimensionless_muon, _seed2: the dimensionless arm on catalog_v4, Muon at its search's best, 4264
+                 steps (reads: analysis/catalog_v3/data/short_reads/<run>/PP, analysis/catalog_v4/compare_v3.py)
+  catalog_v3     dimensionless_muon_best, _seed2: the same on catalog_v3's windows (Muon's window-trained reference)
+  pp-trained     dimensionless_pp (FA-ccin2p3-e786bd74, its read completed by 982b5a14): the dimensionless arm with
+                 every hadronic training tree class of catalog_v3 trained on its 13 TeV pp events, AdamW at the
+                 per-process sweep's best (lr 8.94e-3), one seed (rows: analysis/catalog_v3/data/pp_rows.json)
+  AdamW window   dimensionless: the arm the pp-trained one differs from only in how the hadronic classes are sampled
+                 (AdamW's window-trained reference), one seed
+Checks first: every run read the same 2000 events of each pp pool and split them by the same definition of catalog_v3's
+coverage (pp_compare.support_masks, the sqrt(s_hat) window and catalog_v3's fiducial cuts in the partonic frame): the
+share of a probe's events inside, from the site's mask of the catalog_v4 comparison, against the share each AdamW arm's
+collect recorded, and the variance of the target over the events, the Muon runs' saved reads against the AdamW rows.
+Groups, b classes apart (the pp pools carry catalog_v3's 4.7 GeV b, which catalog_v4 never saw): classes trained in both
+catalogs (the pp-trained arm trained them on pp events, catalog_v4 on its own pools), held out in both (zero-shot for
+every run), and the classes catalog_v3 trains and catalog_v4 holds out. Measures per class: the MSE of log|M|^2 on the
+whole pp pool and on its events inside and outside catalog_v3's coverage.
+  (a) direct     per class catalog_v4 (the geometric mean of its two seeds) over the pp-trained arm: the median ratio,
+                 the shares where both catalog_v4 seeds are lower and where both are higher, the gap (median
+                 |log10 ratio|) against catalog_v4's seed spread; the optimizers differ (Muon against AdamW)
+  (b) relative   each against its own optimizer's window-trained catalog_v3 arm: r_v4 = catalog_v4 / catalog_v3 (Muon),
+                 r_pp = pp-trained / AdamW window; the share of the pp-training gain catalog_v4 recovers,
+                 log median r_v4 / log median r_pp, and per class r_v4 / r_pp (above 1: catalog_v4 recovers less than
+                 the pp-trained arm gained). This assumes the optimizer moves a pp-trained run by the same factor as a
+                 window-trained one, which nothing measures
+  optimizer      catalog_v3 Muon over AdamW window on pp, per class: what Muon alone changes on these pools
+    python3 analysis/catalog_v4/compare_pp_trained.py   -> data/compare_pp_trained.json, figs/compare_pp_trained_{a..d}
+The last line printed is the JSON of the numbers docs/results.tex quotes.
+"""
+import json, os, sys
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(os.path.dirname(HERE))
+sys.path.insert(0, ROOT)
+sys.path.insert(0, HERE)
+import compare_v3 as cv  # noqa: E402
+
+SR = cv.SR
+MUON = {"v3": cv.RUNS["v3"], "v4": cv.RUNS["v4"]}
+KEYS = ("mse", "mse_inside", "mse_outside")
+KNAME = {"mse": "whole pool", "mse_inside": "inside", "mse_outside": "outside"}
+GROUPS = {"train": ("train", "train"), "heldout": ("heldout", "heldout"), "role_changed": ("train", "heldout")}
+
+
+def checks(site, rows_adamw):
+    """the same events and the same coverage split for every run: the inside share per probe (site mask against each
+    AdamW arm's collect) and the target's variance (each Muon run's saved read against the AdamW rows of the same
+    target, the dimensionless arm's)"""
+    fd, nmiss = [], 0
+    for n, s in site["pp"].items():
+        f = s["inside"].count("1") / len(s["inside"])
+        for a in rows_adamw:
+            r = rows_adamw[a]["pp"].get(n)
+            if r is None or "frac_inside" not in r or r["n"] != len(s["inside"]):
+                nmiss += 1
+                continue
+            fd.append(abs(r["frac_inside"] - f))
+    vd = {}
+    for c in MUON:
+        for run in MUON[c]:
+            x = []
+            for n in site["pp"]:
+                t = np.load(os.path.join(SR, run, "PP", n + ".npz"))["t"].astype(float)
+                v = rows_adamw["dimensionless_pp"]["pp"][n]["var_t"]
+                x.append(abs(np.var(t) - v) / v)
+            vd[run] = {"median": float(np.median(x)), "max": float(np.max(x)), "n_above_1e-3": int(np.sum(np.array(x) > 1e-3))}
+    return {"n_probes": len(site["pp"]), "frac_inside_max_diff": float(max(fd)), "frac_inside_compared": len(fd),
+            "frac_inside_unmatched": nmiss, "var_t_rel_diff": vd}
+
+
+def stats(num, den, probes):
+    """per class num/den over `probes`: median ratio, 10%/90%, share below 1, gap (median |log10|)"""
+    r = np.array([num[p] / den[p] for p in probes])
+    return {"n": len(probes), "ratio": float(np.median(r)), "ratio_q10_q90": [float(x) for x in np.quantile(r, [0.1, 0.9])],
+            "lower_pct": float(100 * np.mean(r < 1)), "gap": float(np.median(np.abs(np.log10(r))))}
+
+
+def main():
+    site = json.load(open(os.path.join(HERE, "data", "compare_v3_site.json")))
+    ra = json.load(open(os.path.join(ROOT, "analysis", "catalog_v3", "data", "pp_rows.json")))
+    chk = checks(site, ra)
+    assert chk["frac_inside_unmatched"] == 0 and chk["frac_inside_max_diff"] == 0.0, chk
+    assert all(v["n_above_1e-3"] == 0 for v in chk["var_t_rel_diff"].values()), chk
+    R = cv.pp_reads(site)
+    names, role, rows = R["names"], R["role"], R["rows"]
+    assert not any(R["bad"].values()), R["bad"]
+    b = {n: cv.has_b(n) for n in names}
+    for arm in ("dimensionless_pp", "dimensionless"):           # AdamW rows, the same three measures
+        for k in KEYS:
+            rows[k][arm] = {n: v[k] for n, v in ra[arm]["pp"].items() if v.get(k) is not None}
+    gm = lambda k, c, n: float(np.sqrt(rows[k][MUON[c][0]][n] * rows[k][MUON[c][1]][n]))
+    out = {"checks": chk, "groups": {}}
+    for bk, bsel in (("no_b", lambda n: not b[n]), ("b", lambda n: b[n])):
+        for g, (r3, r4) in GROUPS.items():
+            pr = [n for n in names if bsel(n) and role[n]["v3"] == r3 and role[n]["v4"] == r4]
+            if not pr:
+                continue
+            e = out["groups"].setdefault(bk, {}).setdefault(g, {"n": len(pr)})
+            for k in KEYS:
+                ps_ = [n for n in pr if all(n in rows[k][r] for r in MUON["v3"] + MUON["v4"] + ("dimensionless_pp", "dimensionless"))]
+                v4 = {n: gm(k, "v4", n) for n in ps_}
+                v3 = {n: gm(k, "v3", n) for n in ps_}
+                pt, aw = rows[k]["dimensionless_pp"], rows[k]["dimensionless"]
+                d = stats(v4, pt, ps_)
+                both_lo = np.mean([all(rows[k][r][n] < pt[n] for r in MUON["v4"]) for n in ps_])
+                both_hi = np.mean([all(rows[k][r][n] > pt[n] for r in MUON["v4"]) for n in ps_])
+                d.update({"v4_lower_both_pct": float(100 * both_lo), "v4_higher_both_pct": float(100 * both_hi),
+                          "spread_v4": float(np.median([abs(np.log10(rows[k][MUON["v4"][1]][n] / rows[k][MUON["v4"][0]][n])) for n in ps_])),
+                          "spread_v3": float(np.median([abs(np.log10(rows[k][MUON["v3"][1]][n] / rows[k][MUON["v3"][0]][n])) for n in ps_]))})
+                rv4, rpp = stats(v4, v3, ps_), stats(pt, aw, ps_)
+                rel = {n: (v4[n] / v3[n]) / (pt[n] / aw[n]) for n in ps_}
+                rr = stats(rel, {n: 1.0 for n in ps_}, ps_)
+                rec = (float(np.log10(rv4["ratio"]) / np.log10(rpp["ratio"]))
+                       if abs(np.log10(rpp["ratio"])) > 0.05 else None)      # no gain to recover below ~12%
+                e[k] = {"n": len(ps_),
+                        "median": {"pp_trained": float(np.median([pt[n] for n in ps_])),
+                                   "adamw_window": float(np.median([aw[n] for n in ps_])),
+                                   "v4": [float(np.median([rows[k][r][n] for n in ps_])) for r in MUON["v4"]],
+                                   "v3_muon": [float(np.median([rows[k][r][n] for n in ps_])) for r in MUON["v3"]]},
+                        "direct": d, "r_v4": rv4, "r_pp": rpp, "relative": rr, "recovered": rec,
+                        "optimizer": stats(v3, aw, ps_)}
+    json.dump(out, open(os.path.join(HERE, "data", "compare_pp_trained.json"), "w"), indent=1)
+    plot(out)
+    print("checks", json.dumps(chk))
+    for bk, G in out["groups"].items():
+        for g, e in G.items():
+            for k in KEYS:
+                x = e[k]
+                print(f"{bk:4s} {g:12s} {KNAME[k]:10s} n={x['n']:3d} medians pp-trained {x['median']['pp_trained']:.3g} "
+                      f"v4 {x['median']['v4'][0]:.3g}/{x['median']['v4'][1]:.3g} v3 Muon {x['median']['v3_muon'][0]:.3g}/"
+                      f"{x['median']['v3_muon'][1]:.3g} AdamW window {x['median']['adamw_window']:.3g} | direct v4/pp "
+                      f"{x['direct']['ratio']:.3g} [{x['direct']['ratio_q10_q90'][0]:.2g},{x['direct']['ratio_q10_q90'][1]:.2g}] "
+                      f"v4 lower both {x['direct']['v4_lower_both_pct']:.0f}% higher both {x['direct']['v4_higher_both_pct']:.0f}% "
+                      f"gap {x['direct']['gap']:.2f} spread v4 {x['direct']['spread_v4']:.2f} | r_v4 {x['r_v4']['ratio']:.3g} "
+                      f"r_pp {x['r_pp']['ratio']:.3g} recovered {x['recovered'] if x['recovered'] is None else round(x['recovered'], 2)} "
+                      f"rel {x['relative']['ratio']:.3g} ({x['relative']['lower_pct']:.0f}% below 1) | Muon/AdamW window "
+                      f"{x['optimizer']['ratio']:.3g}")
+    claims = {"n_probes": chk["n_probes"], "frac_inside_max_diff": chk["frac_inside_max_diff"],
+              "var_t_rel_diff_max": max(v["max"] for v in chk["var_t_rel_diff"].values())}
+    r2 = lambda v: None if v is None else float(f"{v:.4g}")
+    for bk, G in out["groups"].items():
+        for g, e in G.items():
+            c = claims.setdefault(bk, {}).setdefault(g, {"n": e["n"]})
+            for k in KEYS:
+                x = e[k]
+                c[k] = {"n": x["n"], "pp_trained": r2(x["median"]["pp_trained"]),
+                        "v4_lo": r2(min(x["median"]["v4"])), "v4_hi": r2(max(x["median"]["v4"])),
+                        "direct": r2(x["direct"]["ratio"]), "v4_lower_both_pct": round(x["direct"]["v4_lower_both_pct"]),
+                        "v4_higher_both_pct": round(x["direct"]["v4_higher_both_pct"]), "gap": r2(x["direct"]["gap"]),
+                        "spread_v4": r2(x["direct"]["spread_v4"]), "r_v4": r2(x["r_v4"]["ratio"]),
+                        "r_pp": r2(x["r_pp"]["ratio"]), "recovered": r2(x["recovered"]),
+                        "relative": r2(x["relative"]["ratio"]),
+                        "relative_below1_pct": round(x["relative"]["lower_pct"]), "optimizer": r2(x["optimizer"]["ratio"])}
+    print(json.dumps(claims))
+
+
+def plot(out):
+    """(a, b) per measure, each run's median MSE over the classes trained in both and held out in both (no b);
+    (c, d) the per-class median ratios: catalog_v4 over the pp-trained arm (direct), catalog_v4 over catalog_v3 with
+    Muon, the pp-trained arm over the AdamW window arm"""
+    import plot_style as ps
+    figs = ps.panels(4)
+    G = out["groups"]["no_b"]
+    x = np.arange(len(KEYS))
+    for (fig, ax), g, lab in zip(figs[:2], ("train", "heldout"), ("trained in both", "held out in both")):
+        e = G[g]
+        ser = [("pp-trained, AdamW", ps.C.green, "D", lambda k: [e[k]["median"]["pp_trained"]]),
+               ("catalog v3, AdamW", ps.C.grey, "v", lambda k: [e[k]["median"]["adamw_window"]]),
+               ("catalog v3, Muon", ps.C.blue, "o", lambda k: e[k]["median"]["v3_muon"]),
+               ("catalog v4, Muon", ps.C.vermillion, "s", lambda k: e[k]["median"]["v4"])]
+        for j, (name, col, mk, f) in enumerate(ser):
+            for s_, k in enumerate(KEYS):
+                for i, y in enumerate(f(k)):
+                    ax.plot(x[s_] + (j - 1.5) * 0.16, y, mk, color=col, mfc=col if i == 0 else "none",
+                            label=name if (s_ == 0 and i == 0) else None)
+        ax.set_xticks(x)
+        ax.set_xticklabels([KNAME[k] for k in KEYS])
+        ax.set_yscale("log")
+        ax.set_ylim(0.1, 100)                            # one range for both panels, room for the legend
+        ax.set_ylabel("median MSE, 13 TeV pp")
+        ax.set_xlabel(f"classes {lab}")
+    ps.legend(figs[0][1], "upper left")
+    ps.make_room(figs[0][1])
+    for (fig, ax), g, lab in zip(figs[2:], ("train", "heldout"), ("trained in both", "held out in both")):
+        e = G[g]
+        for j, (key, name, col) in enumerate([("direct", "v4 / pp-trained", ps.C.vermillion),
+                                              ("r_v4", "v4 / v3 (Muon)", ps.C.blue),
+                                              ("r_pp", "pp-trained / v3 (AdamW)", ps.C.green)]):
+            ax.bar(x + (j - 1) * 0.27, [e[k][key]["ratio"] for k in KEYS], 0.27, color=col, label=name)
+        ax.axhline(1, ls="--", color="k")
+        ax.set_xticks(x)
+        ax.set_xticklabels([KNAME[k] for k in KEYS])
+        ax.set_yscale("log")
+        ax.set_ylim(0.05, 20)                            # one range for both panels, room for the legend
+        ax.set_ylabel("median per-class MSE ratio")
+        ax.set_xlabel(f"classes {lab}")
+    ps.legend(figs[2][1], "upper left")
+    ps.make_room(figs[2][1])
+    ps.save_panels(figs, os.path.join(HERE, "figs", "compare_pp_trained"))
+
+
+if __name__ == "__main__":
+    main()
