@@ -0,0 +1,176 @@
+"""catalog_v4 against training on pp, on the 13 TeV pp pools (catalog_coverage; the user, 2026-10-26: what mattered most
+was catalog_v4 against training on pp collisions on the data generated like pp collisions). No new compute: the reads
+of analysis/catalog_v4/compare_v3.py (catalog_v3 and catalog_v4, the dimensionless arm with Muon, seeds 42 and 43) and
+of analysis/catalog_v3/pp_compare.py (data/pp_rows.json: the pp-trained arm dimensionless_pp, FA-ccin2p3-e786bd74 and
+its rerun 982b5a14, and the window-trained dimensionless arm it differs from only in how the hadronic classes are
+sampled, FA-ccin2p3-1c960b22; both AdamW, one seed). Same pp events in both reads: the per-probe share inside
+catalog_v3's coverage is identical in the two collects on every probe, and each probe's target variance agrees (checked
+below, asserted). The pp pools carry catalog_v3's |M|^2 functions (MadGraph's minimal QED order, b at 4.7 GeV), which
+catalog_v4's are only where its full coupling orders add no diagram: a class whose catalog_v4 entry (its class's
+representative, data/class_changes.json) has a single amplitude QCD order in its diagrams
+(data/mixed_order_audit.json, tools/mixed_order_audit.py) has the minimal-order diagrams only ("same"); a mixed one
+("ew") is a different function there, and catalog_v4 is scored on a function it never trained. Per group (the class's
+roles in both catalogs, compare_v3.PP_GROUPS; no_b = no_b_same + no_b_ew; b classes apart) and measure (whole pool,
+inside and outside catalog_v3's coverage), on the classes every run has:
+  direct     catalog_v4 (seed-geometric mean) over the pp-trained arm, per class; median, share of classes lower with
+             catalog_v4 in both seeds and lower with the pp-trained arm than both; the gap (median |log10 ratio|) against
+             the Muon runs' seed spreads (the pp-trained arm has one seed). Optimizers differ: Muon against AdamW.
+  relative   each against its own optimizer's window-trained catalog_v3 arm: catalog_v4 / catalog_v3 (Muon) and
+             pp-trained / window-trained (AdamW); recovered = log(median of the first) / log(median of the second),
+             the share of the pp-trained arm's gain over catalog_v3's windows that catalog_v4 recovers (only where the
+             pp-trained arm gains); and the optimizer's own factor on pp, catalog_v3 Muon over catalog_v3 AdamW.
+    python3 analysis/catalog_v4/compare_pp_trained.py   -> data/compare_pp_trained.json, figs/compare_pp_trained.{png,pdf}
+The last line printed is the JSON of the numbers docs/results.tex quotes.
+"""
+import json, os, sys
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(os.path.dirname(HERE))
+sys.path.insert(0, HERE)
+import compare_v3 as c3
+
+MEAS = ("mse", "mse_inside", "mse_outside")
+ADAMW = {"pp": "dimensionless_pp", "win": "dimensionless"}
+
+
+def same_events(site, R):
+    """the two collects saw the same events and split them the same way"""
+    fd = max(abs(R[a]["pp"][p]["frac_inside"] - s["inside"].count("1") / len(s["inside"]))
+             for p, s in site["pp"].items() for a in ADAMW.values())
+    vd = max(abs(np.var(np.load(os.path.join(c3.SR, r, "PP", p + ".npz"))["t"].astype(float)) /
+                 R[ADAMW["pp"]]["pp"][p]["var_t"] - 1) for p in site["pp"] for r in (c3.RUNS["v3"][0], c3.RUNS["v4"][0]))
+    assert fd == 0 and vd < 1e-3, (fd, vd)
+    return {"max_frac_inside_diff": fd, "max_rel_var_t_diff": vd}
+
+
+def ew_added(names):
+    """pp13_<x> -> True where catalog_v4's |M|^2 of the class has more than the minimal-order diagrams (mixed), None
+    where catalog_v4 has no entry for it (the b-Higgs classes it dropped)"""
+    E = json.load(open(os.path.join(HERE, "data", "mixed_order_audit.json")))["entries"]
+    cc = json.load(open(os.path.join(HERE, "data", "class_changes.json")))
+    rep = {}
+    for g in cc["merges"]:
+        for x in g["members"]:
+            rep.setdefault(x, g["v4_class"])
+    for sp in cc["splits"]:
+        for k, v in sp["v4_classes"].items():
+            for x in v["members"]:
+                rep.setdefault(x, k)
+    out = {}
+    for n in names:
+        x = "v4_" + n[len("pp13_"):]
+        y = x if x in E else rep.get(x)
+        out[n] = E[y]["mixed"] if y in E else None
+    return out
+
+
+def lmed(x):
+    return float(10 ** np.median(np.log10(x)))
+
+
+def spread(a, b):
+    return float(np.median(np.abs(np.log10(b / a))))
+
+
+def compare(rows, probes):
+    v = lambda r: np.array([rows[r][p] for p in probes])
+    ps_ = [p for p in probes if all(p in rows[r] for r in rows)]
+    if not ps_:
+        return None
+    probes = ps_
+    v3, v4 = [v(r) for r in c3.RUNS["v3"]], [v(r) for r in c3.RUNS["v4"]]
+    pp, win = v(ADAMW["pp"]), v(ADAMW["win"])
+    g3, g4 = np.sqrt(v3[0] * v3[1]), np.sqrt(v4[0] * v4[1])
+    e = {"n": len(probes), "med": {"pp_trained": float(np.median(pp)), "v3_adamw": float(np.median(win)),
+                                   "v3_muon": [float(np.median(x)) for x in v3], "v4_muon": [float(np.median(x)) for x in v4]}}
+    d = g4 / pp
+    e["direct"] = {"ratio": lmed(d), "q10_q90": [float(x) for x in np.quantile(d, [0.1, 0.9])],
+                   "v4_lower_both_pct": float(100 * np.mean((v4[0] < pp) & (v4[1] < pp))),
+                   "pp_lower_both_pct": float(100 * np.mean((pp < v4[0]) & (pp < v4[1]))),
+                   "gap": float(np.median(np.abs(np.log10(d)))),
+                   "spread_v4": spread(*v4), "spread_v3": spread(*v3)}
+    e["direct"]["exceeds_seed_spread"] = bool(e["direct"]["gap"] > max(e["direct"]["spread_v4"], e["direct"]["spread_v3"]))
+    r4, rpp, mu = lmed(g4 / g3), lmed(pp / win), lmed(g3 / win)
+    e["relative"] = {"v4_over_v3_muon": r4, "pp_over_v3_adamw": rpp, "muon_over_adamw_v3": mu,
+                     "recovered": float(np.log10(r4) / np.log10(rpp)) if rpp < 1 else None}
+    return e
+
+
+def main():
+    site = json.load(open(os.path.join(HERE, "data", "compare_v3_site.json")))
+    R = json.load(open(os.path.join(ROOT, "analysis", "catalog_v3", "data", "pp_rows.json")))
+    chk = same_events(site, R)
+    p = c3.pp(site)
+    rows = {k: dict(p["_rows"][k]) for k in MEAS}
+    for k in MEAS:
+        for a in ADAMW.values():
+            rows[k][a] = {n: x[k] for n, x in R[a]["pp"].items() if x.get(k) is not None}
+    role, b = p["_role"], p["_b"]
+    ew = ew_added(role)
+    out = {"check": chk}
+    for bk, bsel in (("no_b", lambda n: not b[n]), ("no_b_same", lambda n: not b[n] and ew[n] is False),
+                     ("no_b_ew", lambda n: not b[n] and ew[n] is True), ("b", lambda n: b[n])):
+        for g, gsel in c3.PP_GROUPS.items():
+            pr = [n for n in role if bsel(n) and gsel(role[n])]
+            if not pr:
+                continue
+            e = out.setdefault(bk, {}).setdefault(g, {k: compare(rows[k], pr) for k in MEAS})
+            if g == "heldout":
+                for a in ("H1", "H2", "H3"):
+                    pa = [n for n in pr if role[n]["axis3"] == a]
+                    if pa:
+                        e[a] = compare(rows["mse"], pa)
+    json.dump(out, open(os.path.join(HERE, "data", "compare_pp_trained.json"), "w"), indent=1)
+    plot(out)
+    print("same events", chk)
+    claims = {}
+    for bk in ("no_b", "no_b_same", "no_b_ew", "b"):
+        for g, e in out[bk].items():
+            for k, v in e.items():
+                if not v:
+                    continue
+                print(f"{bk:4s} {g:13s} {k:11s} n={v['n']:4d} pp {v['med']['pp_trained']:.3g} v3adamw {v['med']['v3_adamw']:.3g} "
+                      f"v3muon {v['med']['v3_muon'][0]:.3g}/{v['med']['v3_muon'][1]:.3g} v4muon {v['med']['v4_muon'][0]:.3g}/{v['med']['v4_muon'][1]:.3g} | "
+                      f"v4/pp {v['direct']['ratio']:.3g} (v4 lower both {v['direct']['v4_lower_both_pct']:.0f}%, pp lower {v['direct']['pp_lower_both_pct']:.0f}%, "
+                      f"gap {v['direct']['gap']:.2f} spreads {v['direct']['spread_v4']:.2f}/{v['direct']['spread_v3']:.2f}) | "
+                      f"v4/v3 {v['relative']['v4_over_v3_muon']:.3g} pp/win {v['relative']['pp_over_v3_adamw']:.3g} "
+                      f"recovered {v['relative']['recovered']} muon/adamw {v['relative']['muon_over_adamw_v3']:.3g}")
+                c = claims.setdefault(bk, {}).setdefault(g, {})[k] = {"n": v["n"], "pp_med": v["med"]["pp_trained"],
+                                                                      "v3_adamw_med": v["med"]["v3_adamw"],
+                                                                      "v4_lo": min(v["med"]["v4_muon"]), "v4_hi": max(v["med"]["v4_muon"])}
+                c.update(v["direct"])
+                c.update(v["relative"])
+    claims["check"] = chk
+    print(json.dumps(claims))
+
+
+def plot(out):
+    """per group (trained in both, held out in both; no b, catalog_v4's function the pp pool's), each run's median MSE on the whole pp pool and on its events
+    inside and outside catalog_v3's coverage"""
+    import plot_style as ps
+    fig, axs = ps.figure(ncols=2)
+    ser = (("pp-trained, AdamW", ps.C.green, "D", -0.21, lambda m: [m["pp_trained"]]),
+           ("catalog v3, AdamW", ps.C.grey, "^", -0.07, lambda m: [m["v3_adamw"]]),
+           ("catalog v3, Muon", ps.C.blue, "o", 0.07, lambda m: m["v3_muon"]),
+           ("catalog v4, Muon", ps.C.vermillion, "s", 0.21, lambda m: m["v4_muon"]))
+    for ax, g, lab in zip(axs, ("train", "heldout"), ("trained in both", "held out in both")):
+        x = np.arange(len(MEAS))
+        for name, col, mk, dx, get in ser:
+            for j in range(len(get(out["no_b_same"][g]["mse"]["med"]))):
+                y = [get(out["no_b_same"][g][k]["med"])[j] for k in MEAS]
+                ax.plot(x + dx, y, mk, color=col, mfc=col if j == 0 else "none",
+                        label=name + (f", seed {42 + j}" if name.endswith("Muon") else ""))
+        ax.set_xticks(x)
+        ax.set_xticklabels(["whole pool", "inside", "outside"])
+        ax.set_yscale("log")
+        ax.set_ylabel("median MSE, 13 TeV pp")
+        ax.set_ylim(0.08, 12)                            # one range for both panels
+        ax.set_xlabel(f"classes {lab}")
+    ps.shared_legend(fig, axs[0], ncol=3)                # six entries fit in no panel
+    ps.save(fig, os.path.join(HERE, "figs", "compare_pp_trained"))
+
+
+if __name__ == "__main__":
+    main()
