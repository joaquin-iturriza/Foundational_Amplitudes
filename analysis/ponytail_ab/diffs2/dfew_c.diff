@@ -0,0 +1,160 @@
+"""D83 exploration, fifth pass: few-shot calibration of a pretrained model on a new process, in full.
+For hp58 (per-process standardization, level from the statistics map g), A (per-event factor (s0/s_hat)^(4-N)/C_p and one
+shared standardization) and B (one shared standardization), on the 139 held-out processes, k labelled events of the
+process fit a correction to the model's prediction Q (all in log|M|^2):
+  level          T = Q + b
+  affine         T = a Q + b                 (least squares)
+  affine+inv     T = a Q + b + c log s_hat   (least squares; s_hat the one per-event invariant on hand)
+  ..., shrunk    the same with a ridge pulling a to 1 and c to 0, of weight K0 pseudo-events times the variance of Q
+                 (and log s_hat) over the process's events, which needs no labels
+fitted on k = 3, 10, 30, 100 events and scored by the MSE on the process's other events. Samplings of the k: random
+(5 draws, per-process MSE averaged over draws), the first k (as norm_explore4.py), the k with the smallest s_hat, the k
+with the largest. log s_hat is read off A's per-event factor, which carries it only for 2->3 (N=5: logF = log s_hat -
+log s0 - log C_p); for 2->2 the factor is constant, so the s_hat corrections fall back to the affine and the s_hat
+samplings are scored on the 2->3 processes only (42 of the 43 new, 79 of the 96 relabels; random is reported on the
+same subset next to them). The three files hold the same 2000 events per process (A's t = log|M|^2 + logF exactly).
+Inputs: data/heldout_preds.npz, data/catalog_norm_{A,B}.npz, data/stats_net.json, heldout_twins.json,
+data/norm_moments2.json, data/diagram_couplings.json. Output data/norm_explore5.json, figs/norm_explore5_k_{a,b}.
+    .venv-driver/bin/python analysis/catalog_daniel/norm_explore5.py
+"""
+import json, os, sys
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.dirname(os.path.dirname(HERE)))
+sys.path.insert(0, HERE)
+from heldout_delta import G  # noqa: E402
+
+KS = (3, 10, 30, 100)
+DRAWS = 5
+K0 = 3.0
+LS0 = float(np.log(289.0))
+METHODS = ("level", "affine", "affine_shrunk", "affine+inv", "affine+inv_shrunk")
+
+
+def fit(method, Q, L, Tk, Qk, Lk):
+    """Return the corrected prediction on all events from the k labelled (Qk, Tk, Lk); L is None for 2->2."""
+    if method == "level":
+        return Q + np.mean(Tk - Qk)
+    inv = method.startswith("affine+inv") and L is not None
+    X, Xk = (np.c_[Q, L], np.c_[Qk, Lk]) if inv else (Q[:, None], Qk[:, None])
+    prior = np.zeros(X.shape[1]); prior[0] = 1.0
+    xm, rm = Xk.mean(0), np.mean(Tk - Xk @ prior)
+    Xc, r = Xk - xm, (Tk - Xk @ prior) - rm
+    lam = K0 * X.var(0) if method.endswith("shrunk") else np.zeros(X.shape[1])
+    # ridge on the departure from the prior (a = 1, c = 0); lstsq with an exact solution for k <= p
+    w = np.linalg.lstsq(Xc.T @ Xc + np.diag(lam), Xc.T @ r, rcond=None)[0]
+    return X @ (prior + w) + (rm - xm @ w)
+
+
+def samples(kind, k, n, L, rng):
+    if kind == "random":
+        return [rng.choice(n, k, replace=False) for _ in range(DRAWS)]
+    if kind == "first":
+        return [np.arange(k)]
+    o = np.argsort(L)
+    return [o[:k] if kind == "small_shat" else o[-k:]]
+
+
+def main():
+    twins = set(json.load(open(os.path.join(HERE, "heldout_twins.json"))))
+    mo = json.load(open(os.path.join(HERE, "data", "norm_moments2.json")))["heldout"]
+    logc = {k: max(v["logc2"]) for k, v in json.load(open(os.path.join(HERE, "data", "diagram_couplings.json"))).items()}
+    H = dict(np.load(os.path.join(HERE, "data", "heldout_preds.npz")))
+    A = dict(np.load(os.path.join(HERE, "data", "catalog_norm_A.npz")))
+    B = dict(np.load(os.path.join(HERE, "data", "catalog_norm_B.npz")))
+    sn = json.load(open(os.path.join(HERE, "data", "stats_net.json")))
+    g = {n: v for n, v in zip(sn["heldout_names"], sn["heldout_pred"][G])}
+    probes = sorted(mo)
+    f = lambda z, p, k: z[f"{p}__{k}"].astype(np.float64)
+    data = {m: {} for m in ("hp58", "A", "B")}
+    shat = {}
+    for p in probes:
+        F = f(A, p, "logF")
+        assert np.allclose(f(A, p, "t") - F, f(H, p, "t"), atol=1e-4) and np.allclose(f(B, p, "t"), f(H, p, "t"))
+        shat[p] = F + logc[p] + LS0 if mo[p]["N"] == 5 else None
+        T = f(H, p, "t")
+        mu, lsd = g[p]
+        data["hp58"][p] = (T, mu + np.exp(lsd) * f(H, p, "h"))
+        data["A"][p] = (T, f(A, p, "q") - F)
+        data["B"][p] = (T, f(B, p, "q"))
+    groups = {"43 new": [p for p in probes if p not in twins], "96 relabels": [p for p in probes if p in twins]}
+    groups.update({f"{g_} 2->3": [p for p in v if shat[p] is not None] for g_, v in list(groups.items())})
+    stat = lambda v: [float(np.median(v)), float(np.quantile(v, .9))]
+
+    out = {"K0": K0, "draws": DRAWS, "groups": {k: len(v) for k, v in groups.items()}, "models": {}}
+    for m, D in data.items():
+        R = out["models"][m] = {"own": {}, "oracle": {}}
+        own = {p: np.mean((Q - T) ** 2) for p, (T, Q) in D.items()}
+        orc = {meth: {p: np.mean((fit(meth, Q, shat[p], T, Q, shat[p]) - T) ** 2) for p, (T, Q) in D.items()}
+               for meth in ("level", "affine", "affine+inv")}
+        for gn, P in groups.items():
+            R["own"][gn] = stat([own[p] for p in P])
+            R["oracle"][gn] = {meth: stat([orc[meth][p] for p in P]) for meth in orc}
+        for kind in ("random", "first", "small_shat", "large_shat"):
+            R[kind] = {}
+            for meth in METHODS:
+                R[kind][meth] = {}
+                for k in KS:
+                    rng = np.random.default_rng(1000 + k)
+                    e = {}
+                    for p, (T, Q) in D.items():
+                        L = shat[p]
+                        if kind.endswith("shat") and L is None:
+                            continue
+                        errs = []
+                        for idx in samples(kind, k, len(T), L, rng):
+                            rest = np.setdiff1d(np.arange(len(T)), idx)
+                            pr = fit(meth, Q, L, T[idx], Q[idx], None if L is None else L[idx])
+                            errs.append(np.mean((pr[rest] - T[rest]) ** 2))
+                        e[p] = float(np.mean(errs))
+                    R[kind][meth][k] = {gn: stat([e[p] for p in P if p in e]) for gn, P in groups.items()
+                                        if any(p in e for p in P)}
+        print(f"\n== {m}: on its own 43 new {R['own']['43 new'][0]:.3g} (90% {R['own']['43 new'][1]:.3g}), "
+              f"relabels {R['own']['96 relabels'][0]:.3g}; oracle (all 2000 events) "
+              + ", ".join(f"{meth} {R['oracle']['43 new'][meth][0]:.3g}/{R['oracle']['96 relabels'][meth][0]:.3g}"
+                          for meth in R["oracle"]["43 new"]))
+        for kind in ("random", "first"):
+            print(f"  sampling {kind}: median (90%) on 43 new | 96 relabels")
+            for meth in METHODS:
+                print(f"    {meth:18s}" + "  ".join(
+                    f"k={k}: {R[kind][meth][k]['43 new'][0]:.3g} ({R[kind][meth][k]['43 new'][1]:.3g}) | "
+                    f"{R[kind][meth][k]['96 relabels'][0]:.3g} ({R[kind][meth][k]['96 relabels'][1]:.3g})" for k in KS))
+        print("  sampling sensitivity on 2->3: median on 43 new | relabels, random / smallest s_hat / largest s_hat")
+        for meth in METHODS:
+            print(f"    {meth:18s}" + "  ".join(
+                f"k={k}: " + "/".join(f"{R[kind][meth][k]['43 new 2->3'][0]:.3g}" for kind in
+                                      ("random", "small_shat", "large_shat")) + " | " +
+                "/".join(f"{R[kind][meth][k]['96 relabels 2->3'][0]:.3g}" for kind in
+                         ("random", "small_shat", "large_shat")) for k in KS))
+    json.dump(out, open(os.path.join(HERE, "data", "norm_explore5.json"), "w"), indent=1)
+    plot(json.loads(json.dumps(out)))  # the JSON form: k keys as strings
+
+
+def plot(out):
+    """Median MSE against k, random sampling: one panel per group, colour = model, line = correction."""
+    import plot_style as ps
+    from matplotlib.lines import Line2D
+    ps.use()
+    col = {"hp58": ps.C.grey, "A": ps.C.vermillion, "B": ps.C.blue}
+    sty = {"level": ":", "affine_shrunk": "--", "affine+inv_shrunk": "-"}
+    lab = {"level": "level", "affine_shrunk": "affine (shrunk)", "affine+inv_shrunk": r"affine + $\log\hat s$ (shrunk)"}
+    figs = ps.panels(2)
+    for (fig, ax), gn in zip(figs, ("43 new", "96 relabels")):
+        for m, R in out["models"].items():
+            for meth, ls in sty.items():
+                ax.plot(KS, [R["random"][meth][str(k)][gn][0] for k in KS],
+                        ls, color=col[m], marker="o", ms=3)
+        ax.set_xscale("log"); ax.set_yscale("log")
+        ax.set_xlabel(f"labelled events $k$ ({gn})"); ax.set_ylabel(r"median MSE$(\log|\mathcal{M}|^2)$")
+        if gn == "43 new":  # one legend, on the panel with room for it
+            continue
+        h = [Line2D([], [], color=c, lw=1.5) for c in col.values()] + \
+            [Line2D([], [], color="k", ls=ls) for ls in sty.values()]
+        ps.legend(ax, "upper right", handles=h, labels=list(col) + [lab[x] for x in sty])
+    ps.save_panels(figs, os.path.join(HERE, "figs", "norm_explore5_k"))
+
+
+if __name__ == "__main__":
+    main()
