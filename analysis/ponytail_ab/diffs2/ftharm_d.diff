+    for r in runs:
+        r["class"] = klass(r) if r["loses"] else None
+        r["held"] = bool(r["loses"] and r["readout"] is not None and r["readout"] <= r["scratch"]
+                         and r["class"] != "ii")
+    summary = {}
+    for s in ("first", "dyhpo", "grid"):
+        for m in METHODS:
