+                e["ii_first_worse"] = sum(r["first"] > r["start"] for r in ii)
+            summary[f"{s}.{m}"] = e
+    # the parent's head as it is against a constant (the validation variance is not stored here: the raw head over
+    # the read-out, the gap the head refit closes)
+    hr = [np.log10(r["head_raw"] / r["readout"]) for r in runs if r["set"] == "first" and r["method"] == "default"]
+    summary["head_raw_over_readout_median_decades"] = float(np.median(hr))
+    summary["head_raw_over_var_median"] = float(np.median([RO[(r["probe"], r["rung"], r["k"])]["head_raw"]
+                                                           / RO[(r["probe"], r["rung"], r["k"])]["val_var"]
+                                                           for r in runs if r["set"] == "first" and r["method"] == "default"]))
+    known = [r for r in runs if r["class"]]
+    summary["total"] = {"lose_known": len(known), **{c: sum(r["class"] == c for r in known) for c in ("i", "ii", "iii")},
+                        "held": sum(r["held"] for r in runs)}   # over every losing run with a read-out
+    # LP-FT's start against scratch on the 60 cells, and per probe how many of the 12 (3 rungs x 4 D) it beats
+    lp = [r for r in runs if r["set"] == "first" and r["method"] == "lpft"]
+    summary["readout_beats_scratch"] = sum(r["readout"] <= r["scratch"] for r in lp)
+    summary["readout_beats_scratch_by_probe"] = {p: sum(r["readout"] <= r["scratch"] for r in lp if r["probe"] == p)
