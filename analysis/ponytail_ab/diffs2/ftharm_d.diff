+               for m in METHODS if f"{s}.{m}" in summary]
+    asis = [r for r in runs if r["set"] in ("first", "dyhpo") and r["method"] != "lpft"]
+    lp = {s: [r for r in runs if r["set"] == s and r["method"] == "lpft"] for s in ("first", "dyhpo")}
