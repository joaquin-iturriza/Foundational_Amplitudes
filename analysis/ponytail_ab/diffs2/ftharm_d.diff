+"""ft_harm (the user's call, 2026-10-26: "if the finetuning is actively hurting the pretrained model, this needs to be
+understood"): where a fine-tune loses to scratch, is it a bad starting point or does the fine-tune undo a good one?
+Per run, from its saved validation curve (MSE of log|M|^2: val_loss_no_reg times prepd_std^2, as cells.py reports a
+cell) against scratch's best (the grid's eight-trial search):
+  start   the validation loss at step 0, before any update. A fine-tune that keeps the parent's head starts at the
+          parent's output on the probe as it is (head_raw_val_mse of tools/linear_readout.py, run on the cell's step-0
+          experiment); linear probe then fine-tune starts at the frozen trunk's ridge read-out (readout_val_mse), the
+          head it is given. The curves themselves start at the first validation, after validate_every steps.
+  best    the curve's minimum (the run's value) and where it sits in the run; last, the curve's end.
+A run loses when its best is above scratch's. Each losing run is classed by its start S0 against scratch's best Ls:
+  (i)   S0 > Ls and best < S0: a start worse than scratch, improved on, never brought to scratch (a bad start);
+  (ii)  S0 <= Ls: the start already beats scratch, and the fine-tune ends above it (the fine-tune undoes it);
+  (iii) S0 > Ls and best >= S0: worse than scratch from the start, and the fine-tune never even gets back to it.
+Within a run its best is its minimum, so a losing run never went below scratch at a validation; whether it did between
+step 0 and its first validation is what the start answers. "Held" marks a run whose trunk, read out linearly, beats
+scratch (the read-out below Ls) though its own start does not (the parent's head as it is).
+Sets: the first round's single runs (four methods at the grid's best HPs, 60 cells, curves copied home from CC
+zz_lowd to runs/zz_lowd_curves/first_round), the DyHPO round's best trial per method and cell (data/lowd_dyhpo_sweeps.json),
+the grid's best default fine-tune on those 60 cells (scratch_sweeps.json), and the grid's best fine-tune of every
+losing cell at D <= 10^2.5 (data/nogain.json), whose start is known only where a read-out was run.
+    python3 analysis/transfer/ft_harm.py      -> data/ft_harm.json, figs/ft_harm.{png,pdf}; last line the claims object
+"""
+import json, os, sys
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(os.path.dirname(HERE))
+sys.path.insert(0, HERE)
+FIRST = os.path.join(ROOT, "runs", "zz_lowd_curves", "first_round")
+METHODS = ["default", "lpft", "l2sp", "freeze"]
+K_SMALL = (2, 3, 4, 5)
+
+
+def readouts():
+    """(probe, rung, k) -> the step-0 numbers of tools/linear_readout.py, in MSE of log|M|^2."""
+    out = {}
+    d = os.path.join(FIRST, "readout")
+    for f in sorted(os.listdir(d)):
+        r = json.load(open(os.path.join(d, f)))
+        name = r["sweep"][len("tp3_r"):]                       # "<rung>fte_<probe>_d<k>"
+        rung, rest = name.split("fte_", 1)
+        probe, k = rest.rsplit("_d", 1)
+        out[(probe, int(rung), int(k))] = {"readout": r["readout_val_mse"], "head_raw": r["head_raw_val_mse"],
+                                           "prepd_std": r["prepd_std"], "val_var": r["val_var"]}
+    # ee -> Z gamma, every rung at 10^1.5, 10^2 (par:nogain's read-out, no raw head recorded there)
+    za = json.load(open(os.path.join(HERE, "data", "nogain_readout_za.json")))
+    for k, c in za.items():
+        for arm, a in c["arms"].items():
+            rung = 0 if arm == "uufte" else int(arm[1:].split("fte")[0]) if arm.startswith("r") else None
+            if rung is not None:
+                out.setdefault(("ee_Za", rung, int(k)), {"readout": a["readout"], "head_raw": None, "prepd_std": None})
+    return out
+
+
+def describe(curve, every, start, Ls, T=None):
+    c = np.asarray(curve, float)
+    i = int(np.argmin(c))
+    n = len(c)
+    return {"start": start, "first": float(c[0]), "best": float(c[i]), "last": float(c[-1]),
+            "best_frac": (i + 1) / n, "every": every, "n_val": n, "scratch": Ls,
+            "loses": bool(c[i] > Ls)}
+
+
+def klass(r):
+    if r["start"] is None:
+        return None
+    if r["start"] <= r["scratch"]:
+        return "ii"
+    return "i" if r["best"] < r["start"] else "iii"
+
+
+def main():
+    spec = json.load(open(os.path.join(HERE, "data", "lowd_ft_spec.json")))
+    RO = readouts()
+    S_dy = json.load(open(os.path.join(HERE, "data", "lowd_dyhpo_sweeps.json")))
+    from cells import S as S_grid, best  # noqa: E402
+    from rung_grid import fam  # noqa: E402
+    runs = []
+    for c in spec:
+        p, rung, k, Ls, std2 = c["probe"], c["rung"], c["k"], c["scratch"], c["prepd_std"] ** 2
+        ro = RO[(p, rung, k)]
+        assert abs(ro["prepd_std"] - c["prepd_std"]) < 1e-6, (p, rung, k)
+        st = {m: (ro["readout"] if m == "lpft" else ro["head_raw"]) for m in METHODS}
+        base = {"probe": p, "rung": rung, "k": k, "readout": ro["readout"], "head_raw": ro["head_raw"]}
+        for m in METHODS:   # the first round: one run per method at the grid's best HPs
+            res = json.load(open(os.path.join(FIRST, f"tp3_lowd_{m}_{p}", f"r{rung}_d{k}_result.json")))
+            cur = [v * std2 for v in res["val_curve"]]
+            runs.append({**base, "set": "first", "method": m, **describe(cur, res["validate_every"], st[m], Ls)})
+        for m in METHODS[1:]:   # the DyHPO round: each method's best of its five trials
+            tr = [t for t in S_dy.get(f"tp3_lowd_{m}_r{rung}_{p}_d{k}", []) if t.get("val_curve") and t.get("prepd_std")]
+            b = min(tr, key=lambda t: t["val_loss"] * t["prepd_std"] ** 2)
+            cur = [v * b["prepd_std"] ** 2 for v in b["val_curve"]]
+            runs.append({**base, "set": "dyhpo", "method": m, **describe(cur, b["validate_every"], st[m], Ls)})
+    # the grid: the best default fine-tune of every cell at D <= 10^2.5 that loses (nogain.json), and of the 60 cells
+    ng = json.load(open(os.path.join(HERE, "data", "nogain.json")))
+    cells60 = {(c["probe"], c["rung"], c["k"]) for c in spec}
+    for p, v in ng.items():
+        for ks, cell in v["cells"].items():
+            k = int(ks)
+            if k not in K_SMALL:
+                continue
+            for rs, g in cell["gain"].items():
+                rung = int(rs)
+                if g is None or (g >= 0 and (p, rung, k) not in cells60):
+                    continue
+                _, b = best(f"{fam(rung)}_{p}_d{k}")
+                if not b or not b.get("val_curve"):
+                    continue
+                std2 = b["prepd_std"] ** 2
+                ro = RO.get((p, rung, k))
+                start = ro["head_raw"] if ro else None
+                runs.append({"probe": p, "rung": rung, "k": k, "set": "grid", "method": "default",
+                             "readout": ro["readout"] if ro else None, "head_raw": start,
+                             **describe([x * std2 for x in b["val_curve"]], b["validate_every"], start,
