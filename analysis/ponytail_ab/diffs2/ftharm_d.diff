+def plot(runs):
+    """(a) the runs that start from the parent's head as it is (default, L2-SP, frozen blocks; both rounds and the
+    grid's record on the 60 cells): what the trunk holds (the read-out) over scratch's best, against the run's best over
+    scratch; (b) linear probe then fine-tune, both rounds, whose start is that read-out. A run above 0 loses; left of 0
+    its start (b) or its trunk (a) already beats scratch; above the diagonal it never gets back to the read-out."""
+    sys.path.insert(0, ROOT)
+    import plot_style as ps
+    fig, (a, b) = ps.figure(ncols=2)
+    cols = ps.sequence(len(K_SMALL))
+    lim = []
+    for ax, sel in ((a, lambda r: r["method"] != "lpft" and r["readout"] is not None and r["k"] in K_SMALL
+                     and (r["set"] != "grid" or r["head_raw"] is not None)),
+                    (b, lambda r: r["method"] == "lpft")):
+        L = [r for r in runs if sel(r)]
+        for kk, mk, c in zip(K_SMALL, ("o", "s", "^", "v"), cols):
+            Lk = [r for r in L if r["k"] == kk]
+            x = np.log10([r["readout"] / r["scratch"] for r in Lk])
+            y = np.log10([r["best"] / r["scratch"] for r in Lk])
+            ax.scatter(x, y, marker=mk, color=c, alpha=0.7, label=rf"$D=10^{{{kk / 2:g}}}$")
+            lim += list(x) + list(y)
+    lo, hi = min(lim) - 0.2, max(lim) + 0.2
+    for ax in (a, b):
+        ax.plot([lo, hi], [lo, hi], ls="--", color=ps.C.grey, label="best = read-out")
+        ax.axhline(0, ls=":", color=ps.C.grey, label="scratch's best")
+        ax.axvline(0, ls=":", color=ps.C.grey)
+        ax.set_xlabel(r"$\log_{10}$ read-out / scratch")
+        ax.set_ylabel(r"$\log_{10}$ fine-tune best / scratch")
+    ps.legend(a, "upper left", ncol=2)
+    for ax in (a, b):
+        ps.make_room(ax)
+    ps.save(fig, os.path.join(HERE, "figs", "ft_harm"))
+
