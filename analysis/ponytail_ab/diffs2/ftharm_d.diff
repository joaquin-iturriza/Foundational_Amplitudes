+                 "held": sum(r["held"] for r in known)}
+            if [r for r in lo if r["readout"] is not None]:   # the losing runs: what the trunk held, where they end
+                e["lose_median_readout_over_scratch"] = float(np.median([r["readout"] / r["scratch"] for r in lo
+                                                                         if r["readout"] is not None]))
+                e["lose_median_best_over_scratch"] = float(np.median([r["best"] / r["scratch"] for r in lo]))
+            if known:
