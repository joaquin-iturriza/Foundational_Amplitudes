+        summary[f"{s}.lpft.good_start_lost"] = sum(r["loses"] for r in g)
+    # what the trunk holds against where the run ends: a run (both rounds) whose best is above its cell's read-out
+    for m in METHODS:
+        g = [r for r in runs if r["set"] in ("first", "dyhpo") and r["method"] == m]
+        summary[f"{m}.best_above_readout"] = sum(r["best"] > r["readout"] for r in g)
+        summary[f"{m}.n_both"] = len(g)
+    # every LP-FT run: its best against its start (does the fine-tune ever improve on the read-out?)
+    for s in ("first", "dyhpo"):
+        g = [r for r in runs if r["set"] == s and r["method"] == "lpft"]
+        summary[f"{s}.lpft.best_above_start"] = sum(r["best"] > r["start"] for r in g)
+        summary[f"{s}.lpft.first_above_start"] = sum(r["first"] > r["start"] for r in g)
+        for k in K_SMALL:   # the first validation comes after validate_every steps: 1, 7, 28, 45 at these D
+            gk = [r for r in g if r["k"] == k]
+            summary[f"{s}.lpft.best_above_start_d{k}"] = sum(r["best"] > r["start"] for r in gk)
+            summary[f"{s}.lpft.first_over_start_d{k}"] = float(np.median([r["first"] / r["start"] for r in gk]))
+            summary[f"{s}.lpft.every_d{k}"] = sorted({r["every"] for r in gk})
+    # the numbers docs/results.tex states (par:ft_harm), keyed for tools/verify_claims.py
+    tot = summary["total"]
+    ii = [r for r in runs if r["class"] == "ii"]
