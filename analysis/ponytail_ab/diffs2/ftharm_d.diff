+    # of those, how many runs (LP-FT, both rounds) end above their start and above scratch
+    for s in ("first", "dyhpo"):
+        g = [r for r in runs if r["set"] == s and r["method"] == "lpft" and r["readout"] <= r["scratch"]]
+        summary[f"{s}.lpft.good_start"] = len(g)
