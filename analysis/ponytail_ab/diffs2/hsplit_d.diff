@@ -0,0 +1,125 @@
+"""Why the hybrid (the s_hat target plus the process's constant c_p, arm dimensionless_hybrid) reads the class mean worse
+than the emission scales (arm dimensionless) although the two targets share it by construction (prep_level.py): its
+level error split, per probe, from the saved zero-shot reads alone (data/short_reads/<arm>/<axis>/<probe>.npz, the same
+2000 validation events in every arm; t and q in the arm's target space, logF its per-event factor, short_reads.py).
+Per probe, the mean error e = mean(q - t) (its square is short_reads.py's level) of the hybrid (e_h) and of the emission
+scales (e_q); from the factors (the s_hat arm's logF is the hybrid's without c_p, the emission arm's differs from it by
+Lq - (N - 4) log s_hat per event; s0 and the coupling constants cancel):
+  cp_handed  logF_hybrid - logF_shat: the constant the run hands the probe (fitted on its own first 10^4 train events)
+  cp_val     mean(logF_emission - logF_shat): the constant on the 2000 events predicted
+  delta      cp_val - cp_handed: (a) the constant's part of e_h
+  net        e_h - delta: (b) the hybrid network's error on the same class mean the emission scales' network reads,
+             the level e_h would have with the exact constant; the network's output never sees c_p (only its target)
+Per axis: the medians of |delta|, of the level ratio e_h^2 / e_q^2 and of net^2 / e_q^2 (the ratio with (a) set to 0);
+the slope and correlation of e_h on cp_handed over the probes with c_p != 0 (a network that supplies a fixed fraction
+of the constant would leave e_h proportional to it).
+pT >= 30 GeV (H7c): cp_default, the same process's c_p at the default cuts (data/prep_level.json, its validation
+events); the hybrid network trained at the default cuts would carry that constant, so e_h against cp_default - cp_handed
+(slope, correlation), and the level with the default constant subtracted instead, (e_h - (cp_default - cp_handed))^2.
+The top (H3): e_h and e_q by the number of external tops (data/prep_level.json's pdg list).
+    python3 analysis/catalog_v3/prep_hybrid_split.py   -> data/prep_hybrid_split.json, one flat JSON line last
+"""
+import glob, json, os
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+R = os.path.join(HERE, "data", "short_reads")
+AXES = ("H1", "H2", "H2p5", "H3", "H6", "H7E", "H7c")     # the tree axes (H5's one-loop pools: no c_p)
+H, Q, S = "dimensionless_hybrid", "dimensionless", "dimensionless_shat"
+
+
+def probe(axis, name):
+    z = {a: np.load(os.path.join(R, a, axis, name + ".npz")) for a in (H, Q, S)}
+    y = {a: z[a]["t"].astype(float) - z[a]["logF"].astype(float) for a in z}
+    assert all(np.abs(y[a] - y[Q]).max() < 1e-3 for a in z), f"{axis}/{name}: not the same events"
+    e = {a: float(np.mean(z[a]["q"].astype(float) - z[a]["t"].astype(float))) for a in (H, Q)}
+    lf = {a: z[a]["logF"].astype(float) for a in z}
+    cph, cpv = float(np.mean(lf[H] - lf[S])), float(np.mean(lf[Q] - lf[S]))
+    return {"e_h": e[H], "e_q": e[Q], "cp_handed": cph, "cp_val": cpv, "delta": cpv - cph,
+            "net": e[H] - (cpv - cph)}
+
+
+def main():
+    pl = json.load(open(os.path.join(HERE, "data", "prep_level.json")))["classes"]
+    cls = {n: v for ax in pl.values() for n, v in ax.items()}
+    out, flat = {}, {}
+    for ax in AXES:
+        names = sorted(os.path.basename(f)[:-4] for f in glob.glob(os.path.join(R, H, ax, "*.npz")))
+        names = [n for n in names if all(os.path.exists(os.path.join(R, a, ax, n + ".npz")) for a in (Q, S))]
+        rows = {n: probe(ax, n) for n in names}
+        for n, r in rows.items():
+            if n in cls:                                       # the constant on the same events, from prep_level.py
+                r["cp_prep_level"] = cls[n]["c_p"]
+        lv = np.array([r["e_h"] ** 2 / r["e_q"] ** 2 for r in rows.values()])
+        ln = np.array([r["net"] ** 2 / r["e_q"] ** 2 for r in rows.values()])
+        d = np.abs([r["delta"] for r in rows.values()])
+        o = {"n": len(rows), "abs_delta_median": float(np.median(d)), "abs_delta_max": float(d.max()),
+             "level_ratio": float(np.median(lv)), "level_ratio_net": float(np.median(ln)),
+             "level_h": float(np.median([r["e_h"] ** 2 for r in rows.values()])),
+             "level_q": float(np.median([r["e_q"] ** 2 for r in rows.values()])),
+             "level_net": float(np.median([r["net"] ** 2 for r in rows.values()])),
+             "e_h_median": float(np.median([r["e_h"] for r in rows.values()])),
+             "e_q_median": float(np.median([r["e_q"] for r in rows.values()])),
+             "cp_check_max": max((abs(r["cp_val"] - r["cp_prep_level"]) for r in rows.values()
+                                  if "cp_prep_level" in r), default=None)}
+        c = np.array([r["cp_handed"] for r in rows.values()]); eh_ = np.array([r["e_h"] for r in rows.values()])
+        mc = np.abs(c) > 1e-9
+        o.update({"slope_on_cp": float(np.polyfit(c[mc], eh_[mc], 1)[0]),
+                  "corr_on_cp": float(np.corrcoef(c[mc], eh_[mc])[0, 1])})
+        if ax == "H7c":
+            sh, eh, eq = [], [], []
+            for n, r in rows.items():
+                base = n.split("__")[0]
+                if base not in cls:
+                    continue
+                r["cp_default"] = cls[base]["c_p"]
+                r["shift"] = r["cp_default"] - r["cp_handed"]
+                r["e_h_default"] = r["e_h"] - r["shift"]
+                sh.append(r["shift"]); eh.append(r["e_h"]); eq.append(r["e_q"])
+            sh, eh, eq = map(np.array, (sh, eh, eq))
+            m = np.abs(sh) > 1e-9                              # 2 -> 2: c_p is zero at any cut
+            slope = float(np.polyfit(sh[m], eh[m], 1)[0])
+            ed = eh - sh
+            o.update({"n_default": int(len(sh)), "n_shifted": int(m.sum()), "shift_median": float(np.median(sh[m])),
+                      "slope": slope, "corr": float(np.corrcoef(sh[m], eh[m])[0, 1]),
+                      "level_default": float(np.median(ed ** 2)),
+                      "level_default_ratio": float(np.median(ed ** 2 / eq ** 2)),
+                      "level_default_over_q": float(np.median(ed ** 2) / np.median(eq ** 2))})
+        if ax == "H3":
+            by = {}
+            for n, r in rows.items():
+                if n not in cls:
+                    continue
+                k = sum(abs(p) == 6 for p in cls[n]["pdg"])
+                r["n_top"], r["N"] = k, cls[n]["N"]
+                by.setdefault(k, []).append(r)
+            o["by_tops"] = {str(k): {"n": len(v), "e_h_median": float(np.median([r["e_h"] for r in v])),
+                                     "e_q_median": float(np.median([r["e_q"] for r in v])),
+                                     "cp_handed_median": float(np.median([r["cp_handed"] for r in v]))}
+                            for k, v in sorted(by.items())}
+            by22 = [r for v in by.values() for r in v if r["N"] == 4]
+            o["two_to_two"] = {"n": len(by22), "e_h_median": float(np.median([r["e_h"] for r in by22])),
+                               "e_q_median": float(np.median([r["e_q"] for r in by22]))} if by22 else None
+        o["probes"] = rows
+        out[ax] = o
+        print(ax, json.dumps({k: (round(v, 4) if isinstance(v, float) else v) for k, v in o.items() if k != "probes"}))
+        for k in ("abs_delta_median", "level_ratio", "level_ratio_net", "level_h", "level_q", "level_net",
+                  "slope_on_cp", "corr_on_cp"):
+            flat[f"{ax}_{k}"] = float(f"{o[k]:.3g}")
+    h7, h3 = out["H7c"], out["H3"]
+    flat.update({f"H7c_{k}": float(f"{h7[k]:.3g}") for k in ("shift_median", "slope", "corr", "level_default",
+                                                             "level_default_over_q")})
+    flat.update({f"H7c_{k}": h7[k] for k in ("n_default", "n_shifted")})
+    for k, v in h3["by_tops"].items():
+        flat[f"H3_top{k}_e_h"] = round(v["e_h_median"], 2); flat[f"H3_top{k}_e_q"] = round(v["e_q_median"], 2)
+        flat[f"H3_top{k}_n"] = v["n"]
+    if h3["two_to_two"]:
+        flat["H3_22_e_h"] = round(h3["two_to_two"]["e_h_median"], 2)
+        flat["H3_22_e_q"] = round(h3["two_to_two"]["e_q_median"], 2)
+    json.dump(out, open(os.path.join(HERE, "data", "prep_hybrid_split.json"), "w"), indent=1)
+    print(json.dumps(flat))
+
+
+if __name__ == "__main__":
+    main()
