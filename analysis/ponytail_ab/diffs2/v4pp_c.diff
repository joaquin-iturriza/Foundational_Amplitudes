+"""catalog_v4 against training on pp, on the 13 TeV pp pools (catalog_coverage; the user, 2026-10-26: what mattered
+most was how training on catalog_v4 compares to training on pp collisions, on data generated like pp collisions; the
+pp study D117, D119). No new compute: four arms already read on the same pp pools, all the dimensionless arm, 4264
+steps, best checkpoint at step 4250, 2000 validation events per pool, the MSE of log|M|^2:
+  v3_window_adamw   catalog_v3's dimensionless short arm, AdamW, every hadronic class on its windows, one seed
+                    (pp_compare.py, data/pp_rows.json)
+  pp_trained_adamw  the same arm with every hadronic training tree class trained on its 13 TeV pp events instead,
+                    AdamW, one seed (FA-ccin2p3-e786bd74, its read completed by 982b5a14; data/pp_rows.json)
+  v3_window_muon    catalog_v3's dimensionless arm with Muon at the Muon search's best, seeds 42 and 43
+  v4_muon           the same on catalog_v4, seeds 42 and 43 (compare_v3.py; predictions in
+                    analysis/catalog_v3/data/short_reads/<run>/PP/<probe>.npz)
+The two AdamW arms were reduced on the site (pp_compare.collect), the two Muon arms at home from their predictions
+(compare_v3.pp_reads); both split a pool's events into those inside what catalog_v3's window pools cover (the class's
+sqrt(s_hat) window and catalog_v3's fiducial cuts in the partonic frame, pp_compare.support_masks) and the rest.
+Checked here, per probe: the inside share of the AdamW reads equals the site's mask for the Muon reads (one
+definition, the same events), and the variance of the target in every Muon read equals the AdamW reads' (the same
+events and target). Groups as compare_v3.py: the classes trained in both catalogs (for the pp-trained arm trained on
+pp events) and held out in both (per catalog_v3 axis), no b apart (the pp pools carry catalog_v3's 4.7 GeV b).
+  (a) direct: per class catalog_v4 (the geometric mean of its two seeds) over the pp-trained arm, median over classes,
+      and the share of classes where both catalog_v4 seeds are lower; the optimizers differ (Muon against AdamW).
+  (b) each against its own optimizer's window-trained catalog_v3 arm: catalog_v4 / catalog_v3 (Muon, both two seeds)
+      and pp-trained / catalog_v3 (AdamW, one seed each), medians over classes of the per-class ratio; the share of
+      the pp-training gain catalog_v4 recovers is the ratio of their median log ratios (1: all of it, 0: none,
+      negative: catalog_v4 moves the other way). The optimizer factor on pp, catalog_v3 Muon over catalog_v3 AdamW,
+      is printed beside: (b) equals (a) with that factor divided out, if it is the same for pp training (unmeasured);
+      same_optimizer, the quotient of the two median ratios, is that estimate of catalog_v4 over pp training.
+Seed spreads (median |log10 seed 43 / seed 42|) are measured only for the Muon arms; the AdamW arms have one seed.
+    python3 analysis/catalog_v4/pp_trained_compare.py   -> data/pp_trained_compare.json, figs/pp_trained_compare.{png,pdf}
+The last line printed is the JSON of the numbers docs/results.tex quotes.
+"""
+import json, os, sys
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(os.path.dirname(HERE))
+sys.path.insert(0, ROOT)
+sys.path.insert(0, HERE)
+import compare_v3 as cv
+
+MUON = {"v3_window_muon": cv.RUNS["v3"], "v4_muon": cv.RUNS["v4"]}
+ADAMW = {"v3_window_adamw": "dimensionless", "pp_trained_adamw": "dimensionless_pp"}
+KEYS = ("mse", "mse_inside", "mse_outside")
+
+
+def load():
+    site = json.load(open(os.path.join(HERE, "data", "compare_v3_site.json")))
+    names, role = cv.pp_roles()
+    rows, bad, frac, _ = cv.pp_reads(site, names, [r for v in MUON.values() for r in v])
+    ad = json.load(open(os.path.join(ROOT, "analysis", "catalog_v3", "data", "pp_rows.json")))
+    # one row set per run: {run: {key: {probe: mse}}}
+    R = {r: {k: rows[k][r] for k in KEYS} for v in MUON.values() for r in v}
+    for a, src in ADAMW.items():
+        R[a] = {k: {p: v[k] for p, v in ad[src]["pp"].items() if v.get(k) is not None} for k in KEYS}
+    # the same events and one inside definition: the AdamW reads' inside share against the site's mask, and every Muon
+    # read's target variance against the AdamW reads'
+    fdiff = [abs(frac[p] - ad[src]["pp"][p]["frac_inside"]) for src in ADAMW.values() for p in names if p in frac]
+    vdiff = []
+    for r in R:
+        if r in ADAMW:
+            continue
+        for p in names:
+            z = np.load(os.path.join(cv.SR, r, "PP", p + ".npz"))
+            vt = ad["dimensionless_pp"]["pp"][p]["var_t"]
+            vdiff.append(abs(float(np.var(z["t"].astype(float))) - vt) / vt)
+    vt_ad = max(abs(ad["dimensionless"]["pp"][p]["var_t"] - ad["dimensionless_pp"]["pp"][p]["var_t"]) /
+                ad["dimensionless_pp"]["pp"][p]["var_t"] for p in names)
+    chk = {"n_probes": len(names), "n_frac_compared": len(fdiff), "max_frac_inside_diff": max(fdiff),
+           "max_var_t_rel_diff_muon": max(vdiff), "max_var_t_rel_diff_adamw": vt_ad,
+           "no_prediction": {r: v for r, v in bad.items() if v} | {a: ad[s]["no_prediction"] for a, s in ADAMW.items() if ad[s]["no_prediction"]}}
+    assert chk["max_frac_inside_diff"] == 0.0, "the inside split differs between the AdamW and the Muon reads"
+    assert max(vdiff) < 1e-3 and vt_ad < 1e-3, "the arms' reads of a pp probe are not the same events"
+    return names, role, R, chk
+
+
+def gm(R, runs, k, p):
+    """an arm's MSE on a probe: the geometric mean of its seeds"""
+    runs = runs if isinstance(runs, (tuple, list)) else (runs,)
+    return float(np.exp(np.mean([np.log(R[r][k][p]) for r in runs])))
+
+
+def ratio(R, num, den, k, probes):
+    """per probe num over den (each the geometric mean of its seeds) on the probes both have: the median ratio, its
+    10%/90% quantiles, the median log10 ratio, the gap (median |log10 ratio|, compare_v3.py's), and the share of probes where num is lower in every one of its seeds"""
+    nr = num if isinstance(num, (tuple, list)) else (num,)
+    dr = den if isinstance(den, (tuple, list)) else (den,)
+    ps_ = [p for p in probes if all(p in R[r][k] for r in nr + dr)]
+    if not ps_:
+        return None
+    lr = np.log10([gm(R, nr, k, p) / gm(R, dr, k, p) for p in ps_])
+    low = [all(R[r][k][p] < gm(R, dr, k, p) for r in nr) for p in ps_]
+    return {"n": len(ps_), "ratio": float(10 ** np.median(lr)), "log_ratio": float(np.median(lr)),
+            "gap": float(np.median(np.abs(lr))),
+            "ratio_q10_q90": [float(10 ** x) for x in np.quantile(lr, [0.1, 0.9])],
+            "num_lower_pct": float(100 * np.mean(low)), "den_lower_pct": float(100 - 100 * np.mean(low))}
+
+
+def spread(R, runs, k, probes):
+    ps_ = [p for p in probes if all(p in R[r][k] for r in runs)]
+    return float(np.median([abs(np.log10(R[runs[1]][k][p] / R[runs[0]][k][p])) for p in ps_]))
+
+
+def group(R, probes):
+    e = {"n": len(probes), "med": {}}
+    for k in KEYS:
+        e["med"][k] = {a: [float(np.median([R[r][k][p] for p in probes if p in R[r][k]])) for r in
+                           (runs if isinstance(runs, tuple) else (runs,))]
+                       for a, runs in (MUON | {a: a for a in ADAMW}).items()}
+        a = ratio(R, MUON["v4_muon"], "pp_trained_adamw", k, probes)
+        b4 = ratio(R, MUON["v4_muon"], MUON["v3_window_muon"], k, probes)
+        bp = ratio(R, "pp_trained_adamw", "v3_window_adamw", k, probes)
+        opt = ratio(R, MUON["v3_window_muon"], "v3_window_adamw", k, probes)
+        e[k] = {"direct": a, "v4_over_v3_muon": b4, "pp_over_v3_adamw": bp, "muon_over_adamw_v3": opt,
+                "recovered": (b4["log_ratio"] / bp["log_ratio"]) if (b4 and bp and bp["log_ratio"]) else None,
+                "same_optimizer": (10 ** (b4["log_ratio"] - bp["log_ratio"])) if (b4 and bp) else None,
+                "spread_v3_muon": spread(R, MUON["v3_window_muon"], k, probes),
+                "spread_v4_muon": spread(R, MUON["v4_muon"], k, probes)}
+    return e
+
+
+def plot(out):
+    import plot_style as ps
+    arms = (("v3_window_adamw", "catalog v3, AdamW", ps.C.blue, "o"),
+            ("pp_trained_adamw", "pp-trained, AdamW", ps.C.green, "D"),
+            ("v3_window_muon", "catalog v3, Muon", ps.C.sky, "o"),
+            ("v4_muon", "catalog v4, Muon", ps.C.vermillion, "s"))
+    fig, axs = ps.figure(ncols=2)
+    for ax, g, lab in zip(axs, ("train", "heldout"), ("trained in both", "held out in both")):
+        e = out["no_b"][g]
+        x = np.arange(len(KEYS))
+        for j, (a, name, col, mk) in enumerate(arms):
+            for s, y in enumerate(zip(*[e["med"][k][a] for k in KEYS])):
+                ax.plot(x + (j - 1.5) * 0.14, y, mk, color=col, mfc=col if s == 0 else "none",
+                        label=name + ("" if len(e["med"]["mse"][a]) == 1 else f", seed {42 + s}"))
+        ax.set_xticks(x)
+        ax.set_xticklabels(["whole pool", "inside", "outside"])
+        ax.set_yscale("log")
+        ax.set_ylabel("median MSE, 13 TeV pp")
+        ax.set_ylim(0.08, 12)                            # one range for both panels
+        ax.set_xlabel(f"classes {lab}")
+    ps.shared_legend(fig, axs[0], ncol=3)
+    ps.save(fig, os.path.join(HERE, "figs", "pp_trained_compare"))
+
+
+def main():
+    names, role, R, chk = load()
+    b = {n: cv.has_b(n) for n in names}
+    groups = {"train": lambda n: role[n]["v3"] == "train" and role[n]["v4"] == "train",
+              "heldout": lambda n: role[n]["v3"] == "heldout" and role[n]["v4"] == "heldout"}
+    out = {"check": chk}
+    for bk, bsel in (("no_b", lambda n: not b[n]), ("b", lambda n: b[n])):
+        for g, gsel in groups.items():
+            pr = [n for n in names if bsel(n) and gsel(n)]
+            out.setdefault(bk, {})[g] = group(R, pr)
+            if g == "heldout" and bk == "no_b":
+                for ax_ in ("H1", "H2", "H3"):
+                    out[bk][f"heldout_{ax_}"] = group(R, [n for n in pr if role[n]["axis3"] == ax_])
+    json.dump(out, open(os.path.join(HERE, "data", "pp_trained_compare.json"), "w"), indent=1)
+    plot(out)
+    print("check", json.dumps(chk))
+    f = lambda e: (f"{e['ratio']:.3g} [{e['ratio_q10_q90'][0]:.2g},{e['ratio_q10_q90'][1]:.2g}] "
+                   f"num lower {e['num_lower_pct']:.0f}% gap {e['gap']:.2g}") if e else "none"
+    claims = {"check": {k: v for k, v in chk.items() if k != "no_prediction"}}
+    for bk in ("no_b", "b"):
+        for g, e in out[bk].items():
+            for k in KEYS:
+                x = e[k]
+                print(f"{bk:4s} {g:10s} n={e['n']:4d} {k:11s} med " +
+                      " ".join(f"{a} {'/'.join(f'{v:.3g}' for v in e['med'][k][a])}" for a in e["med"][k]))
+                print(f"{'':16s} direct v4/pp {f(x['direct'])} | v4/v3 Muon {f(x['v4_over_v3_muon'])} | "
+                      f"pp/v3 AdamW {f(x['pp_over_v3_adamw'])} | Muon/AdamW v3 {f(x['muon_over_adamw_v3'])} | "
+                      f"recovered {x['recovered'] if x['recovered'] is None else round(x['recovered'], 3)} | "
+                      f"spread v3 {x['spread_v3_muon']:.3g} v4 {x['spread_v4_muon']:.3g}")
+                c = claims.setdefault(bk, {}).setdefault(g, {}).setdefault(k, {"n": x["direct"]["n"] if x["direct"] else 0})
+                for a in e["med"][k]:
+                    c[a] = e["med"][k][a]
+                for nm in ("direct", "v4_over_v3_muon", "pp_over_v3_adamw", "muon_over_adamw_v3"):
+                    if x[nm]:
+                        c[nm] = {kk: x[nm][kk] for kk in ("ratio", "num_lower_pct", "gap")}
+                c["recovered"], c["same_optimizer"] = x["recovered"], x["same_optimizer"]
+                c["spread_v3_muon"], c["spread_v4_muon"] = x["spread_v3_muon"], x["spread_v4_muon"]
+    print(json.dumps(claims))
+
+
+if __name__ == "__main__":
+    main()
