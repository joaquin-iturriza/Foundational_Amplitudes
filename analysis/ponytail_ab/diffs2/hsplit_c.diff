+++ b/analysis/catalog_v3/prep_hybrid_split.py
@@ -0,0 +1,82 @@
+"""Why the hybrid target places a held-out process's level worse than the emission scales (prep_hybrid.py: on the top
+level ratio 1.29, at pT >= 30 GeV 9.8), from the saved zero-shot reads alone (data/short_reads/<arm>/<axis>/<probe>.npz:
+truth t, prediction q, both in the arm's target space, and logF, the per-event factor; t - logF = log|M|^2).
+Per probe, on the same 2000 validation events, the hybrid's mean error e_h = <q_h - t_h> and the emission scales' e_q:
+  e_h - e_q = (b) <q_h> - <q_q> - <logF_h - logF_q>   the two networks' class means of one target (the emission scales')
+            + (a) c_handed - c_val                       the constant the hybrid is handed (its probe's train events) minus
+                                                         the constant on the predicted events; c_val - c_handed = <logF_q - logF_h>
+  level_fix   (e_h + c_val - c_handed)^2 / e_q^2, the level ratio with (a) set to zero
+For pT >= 30 GeV: dc = c_p(default cuts, the base process in training; data/prep_level.json) - c_p(the probe's cut pool),
+the hybrid's e_h against dc (slope, correlation) and its level read with the default-cut constant, (e_h - dc)^2.
+On the top: e_h, e_q by number of external tops; e_h against the probe's c_p minus the training classes' median at its N.
+    python3 analysis/catalog_v3/prep_hybrid_split.py   -> one flat JSON line, data/prep_hybrid_split.json
+"""
+import glob, json, os
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+D = os.path.join(HERE, "data", "short_reads")
+AXES = ("H1", "H2", "H2p5", "H3", "H6", "H7E", "H7c")        # H5: one loop, signed, no hybrid constant read here
+
+
+def probe(axis, name):
+    h, q = (np.load(os.path.join(D, arm, axis, name + ".npz")) for arm in ("dimensionless_hybrid", "dimensionless"))
+    Lh, Lq = h["t"].astype(float) - h["logF"], q["t"].astype(float) - q["logF"]
+    assert np.allclose(Lh, Lq, atol=1e-3 * max(1, np.abs(Lh).max())), (axis, name)   # same events, same log|M|^2
+    e_h, e_q = float(np.mean(h["q"].astype(float) - h["t"])), float(np.mean(q["q"].astype(float) - q["t"]))
+    a = -float(np.mean(q["logF"].astype(float) - h["logF"]))          # c_handed - c_val
+    return {"e_h": e_h, "e_q": e_q, "a": a, "b": e_h - e_q - a}
+
+
+def main():
+    pl = json.load(open(os.path.join(HERE, "data", "prep_level.json")))["classes"]
+    out, flat = {}, {}
+    for ax in AXES:
+        names = sorted(os.path.basename(f)[:-4] for f in glob.glob(os.path.join(D, "dimensionless_hybrid", ax, "*.npz")))
+        names = [n for n in names if os.path.exists(os.path.join(D, "dimensionless", ax, n + ".npz"))]
+        rows = {n: probe(ax, n) for n in names}
+        rows = {n: r for n, r in rows.items() if r["e_q"] ** 2 > 0}
+        for n, r in rows.items():
+            r["N"] = pl[ax][n]["N"] if n in pl.get(ax, {}) else None
+            r["ntop"] = sum(abs(p) == 6 for p in pl[ax][n]["pdg"]) if n in pl.get(ax, {}) else None
+        lr = np.array([r["e_h"] ** 2 / r["e_q"] ** 2 for r in rows.values()])
+        lf = np.array([(r["e_h"] - r["a"]) ** 2 / r["e_q"] ** 2 for r in rows.values()])
+        o = {"n": len(rows), "level_ratio": float(np.median(lr)), "level_ratio_a0": float(np.median(lf)),
+             "a_med_abs": float(np.median([abs(r["a"]) for r in rows.values()])),
+             "b_med": float(np.median([r["b"] for r in rows.values()])),
+             "e_h_med": float(np.median([r["e_h"] for r in rows.values()])),
+             "e_q_med": float(np.median([r["e_q"] for r in rows.values()])), "probes": rows}
+        if ax == "H7c":
+            for n, r in rows.items():
+                base = n.split("__")[0]
+                r["dc"] = pl["train"][base]["c_p"] - pl[ax][n]["c_p"] if base in pl["train"] else None
+            m = [r for r in rows.values() if r["dc"] is not None and r["N"] > 4]     # 2->2: c_p = 0 at any cut
+            x, y, z = (np.array([r[k] for r in m]) for k in ("dc", "e_h", "e_q"))
+            o.update({"n_dc": len(m), "dc_med": float(np.median(x)), "slope": float(np.polyfit(x, y, 1)[0]),
+                      "corr": float(np.corrcoef(x, y)[0, 1]), "level_dc_med": float(np.median((y - x) ** 2)),
+                      "level_dc_over_q": float(np.median((y - x) ** 2 / z ** 2))})
+        if ax == "H3":
+            o["by_ntop"] = {int(k): {"n": int(sum(r["ntop"] == k for r in rows.values())),
+                                     "e_h_med": float(np.median([r["e_h"] for r in rows.values() if r["ntop"] == k])),
+                                     "e_q_med": float(np.median([r["e_q"] for r in rows.values() if r["ntop"] == k]))}
+                            for k in sorted({r["ntop"] for r in rows.values()})}
+            o["by_N4"] = {"e_h_med": float(np.median([r["e_h"] for r in rows.values() if r["N"] == 4] or [np.nan]))}
+            # does the miss follow the top probe's c_p against the training classes' at its particle count?
+            tr = {}
+            for r in pl["train"].values():
+                tr.setdefault(r["N"], []).append(r["c_p"])
+            m = [(pl[ax][n]["c_p"] - np.median(tr[r["N"]]), r["e_h"]) for n, r in rows.items() if r["N"] > 4]
+            x, y = np.array(m).T
+            o.update({"cp_dev_med": float(np.median(x)), "cp_dev_corr": float(np.corrcoef(x, y)[0, 1]),
+                      "cp_dev_slope": float(np.polyfit(x, y, 1)[0])})
+        out[ax] = o
+        flat.update({f"{ax}_{k}": round(v, 3) for k, v in o.items() if isinstance(v, float)})
+        flat[f"{ax}_n"] = o["n"]
+        print(ax, {k: (round(v, 3) if isinstance(v, float) else v) for k, v in o.items() if k != "probes"})
+    json.dump(out, open(os.path.join(HERE, "data", "prep_hybrid_split.json"), "w"), indent=1)
+    print(json.dumps(flat))
+
+
+if __name__ == "__main__":
+    main()
