+def test_frozen_orders_source():
+    from types import SimpleNamespace as NS
+    try:
+        from experiment import AmplitudeExperiment as E
+    except ImportError:
+        print("[orders_source] skipped: experiment not importable here")
+        return
+
+    def mk(**d):
+        return NS(cfg=NS(data=NS(get=lambda k, dflt=None, d=d: d.get(k, dflt))), _orders_source=lambda: E._orders_source(mk_self[0]))
+    mk_self = [None]
+
+    def chk(stats, **d):
+        o = mk(**d)
+        mk_self[0] = o
+        E._check_frozen_orders_source(o, stats)
+
+    chk({}, target_physics_orders=True, orders_from_diagrams=False)            # no key counts as table
+    chk({"target_physics_orders_source": "diagrams_highest_alphas"}, target_physics_orders=True)  # unset = true
+    chk({}, orders_from_diagrams=False, target_physics_orders=False)
+    chk({}, target_physics_orders=False)                                       # off: anything passes
+    for stats, d in (({}, {}), ({"target_physics_orders_source": "diagrams_highest_alphas"}, {"orders_from_diagrams": False})):
+        try:
+            chk(stats, target_physics_orders=True, **d)
+        except AssertionError as e:
+            assert "target_physics_orders_source" in str(e)
+        else:
+            raise AssertionError("mismatch not refused")
+    print("[orders_source] ok")
+
+
 if __name__ == "__main__":
+    test_frozen_orders_source()
