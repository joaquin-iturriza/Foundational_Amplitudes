index 80d61dc01..a80ec2218 100644
--- a/tools/rebuild_run.py
+++ b/tools/rebuild_run.py
@@ -71,6 +71,34 @@ def scored_split(exp, split, name):
     return loader, pool, exp._split_indices[split]
 
 
+def recipe_role_counts(recipe_yaml):
+    """{process: {'train': n, 'val': n, 'test': n}} of a recipe's events per role."""
+    procs = yaml.safe_load(open(recipe_yaml))["processes"]
+    return {p["name"]: {r: int(p.get("n_" + r, 0) or 0) for r in ("train", "val", "test")} for p in procs}
+
+
+def stand_in_role(counts, process, role, scored_split):
+    """(role read, n events) for `role` of `process`: its own when it has events, else the scored split, else another
+    role it has, else its own (0). A probe pool of one role only (the EE4 probes: test) still gets every role read."""
+    c = counts[process]
+    for r in (role, scored_split, "train", "val", "test"):
+        if c.get(r, 0) > 0:
+            return r, c[r]
+    return role, 0
+
+
+def stand_in_split_set(real_ensure_split_set, counts, scored_split):
+    """A datagen.ensure_split_set (same signature) that reads each spec from its stand-in role (stand_in_role)."""
+    def ensure(specs, role, seed, dest_dir=None, require_cache=False):
+        out = {}
+        for s in specs:
+            r, n = stand_in_role(counts, s["process"], role, scored_split)
+            out.update(real_ensure_split_set([{**s, "n_events": n}], role=r, seed=seed, dest_dir=dest_dir,
+                                             require_cache=require_cache))
+        return out
+    return ensure
+
+
 def _build(cfg, swap, path, name):
     """The experiment built through init_model, with the `swap` role's pool read from `path` (None: none)."""
     real = datagen.ensure_split_set
