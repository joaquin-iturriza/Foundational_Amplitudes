--- /dev/null
+++ b/tests/test_pool_rows.py
@@ -0,0 +1,21 @@
+"""analysis/catalog_v4/dipole_residual.pool_rows: a read's pool rows, saved or rebuilt from the role shuffles."""
+import os, sys
+import numpy as np
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, ROOT)
+from analysis.catalog_v4.dipole_residual import pool_rows  # noqa: E402
+
+
+def test_rebuilt_from_idx_and_saved_wins():
+    counts = [7, 5, 4]
+    rng = np.random.default_rng(seed=42)
+    perms = [rng.permutation(n) for n in counts]
+    for role, start in (("train", 0), ("val", 7), ("test", 12)):
+        i = ["train", "val", "test"].index(role)
+        z = {"idx": start + np.arange(counts[i])[:3], "split": np.array(role), "role_counts": np.array(counts)}
+        np.testing.assert_array_equal(pool_rows(z), perms[i][:3])
+    np.testing.assert_array_equal(pool_rows({**z, "pool_row": np.array([9, 8])}), [9, 8])
+
+
+if __name__ == "__main__":
+    test_rebuilt_from_idx_and_saved_wins(); print("ok")
