+def pool_rows(z):
+    """The pool rows of a read's events: z['pool_row'] when saved, else rebuilt from z['idx'] (positions in the
+    role-contiguous train|val|test array), z['split'] and z['role_counts'] (the three role sizes), each role shuffled by
+    one default_rng(42) drawing permutation(n) for train, val, test in turn (experiment._init_data_recipes)."""
+    if "pool_row" in getattr(z, "files", z):
+        return np.asarray(z["pool_row"])
+    counts = [int(c) for c in z["role_counts"]]
+    rng = np.random.default_rng(seed=42)
+    perms = [rng.permutation(n) for n in counts]
+    role = ("train", "val", "test").index(str(z["split"]))
+    return perms[role][np.asarray(z["idx"]) - sum(counts[:role])]
+
+
