+def hybrid_cp(P):
+    """data.target_physics_hybrid's constant of one process: c_p = mean over its events of Lq - (N - 4) log s_hat, P (n, N, 4)
+    momenta, rows 0 and 1 incoming (0.0 for a 2 -> 2). Momenta only, no amplitude; s0 cancels."""
+    pp = np.asarray(P, dtype=np.float64)
+    q = pp[:, 0] + pp[:, 1]
+    ls = np.log(np.abs(q[:, 0] ** 2 - (q[:, 1:] ** 2).sum(axis=1)))
+    return float(np.mean(qperp_logs(pp) - (pp.shape[1] - 4) * ls))
+
+
+def hybrid_cps(names, events_of, frozen=None):
+    """-> ({name: c_p}, [names reused]): a name in `frozen` ({name: c_p}, a parent's) keeps that value and events_of(name)
+    is not called for it; any other is fitted with hybrid_cp(events_of(name))."""
+    frozen = frozen or {}
+    cps = {n: float(frozen[n]) if n in frozen else hybrid_cp(events_of(n)) for n in names}
+    return cps, [n for n in names if n in frozen]
